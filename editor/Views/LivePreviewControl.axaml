<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RowlEngine.Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="RowlEngine.Editor.Views.LivePreviewControl"
             x:DataType="vm:MainWindowViewModel">

    <Border Background="#0B0F19" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid>
            <!-- 16:9 Aspect Guardian Letterbox Container -->
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                <Border Width="1920" Height="1080" Background="#121624" CornerRadius="8" ClipToBounds="True" BoxShadow="0 10 30 0 #000000">
                    <Canvas x:Name="ViewportCanvas" Width="1920" Height="1080" Background="#161B2E">
                        <!-- Scene Background Bitmap Layer -->
                        <Border x:Name="BackgroundBox"
                                Canvas.Left="{Binding SelectedNode.BackgroundX}" 
                                Canvas.Top="{Binding SelectedNode.BackgroundY}" 
                                Width="{Binding SelectedNode.BackgroundWidth}" 
                                Height="{Binding SelectedNode.BackgroundHeight}" 
                                Background="#1A2035" BorderBrush="#3B82F6" BorderThickness="1.5">
                            <Grid>
                                <!-- Actual Bitmap Image Render -->
                                <Image Source="{Binding SelectedNode.BackgroundBitmap}" Stretch="Fill" 
                                       Width="{Binding SelectedNode.BackgroundWidth}" Height="{Binding SelectedNode.BackgroundHeight}"/>
                                
                                <!-- Decorative Atmosphere Fallback Text if Bitmap loading -->
                                <TextBlock Text="{Binding SelectedNode.BackgroundTexture, StringFormat='Scene BG: {0}'}" 
                                           IsVisible="{Binding SelectedNode.BackgroundBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                                           Foreground="#64748B" FontSize="20" FontWeight="Bold" Margin="40,90" HorizontalAlignment="Left"/>

                                <!-- Background Resize Handles -->
                                <Border Name="BgHandleBR" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                        Background="#3B82F6" BorderBrush="White" BorderThickness="2" CornerRadius="9" Cursor="BottomRightCorner" Margin="0,0,-7,-7" ToolTip.Tip="Resize Background"/>
                            </Grid>
                        </Border>

                        <!-- Top Resolution Banner -->
                        <Border Canvas.Left="0" Canvas.Top="0" Width="1920" Height="80" Background="#0F172A" Opacity="0.92">
                            <DockPanel Margin="30,0">
                                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ LIVE VIEWPORT" Foreground="#00F0FF" FontSize="22" FontWeight="Bold"/>
                                    <Border Background="#1E293B" CornerRadius="4" Padding="10,4">
                                        <TextBlock Text="1920x1080 Virtual Canvas (Interactive Drag &amp; Resize Mode)" Foreground="#94A3B8" FontSize="16"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedNode.Title, StringFormat='Active Node: {0}'}" 
                                           Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Interactive Character Sprite Layer (Drag or Resize with Mouse!) -->
                        <Border x:Name="CharacterBox"
                                Canvas.Left="{Binding SelectedNode.CharacterX}" 
                                Canvas.Top="{Binding SelectedNode.CharacterY}" 
                                Width="{Binding SelectedNode.CharacterWidth}" 
                                Height="{Binding SelectedNode.CharacterHeight}" Cursor="Hand"
                                Background="#2A374A" BorderBrush="#00F0FF" BorderThickness="3" CornerRadius="12" BoxShadow="0 10 30 0 #000000">
                            <Grid RowDefinitions="*, Auto">
                                <!-- Bitmap Image Render for Character -->
                                <Image Grid.Row="0" Source="{Binding SelectedNode.CharacterBitmap}" Stretch="Uniform" Margin="8"/>

                                <!-- Fallback Placeholder if Image fails -->
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                                            IsVisible="{Binding SelectedNode.CharacterBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                                    <TextBlock Text="👤" FontSize="48" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedNode.CharacterSprite}" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Drag handle label -->
                                <Border Grid.Row="1" Background="#0F172A" Padding="6,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock Text="✋ Character" Foreground="#00F0FF" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedNode.CharacterWidth, StringFormat='({0:0}'}" Foreground="#94A3B8" FontSize="10"/>
                                        <TextBlock Text="x" Foreground="#94A3B8" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedNode.CharacterHeight, StringFormat='{}{0:0})'}" Foreground="#94A3B8" FontSize="10"/>
                                    </StackPanel>
                                </Border>

                                <!-- Character Resize Corner Handles -->
                                <Border Name="CharHandleTL" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#00F0FF" BorderBrush="White" BorderThickness="2" CornerRadius="8" Cursor="TopLeftCorner" Margin="-6,-6,0,0"/>
                                <Border Name="CharHandleTR" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#00F0FF" BorderBrush="White" BorderThickness="2" CornerRadius="8" Cursor="TopRightCorner" Margin="0,-6,-6,0"/>
                                <Border Name="CharHandleBL" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#00F0FF" BorderBrush="White" BorderThickness="2" CornerRadius="8" Cursor="BottomLeftCorner" Margin="-6,0,0,-6"/>
                                <Border Name="CharHandleBR" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#00F0FF" BorderBrush="White" BorderThickness="2" CornerRadius="8" Cursor="BottomRightCorner" Margin="0,0,-6,-6"/>
                            </Grid>
                        </Border>

                        <!-- Interactive Dialogue Box Container (Drag or Resize with Mouse!) -->
                        <Border x:Name="DialogueBox"
                                Canvas.Left="{Binding SelectedNode.DialogueBoxX}" 
                                Canvas.Top="{Binding SelectedNode.DialogueBoxY}" 
                                Width="{Binding SelectedNode.DialogueBoxWidth}" 
                                Height="{Binding SelectedNode.DialogueBoxHeight}" Cursor="Hand"
                                Background="#12121A" BorderBrush="#00F0FF" BorderThickness="3" CornerRadius="12" BoxShadow="0 10 30 0 #000000">
                            <Grid>
                                <!-- Speaker Name Badge -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,-16,0,0" Background="#2563EB" CornerRadius="6" Padding="14,4" BoxShadow="0 4 10 0 #000000">
                                    <TextBlock Text="{Binding SelectedNode.Speaker, FallbackValue='Evelyn'}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                                </Border>

                                <!-- Dialogue Content Text Container (Adaptively wraps inside square or rectangular box) -->
                                <ScrollViewer Margin="20,24,20,20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{Binding SelectedNode.DialogueText, FallbackValue='Select a node to preview live dialogue scene.'}" 
                                               Foreground="#F8FAFC" FontSize="20" LineHeight="28"/>
                                </ScrollViewer>

                                <!-- Drag handle badge -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,14,0" Background="#0F172A" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="✋ Box" Foreground="#00F0FF" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedNode.DialogueBoxWidth, StringFormat='({0:0}'}" Foreground="#94A3B8" FontSize="10"/>
                                        <TextBlock Text="x" Foreground="#94A3B8" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedNode.DialogueBoxHeight, StringFormat='{}{0:0})'}" Foreground="#94A3B8" FontSize="10"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dialogue Box Resize Corner Handles -->
                                <Border Name="DlgHandleTL" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#00F0FF" BorderBrush="White" BorderThickness="2" CornerRadius="8" Cursor="TopLeftCorner" Margin="-6,-6,0,0"/>
                                <Border Name="DlgHandleTR" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#00F0FF" BorderBrush="White" BorderThickness="2" CornerRadius="8" Cursor="TopRightCorner" Margin="0,-6,-6,0"/>
                                <Border Name="DlgHandleBL" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#00F0FF" BorderBrush="White" BorderThickness="2" CornerRadius="8" Cursor="BottomLeftCorner" Margin="-6,0,0,-6"/>
                                <Border Name="DlgHandleBR" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#00F0FF" BorderBrush="White" BorderThickness="2" CornerRadius="8" Cursor="BottomRightCorner" Margin="0,0,-6,-6"/>
                            </Grid>
                        </Border>
                    </Canvas>
                </Border>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
