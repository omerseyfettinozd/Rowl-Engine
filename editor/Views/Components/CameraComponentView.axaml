<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             x:Class="RowlEngine.Editor.Views.Components.CameraComponentView"
             x:DataType="comp:CameraComponentViewModel">
  <Border Classes="card" ClipToBounds="True" Margin="0,4">
    <StackPanel>
      <Border Background="{DynamicResource CardHeaderBackground}" Padding="8,6">
        <Grid ColumnDefinitions="*, Auto">
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" ToolTip.Tip="{l:T Common.Enable.Tip}" MinWidth="0" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"/>
            <ToggleButton Grid.Column="1" Classes="header" IsChecked="{Binding IsExpanded}" ToolTip.Tip="{l:T Common.ExpandCollapse.Tip}"
                          Background="Transparent" BorderThickness="0" Padding="4,2"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{l:T Component.Camera.Title}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </ToggleButton>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
            <Button Classes="compact" Content="{l:T Common.MoveUp}" Command="{Binding MoveUpCommand}" ToolTip.Tip="{l:T Common.MoveUp.Tip}"/>
            <Button Classes="compact" Content="{l:T Common.MoveDown}" Command="{Binding MoveDownCommand}" ToolTip.Tip="{l:T Common.MoveDown.Tip}"/>
            <ToggleButton Classes="compact" IsChecked="{Binding IsExpanded}" Content="{l:T Common.Settings}"/>
            <Button Classes="compact" Content="{l:T Common.Delete}" Command="{Binding RemoveSelfCommand}" ToolTip.Tip="{l:T Common.RemoveComponent.Tip}"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="8,6">

      <!-- Position -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="{l:T Component.Camera.FocusX}" Classes="body" />
          <NumericUpDown Value="{Binding X}" Increment="10" Minimum="-10000" Maximum="10000" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{l:T Component.Camera.FocusY}" Classes="body" />
          <NumericUpDown Value="{Binding Y}" Increment="10" Minimum="-10000" Maximum="10000" />
        </StackPanel>
      </Grid>

      <!-- Zoom and Rotation -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="{l:T Component.Camera.Zoom}" Classes="body" />
          <NumericUpDown Value="{Binding Zoom}" Increment="0.1" Minimum="0.1" Maximum="10.0" FormatString="F2" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2"
                    ToolTip.Tip="{l:T Component.Camera.Rotation.Tip}">
          <TextBlock Text="{l:T Component.Camera.Rotation.Label}" Classes="body" />
          <NumericUpDown Value="{Binding Rotation}" Increment="5" Minimum="-360" Maximum="360" IsEnabled="False" />
          <TextBlock Text="{l:T Component.Camera.Rotation.Note}" Classes="body" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <!-- Smooth Tweening -->
      <Separator Background="{DynamicResource BorderColor}" Height="1"/>
      <StackPanel Spacing="6">
        <TextBlock Text="{l:T Component.Camera.Tween.Label}" Classes="caption" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{l:T Component.Camera.PanTime}" Classes="body" />
            <NumericUpDown Value="{Binding PanDuration}" Increment="0.25" Minimum="0" Maximum="60" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{l:T Component.Camera.ZoomTime}" Classes="body" />
            <NumericUpDown Value="{Binding ZoomDuration}" Increment="0.25" Minimum="0" Maximum="60" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="{l:T Component.Camera.Easing}" Classes="body" />
            <TextBox Text="{Binding Easing}" Watermark="{l:T Component.Camera.Easing.Watermark}" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- Screen Shake -->
      <Separator Background="{DynamicResource BorderColor}" Height="1"/>
      <StackPanel Spacing="6">
        <TextBlock Text="{l:T Component.Camera.Shake.Label}" Classes="caption" FontWeight="SemiBold" />

        <!-- Preset Selector -->
        <StackPanel Spacing="2">
          <TextBlock Text="{l:T Component.Camera.Shake.Preset}" Classes="body" />
          <ComboBox ItemsSource="{x:Static comp:CameraComponentViewModel.AvailableShakePresets}"
                    SelectedItem="{Binding ShakePreset}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{l:T Component.Camera.Shake.Intensity}" Classes="body" />
            <NumericUpDown Value="{Binding ShakeIntensity}" Increment="5" Minimum="0" Maximum="1000" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{l:T Component.Camera.Shake.Duration}" Classes="body" />
            <NumericUpDown Value="{Binding ShakeDuration}" Increment="0.1" Minimum="0" Maximum="60" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="{l:T Component.Camera.Shake.Frequency}" Classes="body" />
            <NumericUpDown Value="{Binding ShakeFrequency}" Increment="5" Minimum="1" Maximum="100" />
          </StackPanel>
        </Grid>

        <!-- Damping and Directional Constraints -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{l:T Component.Camera.Shake.Damping}" Classes="body" />
            <NumericUpDown Value="{Binding ShakeDamping}" Increment="0.1" Minimum="0.1" Maximum="5.0" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{l:T Component.Camera.Shake.DirX}" Classes="body" />
            <NumericUpDown Value="{Binding ShakeDirectionX}" Increment="0.1" Minimum="0" Maximum="1.0" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="{l:T Component.Camera.Shake.DirY}" Classes="body" />
            <NumericUpDown Value="{Binding ShakeDirectionY}" Increment="0.1" Minimum="0" Maximum="1.0" FormatString="F2" />
          </StackPanel>
        </Grid>
      </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
