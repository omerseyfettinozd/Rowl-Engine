<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:views="using:RowlEngine.Editor.Views"
             xmlns:controls="using:RowlEngine.Editor.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RowlEngine.Editor.Views.Panels.NodeGraphView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <!-- sessiz sıfırlama düğmesi vurgusu -->
        <Style Selector="Button#ResetViewButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
    </UserControl.Styles>
    <Grid x:Name="NodeGraphContainer"
          Background="{DynamicResource GraphCanvasBg}"
          ClipToBounds="True">
        <!-- Transformable Infinite Canvas Viewport (Unclipped 2D Infinite Coordinate Space) -->
        <Canvas x:Name="OuterCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ClipToBounds="False"
                RenderTransformOrigin="0,0">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                    <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Infinite Grid Visual Background Surface -->
            <Rectangle Width="400000" Height="400000" Canvas.Left="-200000" Canvas.Top="-200000" Fill="{DynamicResource GraphCanvasBg}"/>

            <!-- Group Frames Layer (Faz 4 Dilim 3, culled: visible rect only, behind wires) -->
            <ItemsControl ItemsSource="{Binding NodeGraphViewModel.VisibleGroups}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:CanvasGroupViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        <Setter Property="ClipToBounds" Value="False"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:CanvasGroupViewModel">
                        <Border Width="{Binding Width}" Height="{Binding Height}"
                                CornerRadius="8" BorderThickness="1.5"
                                BorderBrush="{Binding Color}" Background="Transparent">
                            <Grid RowDefinitions="28,*,16">
                                <!-- Header: drag moves the frame + its members; double-click reframes -->
                                <Border Tag="GroupHeader" Background="{Binding Color}" CornerRadius="6,6,0,0"
                                        Cursor="Hand" ToolTip.Tip="{l:T Graph.Group.Drag.Tip}">
                                    <DockPanel Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Tag="GroupDelete" DockPanel.Dock="Right" Text="×" FontSize="14"
                                                   FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                                                   Cursor="Hand" ToolTip.Tip="{l:T Graph.Group.Delete.Tip}"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                                <!-- Translucent body tint (hit-test off: clicks fall to canvas) -->
                                <Rectangle Grid.Row="1" Fill="{Binding Color}" Opacity="0.10" IsHitTestVisible="False"/>
                                <!-- Resize thumb -->
                                <Rectangle Grid.Row="2" Tag="GroupResize" Width="16" Height="14"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Fill="{Binding Color}" Opacity="0.7" RadiusX="3" RadiusY="3"
                                           Cursor="SizeNorthwestSoutheast" ToolTip.Tip="{l:T Graph.Group.Resize.Tip}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Connection Wires Layer (culled: visible rect only) -->
            <ItemsControl ItemsSource="{Binding NodeGraphViewModel.VisibleConnections}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConnectionViewModel">
                        <controls:BezierWireRenderer StartPoint="{Binding StartPoint}" EndPoint="{Binding EndPoint}" WireBrush="{DynamicResource WireColor}" WireThickness="3.0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Active Drag Wire Layer -->
            <controls:BezierWireRenderer StartPoint="{Binding WireStartPoint}" EndPoint="{Binding WireEndPoint}" IsVisible="{Binding IsDraggingWire}" WireBrush="{DynamicResource AccentColor}" WireThickness="3.5"/>

            <!-- Node Cards Layer (culled: visible rect only) -->
            <ItemsControl ItemsSource="{Binding NodeGraphViewModel.VisibleNodes}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:NodeViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        <Setter Property="ClipToBounds" Value="False"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:NodeViewModel">
                        <views:NodeControl HostCanvas="{Binding #OuterCanvas}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Marquee Selection Box Layer -->
            <Rectangle Canvas.Left="{Binding SelectionBoxX}"
                       Canvas.Top="{Binding SelectionBoxY}"
                       Width="{Binding SelectionBoxWidth}"
                       Height="{Binding SelectionBoxHeight}"
                       IsVisible="{Binding IsSelectingBox}"
                       Fill="{DynamicResource Accent}"
                       Stroke="{DynamicResource Accent}"
                       StrokeThickness="1.5"
                       StrokeDashArray="4,2"/>
        </Canvas>

        <!-- Görünüm kontrolleri (prototip sol alt): zoom kapsülü (uzaklaş · % · yakınlaş · sığdır · seçime odaklan) + harita kapsülü -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Background="Transparent">
            <!-- birincil zoom kapsülü -->
            <Border x:Name="SceneViewHeader" Background="{DynamicResource CanvasControlBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="1">
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <Button Classes="tool" Width="35" Height="36" Background="Transparent" BorderThickness="0" Command="{Binding ZoomOutViewCommand}" ToolTip.Tip="{l:T Graph.ZoomOut}">
                        <Path Data="M0,7 h14" Stroke="{DynamicResource CanvasControlText}" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="14" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="{Binding ZoomScale, StringFormat='{}{0:P0}'}" FontSize="10" Foreground="{DynamicResource CanvasControlText}" MinWidth="33" TextAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{l:T Graph.ZoomLevel}"/>
                    <Button Classes="tool" Width="35" Height="36" Background="Transparent" BorderThickness="0" Command="{Binding ZoomInViewCommand}" ToolTip.Tip="{l:T Graph.ZoomIn}">
                        <Path Data="M5,12 h14 M12,5 v14" Stroke="{DynamicResource CanvasControlText}" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tool" Width="35" Height="36" Background="Transparent" BorderThickness="0" Command="{Binding NodeGraphViewModel.ZoomToFitCommand}" ToolTip.Tip="{l:T Graph.Fit.Tip}">
                        <Path Data="M4,9 V4 h5 M20,9 V4 h-5 M4,15 v5 h5 M20,15 v5 h-5" Stroke="{DynamicResource CanvasControlText}" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="tool" Width="35" Height="36" Background="Transparent" BorderThickness="0" Command="{Binding NodeGraphViewModel.FitToSelectionCommand}" ToolTip.Tip="{l:T Graph.FitSelection.Tip}">
                        <Path Data="M4,4 h6 M4,4 v6 M20,20 h-6 M20,20 v-6 M9,9 h6 v6 h-6 Z" Stroke="{DynamicResource CanvasControlText}" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
            <!-- ikincil kapsül: mini harita aç/kapa (test: SceneViewHeader'da 4 komut düğmesi) -->
            <Border Background="{DynamicResource CanvasControlBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="1">
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <ToggleButton Classes="capsuleToggle" Width="35" Height="36" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsMinimapVisible, Mode=TwoWay}" ToolTip.Tip="{l:T Graph.Minimap.Tip}">
                        <Path Data="M3,6 l6,-2 l6,2 l6,-2 v14 l-6,2 l-6,-2 l-6,2 Z M9,4 v14 M15,6 v14" Stroke="{DynamicResource CanvasControlText}" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Mini harita (kuş bakışı, sürükleyerek kaydır) -->
        <Border x:Name="MinimapCard" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                IsVisible="{Binding IsMinimapVisible}" Padding="4" ClipToBounds="True"
                Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Opacity="0.92">
            <controls:MinimapControl x:Name="CanvasMinimap" Width="200" Height="130"
                                     Background="Transparent"
                                     NodesSource="{Binding NodeGraphViewModel.Nodes}"
                                     GroupsSource="{Binding Groups.Groups}"
                                     WorldBounds="{Binding NodeGraphViewModel.WorldBounds}"
                                     ViewportRect="{Binding NodeGraphViewModel.ViewportRect}"/>
        </Border>

        <!-- Görünümü sıfırla (sağ alt, sessiz) -->
        <Border x:Name="CanvasViewportOverlay" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Background="Transparent" BorderThickness="0">
            <Button x:Name="ResetViewButton" Classes="tool" Content="{l:T Graph.ResetView}" Command="{Binding ResetCanvasViewCommand}" FontSize="10" Foreground="{DynamicResource MutedText}" Background="Transparent" BorderThickness="0"/>
        </Border>
    </Grid>
</UserControl>
