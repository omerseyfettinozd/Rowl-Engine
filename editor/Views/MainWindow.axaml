<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RowlEngine.Editor.ViewModels"
        xmlns:views="using:RowlEngine.Editor.Views"
        xmlns:panels="using:RowlEngine.Editor.Views.Panels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="RowlEngine.Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Rowl Engine Editor"
        Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#121218">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *">

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#1E1E2A" BorderBrush="#2D2D3F" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding PlayButtonText}" Command="{Binding TogglePlayStandaloneCommand}" Background="{Binding PlayButtonColor}" Foreground="White" FontWeight="Bold" CornerRadius="4" Padding="10,6"/>
                    <Button Content="+ Add Node" Command="{Binding AddNodeCommand}" Background="#3B82F6" Foreground="White" CornerRadius="4" Padding="10,6"/>
                    <Button Content="✂ Disconnect" Command="{Binding DisconnectSelectedNodeCablesCommand}" Background="#D97706" Foreground="White" CornerRadius="4" Padding="10,6"/>
                    <Button Content="🗑 Delete Node" Command="{Binding DeleteSelectedNodeCommand}" Background="#DC2626" Foreground="White" CornerRadius="4" Padding="10,6"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="🎮 ROWL ENGINE EDITOR" FontWeight="Bold" Foreground="#38BDF8" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="{Binding SplitScreenButtonText}" 
                            Command="{Binding ShowPanelCommand}" CommandParameter="SplitScreen"
                            Background="{Binding SplitScreenButtonColor}" 
                            Foreground="{Binding SplitScreenButtonForeground}"
                            FontWeight="Bold" FontSize="11" CornerRadius="4" Padding="8,5" Margin="4,0,0,0"/>
                    <Menu Background="Transparent" Margin="12,0,0,0">
                        <MenuItem Header="Pencereler" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold">
                            <MenuItem Header="📁 Project Assets" Command="{Binding ShowPanelCommand}" CommandParameter="Assets"/>
                            <MenuItem Header="🔍 Node Inspector" Command="{Binding ShowPanelCommand}" CommandParameter="Inspector"/>
                            <MenuItem Header="📝 Output Log" Command="{Binding ShowPanelCommand}" CommandParameter="Log"/>
                            <Separator/>
                            <MenuItem Header="🕸️ Node Graph" Command="{Binding ShowPanelCommand}" CommandParameter="NodeGraph"/>
                            <MenuItem Header="🎬 Edit Frame" Command="{Binding ShowPanelCommand}" CommandParameter="Preview"/>
                            <MenuItem Header="🎮 Game" Command="{Binding ShowPanelCommand}" CommandParameter="EnginePreview"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="280, 6, *, 6, 320">

            <!-- LEFT: Project Assets -->
            <Grid Grid.Column="0" IsVisible="{Binding IsAssetsPanelVisible}">
                <panels:ProjectAssetsView/>
            </Grid>
            <GridSplitter Grid.Column="1" Background="#2D2D3F" ResizeDirection="Columns" Width="6"/>

            <!-- CENTER workspace -->
            <Grid Grid.Column="2" RowDefinitions="*, 6, 220">

                <Grid Grid.Row="0" ClipToBounds="True">

                    <!-- SINGLE MODE -->
                    <Grid IsVisible="{Binding IsSplitScreenOff}">
                        <panels:NodeGraphView IsVisible="{Binding IsNodeGraphActive}"/>
                        <views:LivePreviewControl IsVisible="{Binding IsPreviewActive}"/>
                        <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                    </Grid>

                    <!-- SPLIT SCREEN MODE (HORIZONTAL): Node Graph top, Edit Frame / Game bottom -->
                    <Grid IsVisible="{Binding IsSplitScreenHorizontal}" RowDefinitions="*, 6, *" ClipToBounds="True">
                        <panels:NodeGraphView Grid.Row="0"/>
                        <GridSplitter Grid.Row="1" Background="#2D2D3F" ResizeDirection="Rows" Height="6"/>
                        <Grid Grid.Row="2">
                            <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                            <views:LivePreviewControl IsVisible="{Binding !IsEnginePreviewActive}"/>
                        </Grid>
                    </Grid>
                    
                    <!-- SPLIT SCREEN MODE (VERTICAL): Node Graph left, Edit Frame / Game right -->
                    <Grid IsVisible="{Binding IsSplitScreenVertical}" ColumnDefinitions="*, 6, *" ClipToBounds="True">
                        <panels:NodeGraphView Grid.Column="0"/>
                        <GridSplitter Grid.Column="1" Background="#2D2D3F" ResizeDirection="Columns" Width="6"/>
                        <Grid Grid.Column="2">
                            <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                            <views:LivePreviewControl IsVisible="{Binding !IsEnginePreviewActive}"/>
                        </Grid>
                    </Grid>

                </Grid>

                <GridSplitter Grid.Row="1" Background="#2D2D3F" ResizeDirection="Rows" Height="6"/>

                <!-- Bottom: Output Log -->
                <Grid Grid.Row="2" IsVisible="{Binding IsLogPanelVisible}">
                    <panels:OutputLogView/>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" Background="#2D2D3F" ResizeDirection="Columns" Width="6"/>

            <!-- RIGHT: Node Inspector -->
            <Grid Grid.Column="4" IsVisible="{Binding IsInspectorPanelVisible}">
                <panels:NodeInspectorView/>
            </Grid>
        </Grid>
    </Grid>
</Window>