<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             mc:Ignorable="d"
             x:Class="RowlEngine.Editor.Views.Components.AudioComponentView"
             x:DataType="comp:AudioComponentViewModel">

    <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Margin="0,4" Padding="0" BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
        <StackPanel>
            <!-- Component Header -->
            <Border Background="{DynamicResource CardHeaderBackground}" CornerRadius="6,6,0,0" Padding="8,6">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🔊" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding IsEnabled}" ToolTip.Tip="Enable/Disable" MinWidth="0" Padding="0" Margin="0,0,2,0"/>
                        <Button Content="▲" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move Up" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
                        <Button Content="▼" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move Down" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
                        <ToggleButton IsChecked="{Binding IsExpanded}" Content="⚙️" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
                        <Button Content="🗑️" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="#EF4444" BorderThickness="0" ToolTip.Tip="Remove Component" Command="{Binding RemoveSelfCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Component Body -->
            <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="10,8">
                <!-- BGM Track -->
                <StackPanel Spacing="4">
                    <TextBlock Text="BGM Track (Arka Plan Müziği)" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding BgmTrack}" Watermark="Örn: bgm_theme.ogg"
                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                        <Button Grid.Column="1" Command="{Binding ToggleBgmPreviewCommand}" Margin="4,0,0,0" Padding="8,4"
                                ToolTip.Tip="BGM Önizleme Çal / Durdur">
                            <Panel>
                                <TextBlock Text="▶" IsVisible="{Binding !IsPreviewingBgm}" FontSize="11" Foreground="#10B981"/>
                                <TextBlock Text="⏹" IsVisible="{Binding IsPreviewingBgm}" FontSize="11" Foreground="#EF4444"/>
                            </Panel>
                        </Button>
                    </Grid>
                    <!-- BGM Stereo VU Meter -->
                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" Margin="0,2,0,2">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="L" FontSize="9" Width="12" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BgmPeakL}" Height="4" Foreground="#10B981" Background="#262626" Margin="0,1"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="R" FontSize="9" Width="12" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BgmPeakR}" Height="4" Foreground="#10B981" Background="#262626" Margin="0,1"/>
                    </Grid>
                </StackPanel>

                <!-- SFX Track -->
                <StackPanel Spacing="4">
                    <TextBlock Text="SFX Track (Ses Efekti)" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding SfxTrack}" Watermark="Örn: sfx_click.wav"
                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                        <Button Grid.Column="1" Command="{Binding ToggleSfxPreviewCommand}" Margin="4,0,0,0" Padding="8,4"
                                ToolTip.Tip="SFX Önizleme Çal / Durdur">
                            <Panel>
                                <TextBlock Text="▶" IsVisible="{Binding !IsPreviewingSfx}" FontSize="11" Foreground="#3B82F6"/>
                                <TextBlock Text="⏹" IsVisible="{Binding IsPreviewingSfx}" FontSize="11" Foreground="#EF4444"/>
                            </Panel>
                        </Button>
                    </Grid>
                    <!-- SFX Stereo VU Meter -->
                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" Margin="0,2,0,2">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="L" FontSize="9" Width="12" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SfxPeakL}" Height="4" Foreground="#3B82F6" Background="#262626" Margin="0,1"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="R" FontSize="9" Width="12" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SfxPeakR}" Height="4" Foreground="#3B82F6" Background="#262626" Margin="0,1"/>
                    </Grid>
                </StackPanel>

                <!-- Volume Slider -->
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Ses Seviyesi (Volume)" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat={}{0:P0}}" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" SmallChange="0.05" LargeChange="0.1"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="DSP Filter" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    <ComboBox SelectedItem="{Binding DspFilter}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}">
                        <x:String>Normal</x:String>
                        <x:String>Telephone</x:String>
                        <x:String>CaveReverb</x:String>
                        <x:String>UnderwaterLowPass</x:String>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="BGM Geçişi" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    <ComboBox SelectedItem="{Binding BgmTransition}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}">
                        <x:String>project_default</x:String>
                        <x:String>instant</x:String>
                        <x:String>fade</x:String>
                        <x:String>crossfade</x:String>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="BGM Geçiş Süresi (sn, 0 = proje varsayılanı)" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    <NumericUpDown Minimum="0" Maximum="60" Increment="0.1" Value="{Binding BgmTransitionDurationSeconds}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
