<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Rowl Engine — Dynamic Theme System
         Tüm renkler DynamicResource olarak tanımlanmıştır.
         Tema değişikliğinde bu ResourceDictionary runtime'da değiştirilir.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Arka Plan Katmanları ─────────────────────────────────────────── -->
    <!-- Faz 1 (docs/EDITOR_UI_PORT_PLAN.md): değerler web prototipinden
         (prototypes/editor-workspace) kuantalandı. Bu varsayılan palet,
         SettingsViewModel "Kemik Beyazı" paleti ve ThemeFallbackColors ile
         BİREBİR aynı olmak zorunda (EditorThemePaletteDriftTests). -->
    <Color x:Key="AppBackgroundColor">#0A0A0B</Color>
    <Color x:Key="SurfaceBackgroundColor">#131315</Color>
    <Color x:Key="PanelBackgroundColor">#19191C</Color>
    <Color x:Key="InputBackgroundColor">#0F0F12</Color>
    <Color x:Key="CanvasBackgroundColor">#131315</Color>

    <SolidColorBrush x:Key="AppBackground" Color="{DynamicResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackground" Color="{DynamicResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackground" Color="{DynamicResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="CanvasBackground" Color="{DynamicResource CanvasBackgroundColor}"/>
    <!-- Faz 8 A1: tuval zemini prototip yüzeyi (#131315); nokta ızgara prototip .node-area tonu. -->
    <Color x:Key="GraphDotColorValue">#303034</Color>
    <SolidColorBrush x:Key="GraphDotColor" Color="{DynamicResource GraphDotColorValue}"/>

    <!-- ── Kenarlıklar ─────────────────────────────────────────────────── -->
    <Color x:Key="BorderColorValue">#29292D</Color>
    <Color x:Key="BorderSubtleColorValue">#4A4A52</Color>
    <SolidColorBrush x:Key="BorderColor" Color="{DynamicResource BorderColorValue}"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="{DynamicResource BorderSubtleColorValue}"/>

    <!-- ── Metin Renkleri ──────────────────────────────────────────────── -->
    <Color x:Key="PrimaryTextColor">#F2EFE6</Color>
    <Color x:Key="SecondaryTextColor">#DAD7CF</Color>
    <Color x:Key="MutedTextColor">#85858B</Color>
    <Color x:Key="DimTextColor">#66666D</Color>

    <SolidColorBrush x:Key="PrimaryText" Color="{DynamicResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryText" Color="{DynamicResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="MutedText" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="DimText" Color="{DynamicResource DimTextColor}"/>

    <!-- ── Vurgu (Accent) Renkleri ─────────────────────────────────────── -->
    <Color x:Key="AccentColor">#F2EFE6</Color>
    <Color x:Key="AccentHoverColor">#FFFFFF</Color>
    <Color x:Key="AccentButtonBgColor">#19191D</Color>
    <Color x:Key="AccentButtonHoverColor">#26262B</Color>

    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{DynamicResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentButtonBg" Color="{DynamicResource AccentButtonBgColor}"/>
    <SolidColorBrush x:Key="AccentButtonHover" Color="{DynamicResource AccentButtonHoverColor}"/>

    <!-- ── İşlevsel Renkler ────────────────────────────────────────────── -->
    <Color x:Key="SuccessColor">#9DB58F</Color>
    <Color x:Key="WarningColor">#D9B47A</Color>
    <Color x:Key="ErrorColor">#E3A296</Color>
    <Color x:Key="InfoColor">#A9A3C9</Color>

    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}"/>

    <!-- K3: durum rozetleri soluk zemin + aynı aileden açık metin (prototip
         .build-result). Zemin üzerinde metin ≥ 5.8:1. -->
    <Color x:Key="SuccessSurfaceColor">#2C332C</Color>
    <Color x:Key="WarningSurfaceColor">#3A3124</Color>
    <Color x:Key="ErrorSurfaceColor">#3E2B26</Color>
    <Color x:Key="InfoSurfaceColor">#2B2A36</Color>
    <SolidColorBrush x:Key="SuccessSurface" Color="{DynamicResource SuccessSurfaceColor}"/>
    <SolidColorBrush x:Key="WarningSurface" Color="{DynamicResource WarningSurfaceColor}"/>
    <SolidColorBrush x:Key="ErrorSurface" Color="{DynamicResource ErrorSurfaceColor}"/>
    <SolidColorBrush x:Key="InfoSurface" Color="{DynamicResource InfoSurfaceColor}"/>

    <!-- ── Buton Renkleri ──────────────────────────────────────────────── -->
    <Color x:Key="ToolbarButtonBgColor">#111113</Color>
    <Color x:Key="ToolbarButtonHoverColor">#1E1E22</Color>
    <Color x:Key="DangerButtonBgColor">#3E2B26</Color>
    <Color x:Key="PlayButtonGreenColor">#111113</Color>
    <Color x:Key="PlayButtonRedColor">#26262B</Color>

    <SolidColorBrush x:Key="ToolbarButtonBg" Color="{DynamicResource ToolbarButtonBgColor}"/>
    <SolidColorBrush x:Key="ToolbarButtonHover" Color="{DynamicResource ToolbarButtonHoverColor}"/>
    <SolidColorBrush x:Key="DangerButtonBg" Color="{DynamicResource DangerButtonBgColor}"/>

    <!-- ── Status Bar ──────────────────────────────────────────────────── -->
    <Color x:Key="StatusBarBgColor">#0A0A0B</Color>
    <SolidColorBrush x:Key="StatusBarBg" Color="{DynamicResource StatusBarBgColor}"/>

    <!-- ── Node Graph ──────────────────────────────────────────────────── -->
    <Color x:Key="NodeCardBgColor">#19191D</Color>
    <Color x:Key="NodeHeaderBgColor">#202023</Color>
    <Color x:Key="WireColor">#74736C</Color>
    <Color x:Key="WireDragColor">#F2EFE6</Color>

    <SolidColorBrush x:Key="NodeCardBg" Color="{DynamicResource NodeCardBgColor}"/>
    <SolidColorBrush x:Key="NodeHeaderBg" Color="{DynamicResource NodeHeaderBgColor}"/>

    <!-- Faz 6 görsel uyum: prototip .story-node / .zoom-controls / .tool-shortcuts tonları. -->
    <Color x:Key="NodeKindTextColor">#999991</Color>
    <Color x:Key="NodeFooterTextColor">#A5A49E</Color>
    <Color x:Key="NodeFooterLineColor">#2E2E32</Color>
    <Color x:Key="CanvasControlBgColor">#171719</Color>
    <Color x:Key="CanvasControlTextColor">#ADABA4</Color>
    <Color x:Key="ToolCardIconColor">#ACA89D</Color>
    <SolidColorBrush x:Key="NodeKindText" Color="{DynamicResource NodeKindTextColor}"/>
    <SolidColorBrush x:Key="NodeFooterText" Color="{DynamicResource NodeFooterTextColor}"/>
    <SolidColorBrush x:Key="NodeFooterLine" Color="{DynamicResource NodeFooterLineColor}"/>
    <SolidColorBrush x:Key="NodePortStroke" Color="{DynamicResource WireColor}"/>
    <SolidColorBrush x:Key="CanvasControlBg" Color="{DynamicResource CanvasControlBgColor}"/>
    <SolidColorBrush x:Key="CanvasControlText" Color="{DynamicResource CanvasControlTextColor}"/>
    <SolidColorBrush x:Key="ToolCardIcon" Color="{DynamicResource ToolCardIconColor}"/>
    <!-- Faz 7 Lua editörü renklendirmesi (prototip .lua-comment / keyword / string / number). -->
    <Color x:Key="LuaCommentColor">#727E78</Color>
    <Color x:Key="LuaKeywordColor">#BFA8DA</Color>
    <Color x:Key="LuaStringColor">#C5CDA9</Color>
    <Color x:Key="LuaNumberColor">#C9B089</Color>
    <SolidColorBrush x:Key="LuaCommentBrush" Color="{DynamicResource LuaCommentColor}"/>
    <SolidColorBrush x:Key="LuaKeywordBrush" Color="{DynamicResource LuaKeywordColor}"/>
    <SolidColorBrush x:Key="LuaStringBrush" Color="{DynamicResource LuaStringColor}"/>
    <SolidColorBrush x:Key="LuaNumberBrush" Color="{DynamicResource LuaNumberColor}"/>

    <!-- ── Faz 2: ölçek token'ları (EDITOR_UI_PORT_PLAN) ──────────────────
         Yazı ölçeği prototipin dağılımından; K2: masaüstü denetim yüksekliği 32. -->
    <x:Double x:Key="FontSizeCaption">9</x:Double>
    <x:Double x:Key="FontSizeSmall">10</x:Double>
    <x:Double x:Key="FontSizeBody">11</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">12</x:Double>
    <x:Double x:Key="FontSizeTitle">15</x:Double>
    <x:Double x:Key="FontSizeHeading">21</x:Double>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">10</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">15</CornerRadius>
    <x:Double x:Key="ControlHeight">32</x:Double>
    <x:Double x:Key="SpacingTight">4</x:Double>
    <x:Double x:Key="SpacingSmall">6</x:Double>
    <x:Double x:Key="SpacingDefault">8</x:Double>
    <x:Double x:Key="SpacingMedium">12</x:Double>
    <x:Double x:Key="SpacingLarge">16</x:Double>
    <x:Double x:Key="SpacingXLarge">24</x:Double>

    <!-- ── Faz 2: Fluent vurgusu tek renk (K3) ─────────────────────────────
         Fluent'in mavisi prototipin kemik tonuna çekilir. Fluent "vurgu üstü"
         ön planları BEYAZDIR; açık vurgu zemininde kaybolmasınlar diye koyu
         yüzey rengine çekilir (onay tiki, açık ToggleButton yazısı, radyo noktası). -->
    <Color x:Key="SystemAccentColor">#D4CBB6</Color>
    <Color x:Key="SystemAccentColorDark1">#B9B3A3</Color>
    <Color x:Key="SystemAccentColorDark2">#9E988A</Color>
    <Color x:Key="SystemAccentColorDark3">#847F73</Color>
    <Color x:Key="SystemAccentColorLight1">#E2DBC9</Color>
    <Color x:Key="SystemAccentColorLight2">#EDE8DC</Color>
    <Color x:Key="SystemAccentColorLight3">#F2EFE6</Color>
    <SolidColorBrush x:Key="OnAccentForeground" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{DynamicResource SurfaceBackgroundColor}"/>

    <!-- K1: input kenarı normalde #4A4A52, üstünde açılır, odakta kemik tonu;
         odakta zemin değişmez (Fluent varsayılanı açık zemine geçer). -->
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource BorderSubtleColorValue}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource SystemAccentColorDark1}"/>
    <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#4A4A52"/>

    <!-- Seçim: prototipin ağaç seçimi (#2E2D2D zemin), mavi yerine. -->
    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="{DynamicResource ToolbarButtonHoverColor}"/>
    <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#2E2D2D"/>
    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#353434"/>
    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#353434"/>
    <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="{DynamicResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="{DynamicResource ToolbarButtonHoverColor}"/>
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#2E2D2D"/>
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#353434"/>
    <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="{DynamicResource PrimaryTextColor}"/>

    <!-- ── Compatibility & Helper Aliases ──────────────────────────────── -->
    <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource NodeCardBgColor}"/>
    <SolidColorBrush x:Key="CardHeaderBackground" Color="{DynamicResource NodeHeaderBgColor}"/>
    <SolidColorBrush x:Key="CardBorderColor" Color="{DynamicResource BorderColorValue}"/>
    <SolidColorBrush x:Key="AccentButtonFg" Color="{DynamicResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="GraphCanvasBg" Color="{DynamicResource CanvasBackgroundColor}"/>
    <!-- Faz 6 görsel uyum: prototip .node-area nokta ızgarası (20 px karo, 1.6 px nokta).
         Fırçalar aynı sözlükteki örneklere bağlı → tema rengi değişince ızgara da değişir. -->
    <DrawingBrush x:Key="GraphDotGridBrush" TileMode="Tile" Stretch="None" DestinationRect="0,0,20,20">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource GraphCanvasBg}" Geometry="M0,0 H20 V20 H0 Z"/>
                <GeometryDrawing Brush="{StaticResource GraphDotColor}" Geometry="M9.2,10 A0.8,0.8 0 1 0 10.8,10 A0.8,0.8 0 1 0 9.2,10 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
