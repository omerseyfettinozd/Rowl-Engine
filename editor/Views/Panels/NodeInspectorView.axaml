<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:views="using:RowlEngine.Editor.Views.Components"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="700"
             x:Class="RowlEngine.Editor.Views.Panels.NodeInspectorView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource PanelBackground}">
        <Grid RowDefinitions="*">

            <ScrollViewer Grid.Row="0" Padding="8,8" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <!-- ── Node Title (always visible, not a component) ── -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Node Title" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                        <TextBox Text="{Binding SelectedNode.Title, FallbackValue='No Node Selected'}" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>

                    <!-- ── Node ID indicator ── -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding SelectedNode.Id, StringFormat='Node #{0}', FallbackValue='—'}" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════ -->
                    <!-- ██  DYNAMIC COMPONENT LIST  ██ -->
                    <!-- ══════════════════════════════════════════════════ -->
                    <ItemsControl ItemsSource="{Binding SelectedNode.Components}">
                        <ItemsControl.ItemTemplate>
                            <views:ComponentTemplateSelector />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── Add Component Button ── -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,4">
                        <Button Content="➕ Add Component"
                                Command="{Binding ShowAddComponentMenuCommand}"
                                HorizontalAlignment="Stretch"
                                Padding="12,8"
                                FontSize="12"
                                Background="{DynamicResource CardHeaderBackground}"
                                Foreground="{DynamicResource PrimaryText}"
                                CornerRadius="6"
                                HorizontalContentAlignment="Center"/>
                    </Border>

                    <!-- ── Add Component Flyout Menu ── -->
                    <StackPanel IsVisible="{Binding IsAddComponentMenuOpen}" Spacing="2" Margin="0,-8,0,0">
                        <Border Background="{DynamicResource CardHeaderBackground}" CornerRadius="6" Padding="4" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Select Component Type" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="8,4"/>
                                <Button Content="💬 Dialogue &amp; Speaker"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="dialogue"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="4"/>
                                <Button Content="🖼️ Background Layer"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="background"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="4"/>
                                <Button Content="👤 Character Sprite"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="character"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="4"/>
                                <Button Content="🔊 Audio &amp; DSP"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="audio"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Engine Sync ── -->
                    <Button Content="Sync Selected Node to Engine" Command="{Binding PushHotReloadPacketCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource AccentButtonFg}" FontWeight="Bold" CornerRadius="4" Padding="12,8"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
