<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Faz 2 (EDITOR_UI_PORT_PLAN): paylaşılan stil sınıfları. Paneller Faz 4'te
         sabit FontSize/CornerRadius yerine bu sınıflara geçer. Değerler
         ThemeStyles.axaml token'larından gelir. -->

    <!-- Metin rolleri -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
        <Setter Property="LetterSpacing" Value="1.2"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Düğmeler (K2: 32 px yükseklik; K3: tek renk) -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForeground}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForeground}"/>
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Genişlet/daralt başlığı: "açık" durum bir SEÇİM değildir; Fluent'in
         vurgu dolgusu (kemik tonu) içerideki açık metinleri yok ediyordu. -->
    <Style Selector="ToggleButton.header:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Faz 3 (K4): üst kapsül (prototip .view-switcher / .view-button) -->
    <Style Selector="Button.capsule">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="12,6,12,4"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="Button.capsuleIcon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.capsule:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.capsuleIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
    </Style>
    <!-- Pasif taşıma düğmesi (oynamıyorken Duraklat/Adım): prototipteki gibi
         şeffaf zemin + soluk simge; Fluent'in gri pasif dolgusu değil. -->
    <Style Selector="Button.capsuleIcon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.capsuleIcon:disabled">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>
    <Style Selector="Border.capsuleDivider">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
    </Style>
    <Style Selector="MenuItem.capsuleMenu">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Faz 4: araç düğmesi (yüzen panellerde: zoom, sığdır, seçim) -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
    </Style>

    <!-- Yüzeyler -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
    </Style>
    <!-- Faz 4: kanvas üstünde yüzen paneller (kırıntı yolu, Node araç çubuğu,
         zoom şeridi, mini harita, görünümü sıfırla) -->
    <Style Selector="Border.floating">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="BoxShadow" Value="0 4 16 0 #40000000"/>
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource NodeCardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
    </Style>

    <!-- Faz 4 (insB): bileşen kartı başlığı/alan metinleri -->
    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="TextBlock.cardKind">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="TextBlock.fieldValue">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>

    <!-- Kart başlığındaki küçük metin düğmeleri (Yukarı/Aşağı/Ayar/Sil) -->
    <Style Selector="Button.compact, ToggleButton.compact">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="Button.compact:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.compact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
    </Style>
    <Style Selector="ToggleButton.compact:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
</Styles>
