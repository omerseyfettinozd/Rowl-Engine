<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:ctrl="using:RowlEngine.Editor.Controls"
             x:Class="RowlEngine.Editor.Views.Components.ScriptComponentView"
             x:DataType="comp:ScriptComponentViewModel">
  <Border Classes="card" ClipToBounds="True" Margin="0,4">
    <StackPanel>
      <Border Background="{DynamicResource CardHeaderBackground}" Padding="8,6">
        <Grid ColumnDefinitions="*, Auto">
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" ToolTip.Tip="{l:T Common.Enable.Tip}" MinWidth="0" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"/>
            <ToggleButton Grid.Column="1" Classes="header" IsChecked="{Binding IsExpanded}" ToolTip.Tip="{l:T Common.ExpandCollapse.Tip}"
                          Background="Transparent" BorderThickness="0" Padding="4,2"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{l:T Component.Script.Title}" Classes="cardTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{l:T Component.Script.Title}"/>
            </ToggleButton>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
            <Button Content="{l:T Common.MoveUp}" Command="{Binding MoveUpCommand}" ToolTip.Tip="{l:T Common.MoveUp.Tip}" Classes="compact"/>
            <Button Content="{l:T Common.MoveDown}" Command="{Binding MoveDownCommand}" ToolTip.Tip="{l:T Common.MoveDown.Tip}" Classes="compact"/>
            <ToggleButton IsChecked="{Binding IsExpanded}" Content="{l:T Common.Settings}" Classes="compact"/>
            <Button Content="{l:T Common.Delete}" Classes="compact" ToolTip.Tip="{l:T Common.RemoveComponent.Tip}" Command="{Binding RemoveSelfCommand}"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel IsVisible="{Binding IsExpanded}" Spacing="6" Margin="8,6">
      <TextBlock Text="{l:T Component.Script.Path.Label}" Classes="fieldLabel"/>
      <TextBox Text="{Binding ScriptPath}" Watermark="{l:T Component.Script.Path.Watermark}" />
      <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                 NodeId="{Binding Node.Id}" FieldKey="script.script_path" />
      <TextBlock Text="{l:T Component.Script.Inline.Label}" Classes="fieldLabel"/>
      <TextBox Text="{Binding InlineCode}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Watermark="{l:T Component.Script.Inline.Watermark}" />
      <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="{DynamicResource RadiusSmall}" Padding="8,6">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{l:T Component.Script.Runtime.Label}" Classes="muted" FontSize="{DynamicResource FontSizeBody}"/>
            <TextBlock Text="{Binding RuntimeState}" Classes="muted" FontSize="{DynamicResource FontSizeBody}"/>
          </StackPanel>
          <TextBlock Text="{Binding RuntimeError}" IsVisible="{Binding HasRuntimeError}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource ErrorColor}" />
        </StackPanel>
      </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
