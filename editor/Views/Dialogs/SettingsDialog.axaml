<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RowlEngine.Editor.ViewModels"
        xmlns:l="using:RowlEngine.Editor.Services.Strings"
        xmlns:s="using:RowlEngine.Editor.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="RowlEngine.Editor.Views.Dialogs.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="{l:T Settings.Window.Title}"
        Width="860" Height="620"
        MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBackground}"
        CanResize="True">

    <Window.Styles>
        <!-- Sekme şeridi (prototip .settings-nav): üstte başlık çizgisi, sekme panelinde 12,8 boşluk (+4 öğe kenarı = 16), altta içerik çizgisi.
             Avalonia 11 Fluent TabControl şablonunda TabStrip yok; şablon parçaları hedeflenir. -->
        <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Başlık -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="26,22,26,16">
            <StackPanel Spacing="4">
                <TextBlock FontSize="{DynamicResource FontSizeCaption}" LetterSpacing="1.5"
                           Foreground="{DynamicResource MutedText}"
                           Text="{l:T Settings.Header.Eyebrow}"/>
                <TextBlock FontSize="21" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Text="{l:T Menu.Settings}"/>
            </StackPanel>
        </Border>

        <!-- Ana içerik: sekmeler -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="0" Padding="0"
                    Background="Transparent">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Margin="12,8"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <!-- TERCİHLER (bu cihaz): Tema -->
            <TabItem Classes="compact settingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M12,3 a9,9 0 1 0 0,18 a4.5,4.5 0 0 1 0,-9 a4.5,4.5 0 0 0 0,-9 Z"
                              Width="16" Height="16" Stretch="Uniform"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent" HorizontalAlignment="Center"
                              Stroke="{Binding $parent[TabItem].Foreground}"/>
                        <TextBlock Text="{l:T Settings.Tab.Theme}" FontSize="{DynamicResource FontSizeBody}"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding $parent[TabItem].Foreground}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="26,24">
                    <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" LetterSpacing="1.5" Foreground="{DynamicResource MutedText}" Text="{l:T Settings.Scope.Preferences}"/>
                            <TextBlock FontSize="21" FontWeight="Normal" Foreground="{DynamicResource PrimaryText}" Text="{l:T Settings.Theme.Title}"/>
                            <TextBlock FontSize="{DynamicResource FontSizeBodyLarge}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Text="{l:T Settings.Theme.Desc}"/>
                        </StackPanel>
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="settingsCardTitle" Text="{l:T Settings.Theme.Label}"/>
                                <ComboBox ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding SelectedTheme}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource InputBackground}"
                                          Foreground="{DynamicResource PrimaryText}"
                                          BorderBrush="{DynamicResource BorderSubtle}"/>
                                <Button Classes="secondary" Content="{l:T Settings.Theme.Apply}"
                                        Command="{Binding ApplyThemeCommand}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Tema önizleme kartları: her temanın gerçek paleti (sabit swatch) -->
                        <WrapPanel Orientation="Horizontal">
                            <Border Width="140" Height="70" CornerRadius="{DynamicResource RadiusMedium}" Margin="0,0,8,8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Background="#19191C" Padding="10">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{l:T Settings.Theme.Sample}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                               Foreground="#F2EFE6" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{l:T Settings.Theme.Preview.Dark}" FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="#85858B" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Width="140" Height="70" CornerRadius="{DynamicResource RadiusMedium}" Margin="0,0,8,8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Background="#111113" Padding="10">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{l:T Settings.Theme.Sample}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                               Foreground="#F2EFE6" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{l:T Settings.Theme.Preview.Oled}" FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="#85858B" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TERCİHLER (bu cihaz): Genel -->
            <TabItem Classes="compact settingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M4,7 h10 M18,7 h2 M4,17 h2 M10,17 h10 M14,5 v4 M6,15 v4"
                              Width="16" Height="16" Stretch="Uniform"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent" HorizontalAlignment="Center"
                              Stroke="{Binding $parent[TabItem].Foreground}"/>
                        <TextBlock Text="{l:T Settings.Tab.General}" FontSize="{DynamicResource FontSizeBody}"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding $parent[TabItem].Foreground}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="26,24">
                    <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" LetterSpacing="1.5" Foreground="{DynamicResource MutedText}" Text="{l:T Settings.Scope.Preferences}"/>
                            <TextBlock FontSize="21" FontWeight="Normal" Foreground="{DynamicResource PrimaryText}" Text="{l:T Settings.General.Title}"/>
                            <TextBlock FontSize="{DynamicResource FontSizeBodyLarge}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Text="{l:T Settings.General.Desc}"/>
                        </StackPanel>
                        <!-- 2 sütun kart ızgarası -->
                        <UniformGrid Columns="2">
                            <!-- Faz 2b: arayüz dili (K5/K7/K9) -->
                            <Border Classes="settingsCard" Margin="0,0,12,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="settingsCardTitle" Text="{l:T Settings.Language}"/>
                                    <ComboBox x:Name="EditorLanguageCombo" ItemsSource="{Binding EditorLanguageOptions}"
                                              SelectedItem="{Binding SelectedEditorLanguageOption}" MinWidth="220">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SettingsViewModel+EditorLanguageOption">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Classes="hint" Text="{l:T Settings.Language.Hint}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Otomatik kaydetme -->
                            <Border Classes="settingsCard" Margin="0,0,12,12">
                                <StackPanel Spacing="10">
                                    <CheckBox Content="{l:T Settings.AutoSave}" FontSize="13"
                                              IsChecked="{Binding AutoSaveEnabled}"
                                              Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold"/>
                                    <StackPanel Spacing="4" IsVisible="{Binding AutoSaveEnabled}">
                                        <TextBlock Classes="body" Text="{l:T Settings.AutoSave.Interval}"/>
                                        <ComboBox ItemsSource="{Binding AutoSaveIntervals}"
                                                  SelectedItem="{Binding AutoSaveIntervalSeconds}"
                                                  HorizontalAlignment="Stretch"
                                                  Background="{DynamicResource InputBackground}"
                                                  Foreground="{DynamicResource PrimaryText}"
                                                  BorderBrush="{DynamicResource BorderSubtle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Faz 5 D6: azaltılmış hareket (erişilebilirlik) -->
                            <Border Classes="settingsCard" Margin="0,0,12,12">
                                <StackPanel Spacing="6">
                                    <CheckBox x:Name="ReduceMotionCheckBox"
                                              Content="{l:T Settings.General.ReduceMotion}"
                                              FontSize="13"
                                              IsChecked="{Binding ReduceMotion}"
                                              Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold"/>
                                    <TextBlock Classes="hint" Text="{l:T Settings.General.ReduceMotion.Hint}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Faz 8 D2: arayüz ölçeği + yüksek kontrast (erişilebilirlik) -->
                            <Border Classes="settingsCard" Margin="0,0,12,12">
                              <StackPanel Spacing="8">
                                <TextBlock Classes="settingsCardTitle" Text="{l:T Settings.UiScale}" />
                                <ComboBox x:Name="UiScaleCombo" ItemsSource="{Binding UiScaleOptions}"
                                          SelectedItem="{Binding SelectedUiScaleOption}" MinWidth="220">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingsViewModel+UiScaleOption">
                                      <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="hint" Text="{l:T Settings.UiScale.Hint}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                            <Border Classes="settingsCard" Margin="0,0,12,12">
                              <StackPanel Spacing="6">
                                <CheckBox x:Name="HighContrastCheckBox"
                                          Content="{l:T Settings.HighContrast}"
                                          FontSize="{DynamicResource FontSizeBody}"
                                          IsChecked="{Binding HighContrast}"
                                          Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" />
                                <TextBlock Classes="hint" Text="{l:T Settings.HighContrast.Hint}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TERCİHLER (bu cihaz): Oyuncu -->
            <TabItem Classes="compact settingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M4,6 h16 v12 h-16 Z M10,9.5 L15,12 L10,14.5 Z"
                              Width="16" Height="16" Stretch="Uniform"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent" HorizontalAlignment="Center"
                              Stroke="{Binding $parent[TabItem].Foreground}"/>
                        <TextBlock Text="{l:T Settings.Tab.Player}" FontSize="{DynamicResource FontSizeBody}"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding $parent[TabItem].Foreground}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="26,24">
                    <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" LetterSpacing="1.5" Foreground="{DynamicResource MutedText}" Text="{l:T Settings.Scope.Preferences}"/>
                            <TextBlock FontSize="21" FontWeight="Normal" Foreground="{DynamicResource PrimaryText}" Text="{l:T Settings.Player.Title}"/>
                            <TextBlock FontSize="{DynamicResource FontSizeBodyLarge}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Text="{l:T Settings.Player.Desc}"/>
                        </StackPanel>
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.Master}"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding MasterVolume}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.Music}"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding BgmVolume}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.Voice}"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding VoiceVolume}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.Sfx}"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding SfxVolume}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.TextSpeed}"/>
                                    <Slider Minimum="0.25" Maximum="4" Value="{Binding TextSpeedMultiplier}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.AutoAdvance}"/>
                                    <Slider Minimum="0" Maximum="60" Value="{Binding AutoAdvanceDelay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PROJE AYARLARI (project.rowlproj) -->
            <TabItem Classes="compact settingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M3,8 a1,1 0 0 1 1,-1 h5 l2,2 h8 a1,1 0 0 1 1,1 v8 a1,1 0 0 1 -1,1 H4 a1,1 0 0 1 -1,-1 Z"
                              Width="16" Height="16" Stretch="Uniform"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent" HorizontalAlignment="Center"
                              Stroke="{Binding $parent[TabItem].Foreground}"/>
                        <TextBlock Text="{l:T Settings.Tab.Project}" FontSize="{DynamicResource FontSizeBody}"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding $parent[TabItem].Foreground}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="26,24">
                    <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" LetterSpacing="1.5" Foreground="{DynamicResource MutedText}" Text="{l:T Settings.Scope.Project}"/>
                            <TextBlock FontSize="21" FontWeight="Normal" Foreground="{DynamicResource PrimaryText}" Text="{l:T Settings.Project.Title}"/>
                            <TextBlock FontSize="{DynamicResource FontSizeBodyLarge}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Text="{l:T Settings.Project.Desc}"/>
                        </StackPanel>
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Project.SaveSlots}"/>
                                    <NumericUpDown Minimum="1" Maximum="100" Value="{Binding ProjectSaveSlotCount}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Project.BgmTransition}"/>
                                    <ComboBox ItemsSource="{Binding ProjectBgmTransitionOptions}"
                                              SelectedItem="{Binding ProjectDefaultBgmTransition}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Project.TransitionDuration}"/>
                                    <NumericUpDown Minimum="0" Maximum="60" Increment="0.1"
                                                   Value="{Binding ProjectDefaultBgmTransitionDurationSeconds}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TERCİHLER (bu cihaz): Kısayollar -->
            <TabItem Classes="compact settingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M3,7 h18 v10 h-18 Z M7,11 h.01 M11,11 h.01 M15,11 h.01 M8,14 h8"
                              Width="16" Height="16" Stretch="Uniform"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent" HorizontalAlignment="Center"
                              Stroke="{Binding $parent[TabItem].Foreground}"/>
                        <TextBlock Text="{l:T Settings.Tab.Shortcuts}" FontSize="{DynamicResource FontSizeBody}"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding $parent[TabItem].Foreground}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="26,24">
                    <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" LetterSpacing="1.5" Foreground="{DynamicResource MutedText}" Text="{l:T Settings.Scope.Preferences}"/>
                            <TextBlock FontSize="21" FontWeight="Normal" Foreground="{DynamicResource PrimaryText}" Text="{l:T Settings.Shortcuts.Title}"/>
                        </StackPanel>
                        <!-- Faz 8 D1: tek kaynak EditorShortcutCatalog (MainWindow_KeyDown ile aynı; elle liste eksikti). -->
                        <Border Classes="settingsCard">
                            <ItemsControl ItemsSource="{Binding Shortcuts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="s:EditorShortcut">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Classes="body" Text="{Binding Description}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace"
                                                       Text="{Binding DisplayGesture}" Margin="12,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hakkında -->
            <TabItem Classes="compact settingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M12,3 a9,9 0 1 0 0,18 a9,9 0 1 0 0,-18 Z M12,11 v5 M12,8 h.01"
                              Width="16" Height="16" Stretch="Uniform"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent" HorizontalAlignment="Center"
                              Stroke="{Binding $parent[TabItem].Foreground}"/>
                        <TextBlock Text="{l:T Settings.Tab.About}" FontSize="{DynamicResource FontSizeBody}"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding $parent[TabItem].Foreground}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="26,24">
                    <StackPanel Spacing="18" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Classes="heading" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center">ROWL ENGINE</TextBlock>
                        <TextBlock Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" HorizontalAlignment="Center"
                                   Text="{l:T Settings.About.Tagline}"/>

                        <Border Classes="settingsCard" MinWidth="400">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" Margin="0,0,12,0" Text="{l:T Settings.About.Version}"/>
                                    <TextBlock Grid.Column="1" Classes="body" Foreground="{DynamicResource PrimaryText}">v1.0.0</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" Margin="0,0,12,0" Text="{l:T Settings.About.Engine}"/>
                                    <TextBlock Grid.Column="1" Classes="body" Foreground="{DynamicResource PrimaryText}">SDL3 Hardware Canvas + C++ Core</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" Margin="0,0,12,0" Text="{l:T Settings.About.Editor}"/>
                                    <TextBlock Grid.Column="1" Classes="body" Foreground="{DynamicResource PrimaryText}">Avalonia UI (.NET) + Zero-Copy P/Invoke</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" Margin="0,0,12,0" Text="{l:T Settings.About.Packaging}"/>
                                    <TextBlock Grid.Column="1" Classes="body" Foreground="{DynamicResource PrimaryText}" Text="{l:T Settings.About.Packaging.Value}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" Margin="0,0,12,0" Text="{l:T Settings.About.Platforms}"/>
                                    <TextBlock Grid.Column="1" Classes="body" Foreground="{DynamicResource PrimaryText}">Windows  Linux  macOS  Android  iOS</TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="hint" Foreground="{DynamicResource DimText}" HorizontalAlignment="Center">© 2024–2026 Rowl Engine Team</TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Alt düğmeler -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <Button DockPanel.Dock="Left" Classes="ghost" Content="{l:T Settings.ResetDefaults}"
                        Command="{Binding ResetDefaultsCommand}"
                        Foreground="{DynamicResource MutedText}"/>
                <Button DockPanel.Dock="Right" Classes="primary" Content="{l:T Settings.Close}"
                        Name="CloseButton" CornerRadius="10" Padding="20,10"
                        HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
