<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:ctrl="using:RowlEngine.Editor.Controls"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             mc:Ignorable="d"
             x:Class="RowlEngine.Editor.Views.Components.AudioComponentView"
             x:DataType="comp:AudioComponentViewModel">

    <Border Classes="card" ClipToBounds="True" Margin="0,4">
        <StackPanel>
            <!-- Component Header -->
            <Border Background="{DynamicResource CardHeaderBackground}" Padding="8,6">
                <Grid ColumnDefinitions="*, Auto">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" ToolTip.Tip="{l:T Common.Enable.Tip}" MinWidth="0" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" Classes="header" IsChecked="{Binding IsExpanded}" ToolTip.Tip="{l:T Common.ExpandCollapse.Tip}"
                                      Background="Transparent" BorderThickness="0" Padding="4,2"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="{l:T Component.Audio.Title}" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </ToggleButton>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Button Classes="compact" Content="{l:T Common.MoveUp}" Command="{Binding MoveUpCommand}" ToolTip.Tip="{l:T Common.MoveUp.Tip}"/>
                        <Button Classes="compact" Content="{l:T Common.MoveDown}" Command="{Binding MoveDownCommand}" ToolTip.Tip="{l:T Common.MoveDown.Tip}"/>
                        <ToggleButton Classes="compact" IsChecked="{Binding IsExpanded}" Content="{l:T Common.Settings}"/>
                        <Button Classes="compact" Content="{l:T Common.Delete}" Command="{Binding RemoveSelfCommand}" ToolTip.Tip="{l:T Common.RemoveComponent.Tip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Component Body -->
            <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="8,6">
                <!-- BGM Track -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:T Component.Audio.Bgm.Label}" Classes="body"/>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding BgmTrack}" Watermark="{l:T Component.Audio.Bgm.Watermark}"
                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                        <Button Classes="ghost" Grid.Column="1" Command="{Binding ToggleBgmPreviewCommand}" Padding="8,4"
                                ToolTip.Tip="{l:T Component.Audio.Bgm.Preview.Tip}">
                            <Panel>
                                <TextBlock Text="{l:T Component.Audio.Preview}" IsVisible="{Binding !IsPreviewingBgm}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{l:T Component.Audio.Stop}" IsVisible="{Binding IsPreviewingBgm}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource ErrorBrush}"/>
                            </Panel>
                        </Button>
                    </Grid>
                    <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                               NodeId="{Binding Node.Id}" FieldKey="audio.bgm_track"/>
                    <!-- BGM Stereo VU Meter -->
                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T Component.Audio.ChannelLeft}" Classes="caption" Width="12" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BgmPeakL}" Height="4" Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource InputBackground}" Margin="0,1"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T Component.Audio.ChannelRight}" Classes="caption" Width="12" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BgmPeakR}" Height="4" Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource InputBackground}" Margin="0,1"/>
                    </Grid>
                </StackPanel>

                <!-- SFX Track -->
                <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:T Component.Audio.Sfx.Label}" Classes="body"/>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding SfxTrack}" Watermark="{l:T Component.Audio.Sfx.Watermark}"
                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                        <Button Classes="ghost" Grid.Column="1" Command="{Binding ToggleSfxPreviewCommand}" Padding="8,4"
                                ToolTip.Tip="{l:T Component.Audio.Sfx.Preview.Tip}">
                            <Panel>
                                <TextBlock Text="{l:T Component.Audio.Preview}" IsVisible="{Binding !IsPreviewingSfx}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="{l:T Component.Audio.Stop}" IsVisible="{Binding IsPreviewingSfx}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource ErrorBrush}"/>
                            </Panel>
                        </Button>
                    </Grid>
                    <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                               NodeId="{Binding Node.Id}" FieldKey="audio.sfx_track"/>
                    <!-- SFX Stereo VU Meter -->
                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T Component.Audio.ChannelLeft}" Classes="caption" Width="12" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SfxPeakL}" Height="4" Foreground="{DynamicResource Accent}" Background="{DynamicResource InputBackground}" Margin="0,1"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T Component.Audio.ChannelRight}" Classes="caption" Width="12" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SfxPeakR}" Height="4" Foreground="{DynamicResource Accent}" Background="{DynamicResource InputBackground}" Margin="0,1"/>
                    </Grid>
                    <!-- Faz 5 Dilim 1: OGG streaming karar rozeti -->
                    <ctrl:AudioStreamingBadge Mode="{Binding StreamMode}" BadgeText="{Binding StreamBadgeText}"/>
                </StackPanel>

                <!-- Volume Slider -->
                <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="{l:T Component.Audio.Volume.Label}" Classes="body"/>
                        <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat={}{0:P0}}" Classes="body"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" SmallChange="0.05" LargeChange="0.1"/>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="{l:T Component.Audio.Dsp.Label}" Classes="body"/>
                    <ComboBox SelectedItem="{Binding DspFilter}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}">
                        <x:String>Normal</x:String>
                        <x:String>Telephone</x:String>
                        <x:String>CaveReverb</x:String>
                        <x:String>UnderwaterLowPass</x:String>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:T Component.Audio.BgmTransition.Label}" Classes="body"/>
                    <ComboBox SelectedItem="{Binding BgmTransition}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}">
                        <x:String>project_default</x:String>
                        <x:String>instant</x:String>
                        <x:String>fade</x:String>
                        <x:String>crossfade</x:String>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:T Component.Audio.BgmTransitionDuration.Label}" Classes="body"/>
                    <NumericUpDown Minimum="0" Maximum="60" Increment="0.1" Value="{Binding BgmTransitionDurationSeconds}"/>
                </StackPanel>
                <!-- Faz 5 Dilim 2 fix turu 1: per-node fade/BedB/crossfade
                     kontrolleri kaldırıldı — global mixer config profil
                     kaynağından playback-start yolunda uygulanır
                     (AUDIO_MIXER_CONTRACT §7). -->
                <!-- Faz 5 Dilim 2: pump maliyeti rozeti (örneklenmemişse gizli) -->
                <Border IsVisible="{Binding IsPumpBadgeVisible}" Background="{DynamicResource SurfaceBackground}" CornerRadius="{DynamicResource RadiusSmall}" Padding="6,3" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                    <TextBlock Text="{Binding PumpBadgeText}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
