<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:RowlEngine.Editor.Views"
             xmlns:vm="clr-namespace:RowlEngine.Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="RowlEngine.Editor.Views.EnginePreviewControl"
             x:DataType="vm:MainWindowViewModel"
             PointerPressed="OnPreviewPointerPressed">

    <Border Background="#0B0F19" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
        <Grid RowDefinitions="Auto, *">

            <!-- Top HUD overlay bar -->
            <Border Grid.Row="0" Background="#0F172A" Opacity="0.96" Padding="20,8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="🎮 GAME" Foreground="#00F0FF"
                                   FontSize="14" FontWeight="Bold"/>
                        <Border Background="#1E293B" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="SDL3 · Offscreen Framebuffer (Click to Advance Node)"
                                       Foreground="#64748B" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <!-- Engine status badge (right side) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Spacing="8">
                        <Border x:Name="StatusBadge" Background="#16A34A"
                                CornerRadius="4" Padding="8,3">
                            <TextBlock x:Name="StatusText" Text="● OFFSCREEN LIVE"
                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedNode.Title, StringFormat='Node: {0}', FallbackValue='No node selected'}"
                                   Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Offscreen Render Target Image -->
            <Border Grid.Row="1" Background="#0B0F19" ClipToBounds="True" PointerPressed="OnPreviewPointerPressed">
                <Image Source="{Binding EngineHost.RenderTargetBitmap}"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"/>
            </Border>

        </Grid>
    </Border>
</UserControl>
