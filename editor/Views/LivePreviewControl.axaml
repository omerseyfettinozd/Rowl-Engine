<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RowlEngine.Editor.ViewModels"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="RowlEngine.Editor.Views.LivePreviewControl"
             x:DataType="vm:MainWindowViewModel">

    <Border Background="#0B0F19" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DragDrop.AllowDrop="True">
        <Grid>
            <!-- 16:9 Aspect Guardian Letterbox Container -->
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                <Border Width="1920" Height="1080" Background="#121624" CornerRadius="8" ClipToBounds="True" BoxShadow="0 10 30 0 #000000">
                    <Canvas x:Name="ViewportCanvas" Width="1920" Height="1080" Background="#161B2E">
                        <Canvas.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🎯 Merkeze Hizala (Center to Screen)" Command="{Binding CenterSelectedElementCommand}"/>
                                <MenuItem Header="📐 Çerçeveye Sığdır (Fit to Canvas)" Command="{Binding FitBackgroundToScreenCommand}"/>
                                <MenuItem Header="🖼️ Arka Planı 1920x1080 Yap (Stretch Full HD)" Command="{Binding FitBackgroundToScreenCommand}"/>
                                <MenuItem Header="⬇️ Karakterleri Zemine Oturt (Ground Baseline)" Command="{Binding AlignCharacterToBottomCommand}"/>
                                <Separator/>
                                <MenuItem Header="↕ Diyalog Alt Banner (1720x220)" Command="{Binding PresetDialogueBoxCommand}" CommandParameter="BottomBanner"/>
                                <MenuItem Header="🎯 Diyalog Kutusunu Ortala" Command="{Binding PresetDialogueBoxCommand}" CommandParameter="Center"/>
                                <Separator/>
                                <MenuItem Header="🧲 Manyetik Snap Kılavuzları (Snap Assist)" Command="{Binding ToggleSnapAssistCommand}"/>
                                <MenuItem Header="🔄 Rotasyonu Sıfırla (Reset Rotation)" Command="{Binding ResetRotationCommand}"/>
                            </ContextMenu>
                        </Canvas.ContextMenu>

                        <!-- Scene Background Bitmap Layer -->
                        <Border x:Name="BackgroundBox"
                                IsVisible="{Binding SelectedNode.HasBackground}"
                                Canvas.Left="{Binding SelectedNode.BackgroundX}" 
                                Canvas.Top="{Binding SelectedNode.BackgroundY}" 
                                Width="{Binding SelectedNode.BackgroundWidth}" 
                                Height="{Binding SelectedNode.BackgroundHeight}" 
                                RenderTransformOrigin="50%,50%"
                                Background="#1A2035" BorderBrush="#3B82F6" BorderThickness="1.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="{Binding SelectedNode.BackgroundRotation}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <!-- Actual Bitmap Image Render (HitTest disabled so container handles drag) -->
                                <Image Source="{Binding SelectedNode.BackgroundBitmap}" Stretch="Fill" 
                                       Width="{Binding SelectedNode.BackgroundWidth}" Height="{Binding SelectedNode.BackgroundHeight}"
                                       IsHitTestVisible="False"/>
                                
                                <!-- Decorative Atmosphere Fallback Text if Bitmap loading -->
                                <TextBlock Text="{Binding SelectedNode.BackgroundTexture, StringFormat='Scene BG: {0}'}" 
                                           IsVisible="{Binding SelectedNode.BackgroundBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                                           Foreground="#64748B" FontSize="20" FontWeight="Bold" Margin="40,90" HorizontalAlignment="Left"
                                           IsHitTestVisible="False"/>

                                <!-- Background Rotate Handle (Top-Center) -->
                                <Border Name="BgRotateHandle" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top" 
                                        Background="#A855F7" BorderBrush="White" BorderThickness="2" CornerRadius="9" Cursor="Hand" Margin="0,-27,0,0"
                                        PointerPressed="OnBgRotateHandlePointerPressed"
                                        ToolTip.Tip="Rotate Background (Drag to Rotate, Right-Click to Reset)"/>

                                <!-- Background Resize Handles -->
                                <Border Name="BgHandleBR" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                        Background="#3B82F6" BorderBrush="White" BorderThickness="2" CornerRadius="9" Cursor="BottomRightCorner" Margin="0,0,-7,-7" ToolTip.Tip="Resize Background"/>
                            </Grid>
                        </Border>

                        <!-- Interactive Multi-Character Sprite Layer (Renders ALL Character Components) -->
                        <ItemsControl ItemsSource="{Binding SelectedNode.CharacterComponents}"
                                      Width="1920" Height="1080" Canvas.Left="0" Canvas.Top="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="1920" Height="1080" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="comp:CharacterComponentViewModel">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="comp:CharacterComponentViewModel">
                                    <Border Width="{Binding Width}" 
                                            Height="{Binding Height}" Cursor="Hand"
                                            IsVisible="{Binding IsEnabled}"
                                            RenderTransformOrigin="50%,50%"
                                            Background="#2A374A" BorderBrush="#00F0FF" BorderThickness="2" CornerRadius="8" BoxShadow="0 10 30 0 #000000"
                                            PointerPressed="OnCharacterPointerPressed">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="{Binding Rotation}"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <!-- Bitmap Image Render for Character (Exact full-bleed bounding box with Uniform stretch) -->
                                            <Image Source="{Binding SpriteBitmap}" Stretch="Uniform" IsHitTestVisible="False"/>

                                            <!-- Fallback Placeholder if Image fails -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                                                        IsVisible="{Binding SpriteBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                                                        IsHitTestVisible="False">
                                                <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Sprite}" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Overlay Label at Bottom -->
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#D00F172A" Padding="6,2" Margin="0,0,0,4" CornerRadius="4" IsHitTestVisible="False">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="👤 Character" Foreground="#00F0FF" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Width, StringFormat='({0:0}'}" Foreground="#94A3B8" FontSize="9"/>
                                                    <TextBlock Text="x" Foreground="#94A3B8" FontSize="9"/>
                                                    <TextBlock Text="{Binding Height, StringFormat='{}{0:0})'}" Foreground="#94A3B8" FontSize="9"/>
                                                    <TextBlock Text="{Binding Rotation, StringFormat='{} {0:0}°'}" Foreground="#A855F7" FontSize="9"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Character Rotate Handle (Top-Center) -->
                                            <Border Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                    Background="#A855F7" BorderBrush="White" BorderThickness="2" CornerRadius="9" Cursor="Hand" Margin="0,-27,0,0"
                                                    PointerPressed="OnCharRotateHandlePointerPressed"
                                                    ToolTip.Tip="Rotate Character (Drag to Rotate, Right-Click to Reset)"/>

                                            <!-- Character Resize Handle (Bottom-Right) -->
                                            <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Background="#00F0FF" BorderBrush="White" BorderThickness="2" CornerRadius="9" Cursor="BottomRightCorner" Margin="0,0,-5,-5"
                                                    PointerPressed="OnCharHandlePointerPressed"
                                                    ToolTip.Tip="Resize Character"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Multi-Dialogue Box Canvas Elements with Individual Drag & Resize -->
                        <ItemsControl ItemsSource="{Binding SelectedNode.DialogueComponents}"
                                      Width="1920" Height="1080" Canvas.Left="0" Canvas.Top="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="1920" Height="1080" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="comp:DialogueComponentViewModel">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    <Setter Property="ZIndex" Value="30"/>
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="comp:DialogueComponentViewModel">
                                    <Border Width="{Binding Width}" 
                                            Height="{Binding Height}" Cursor="Hand"
                                            IsVisible="{Binding IsEnabled}"
                                            Background="{Binding BoxColor}"
                                            Opacity="{Binding BoxOpacity}"
                                            BorderBrush="{Binding BorderColorHex}"
                                            BorderThickness="{Binding BorderThickness}"
                                            CornerRadius="{Binding CornerRadius}"
                                            BoxShadow="0 10 30 0 #000000"
                                            PointerPressed="OnDialogueBoxItemPointerPressed">
                                        <Grid>
                                            <!-- Speaker Name Badge -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="20,-18,0,0"
                                                    Background="{Binding SpeakerColor}"
                                                    CornerRadius="6" Padding="14,4"
                                                    BoxShadow="0 4 10 0 #000000" IsHitTestVisible="False">
                                                <TextBlock Text="{Binding Speaker, FallbackValue='Evelyn'}"
                                                           Foreground="#FFFFFF"
                                                           FontSize="{Binding SpeakerFontSize}"
                                                           FontWeight="Bold"/>
                                            </Border>

                                            <!-- Dialogue Content Text Container (HitTest disabled so box receives pointer events) -->
                                            <ScrollViewer Margin="20,28,20,20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsHitTestVisible="False">
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="{Binding DialogueText, FallbackValue='...'}" 
                                                           Foreground="{Binding TextColor}" 
                                                           FontSize="{Binding FontSize}"
                                                           TextAlignment="{Binding TextAlignment}"/>
                                            </ScrollViewer>

                                            <!-- Drag handle badge -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,14,0" Background="#0F172A" BorderBrush="{Binding BorderColorHex}" BorderThickness="1" CornerRadius="4" Padding="6,2" IsHitTestVisible="False">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="💬 Dialogue Box" Foreground="{Binding BorderColorHex}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Width, StringFormat='({0:0}'}" Foreground="#94A3B8" FontSize="10"/>
                                                    <TextBlock Text="x" Foreground="#94A3B8" FontSize="10"/>
                                                    <TextBlock Text="{Binding Height, StringFormat='{}{0:0})'}" Foreground="#94A3B8" FontSize="10"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Dialogue Box Resize Corner Handles -->
                                            <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding BorderColorHex}" BorderBrush="White" BorderThickness="2" CornerRadius="9" Cursor="TopLeftCorner" Margin="-7,-7,0,0"
                                                    PointerPressed="OnDialogueHandleTLPointerPressed" ToolTip.Tip="Resize Top-Left"/>
                                            <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{Binding BorderColorHex}" BorderBrush="White" BorderThickness="2" CornerRadius="9" Cursor="TopRightCorner" Margin="0,-7,-7,0"
                                                    PointerPressed="OnDialogueHandleTRPointerPressed" ToolTip.Tip="Resize Top-Right"/>
                                            <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{Binding BorderColorHex}" BorderBrush="White" BorderThickness="2" CornerRadius="9" Cursor="BottomLeftCorner" Margin="-7,0,0,-7"
                                                    PointerPressed="OnDialogueHandleBLPointerPressed" ToolTip.Tip="Resize Bottom-Left"/>
                                            <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{Binding BorderColorHex}" BorderBrush="White" BorderThickness="2" CornerRadius="9" Cursor="BottomRightCorner" Margin="0,0,-7,-7"
                                                    PointerPressed="OnDialogueHandleBRPointerPressed" ToolTip.Tip="Resize Bottom-Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Runtime choice-button preview: each graph option becomes one player-facing button. -->
                        <ItemsControl ItemsSource="{Binding SelectedNode.ChoiceOptions}" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" ZIndex="60">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas Width="1920" Height="1080"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="comp:ChoiceOptionViewModel">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    <Setter Property="ZIndex" Value="60"/>
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="comp:ChoiceOptionViewModel">
                                    <Border Width="{Binding Width}" Height="{Binding Height}"
                                            IsVisible="{Binding IsEnabled}"
                                            Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}"
                                            BorderThickness="{Binding BorderThickness}" CornerRadius="{Binding CornerRadius}"
                                            Opacity="{Binding Opacity}" DragDrop.AllowDrop="True"
                                            PointerPressed="OnChoiceButtonPointerPressed">
                                        <Grid>
                                            <Image Source="{Binding NormalBitmap}" Stretch="Fill" Opacity="0.85" IsHitTestVisible="False"/>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding TextColor}"
                                                       FontFamily="{Binding FontFamily}"
                                                       TextAlignment="{Binding TextAlignment}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                       Margin="{Binding Padding}" TextWrapping="Wrap" IsHitTestVisible="False"/>
                                            <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Background="#38BDF8" BorderBrush="White" BorderThickness="2" CornerRadius="9"
                                                    Margin="0,0,-6,-6" Cursor="BottomRightCorner"
                                                    PointerPressed="OnChoiceButtonResizePointerPressed"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- OBS-Style Smart Snap Guidelines (Magnet Alignment Overlay) -->
                        <Border x:Name="SnapGuideV" Width="2" Height="1080" Background="#00F0FF" IsVisible="False" IsHitTestVisible="False" BoxShadow="0 0 12 3 #00F0FF" />
                        <Border x:Name="SnapGuideH" Height="2" Width="1920" Background="#00F0FF" IsVisible="False" IsHitTestVisible="False" BoxShadow="0 0 12 3 #00F0FF" />

                        <!-- Floating HUD Snap Tooltip Badge -->
                        <Border x:Name="SnapBadge" IsVisible="False" IsHitTestVisible="False" Background="#0F172A" BorderBrush="#00F0FF" BorderThickness="2" CornerRadius="6" Padding="10,5" BoxShadow="0 6 16 0 #000000">
                            <TextBlock x:Name="SnapBadgeText" Text="🧲 Snapped" Foreground="#00F0FF" FontSize="13" FontWeight="Bold"/>
                        </Border>

                    </Canvas>
                </Border>
            </Viewbox>

            <!-- Professional Stereo VU Meter HUD Badge (Bottom Right) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="14" Padding="8,5" CornerRadius="4"
                    Background="#D90F172A" BorderBrush="#334155" BorderThickness="1"
                    IsHitTestVisible="False" Opacity="0.9">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="🔊" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <!-- Left Channel -->
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="L" FontSize="9" Width="10" Foreground="#64748B" VerticalAlignment="Center"/>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding LivePreviewViewModel.MasterPeakL}" Width="64" Height="4"
                                         Foreground="#10B981" Background="#1E293B"/>
                        </StackPanel>
                        <!-- Right Channel -->
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="R" FontSize="9" Width="10" Foreground="#64748B" VerticalAlignment="Center"/>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding LivePreviewViewModel.MasterPeakR}" Width="64" Height="4"
                                         Foreground="#10B981" Background="#1E293B"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
