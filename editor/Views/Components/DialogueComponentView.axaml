<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             mc:Ignorable="d"
             x:Class="RowlEngine.Editor.Views.Components.DialogueComponentView"
             x:DataType="comp:DialogueComponentViewModel">

    <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Margin="0,4" Padding="0" BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
        <StackPanel>
            <!-- Component Header -->
            <Border Background="{DynamicResource CardHeaderBackground}" CornerRadius="6,6,0,0" Padding="8,6">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="💬" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Dialogue" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding IsEnabled}" ToolTip.Tip="Enable/Disable" MinWidth="0" Padding="0" Margin="0,0,2,0"/>
                        <Button Content="▲" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move Up" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
                        <Button Content="▼" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move Down" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
                        <ToggleButton IsChecked="{Binding IsExpanded}" Content="⚙️" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
                        <Button Content="🗑️" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="#EF4444" BorderThickness="0" ToolTip.Tip="Remove Component" Command="{Binding RemoveSelfCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Component Body -->
            <StackPanel IsVisible="{Binding IsExpanded}" Spacing="10" Margin="10,8">
                <!-- 1. Speaker & Dialogue Content -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="📝 SPEAKER &amp; TEXT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Speaker Name" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <TextBox Text="{Binding Speaker, Mode=TwoWay}" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0">
                                <TextBlock Text="Title Font (px)" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <NumericUpDown Value="{Binding SpeakerFontSize}" Width="85" Minimum="10" Maximum="64" Increment="2" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2" Margin="6,0,0,0">
                                <TextBlock Text="Title Color" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <TextBox Text="{Binding SpeakerColor, Mode=TwoWay}" Width="80" Background="{DynamicResource InputBackground}" Foreground="{Binding SpeakerColor}" BorderBrush="{DynamicResource BorderColor}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="2" Margin="0,2,0,0">
                            <TextBlock Text="Dialogue Content" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                            <TextBox Text="{Binding DialogueText, Mode=TwoWay}" AcceptsReturn="True" Height="64"
                                     TextWrapping="Wrap" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Typewriter & Timing Behavior -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="⌨️ TYPEWRITER &amp; TIMING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        
                        <Grid ColumnDefinitions="Auto, *">
                            <CheckBox Grid.Column="0" IsChecked="{Binding TypewriterEnabled}" Content="Enable Typewriter" FontSize="11" Foreground="{DynamicResource PrimaryText}" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding TypewriterEnabled}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Speed (ms/char)" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TextSpeed, StringFormat='{}{0} ms'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                </Grid>
                                <Slider Value="{Binding TextSpeed}" Minimum="5" Maximum="100" SmallChange="5" LargeChange="15"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *" Margin="0,2,0,0">
                            <CheckBox Grid.Column="0" IsChecked="{Binding AutoAdvance}" Content="Auto Advance" FontSize="11" Foreground="{DynamicResource PrimaryText}" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding AutoAdvance}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Wait Delay" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AutoAdvanceDelay, StringFormat='{}{0:F1}s'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                </Grid>
                                <Slider Value="{Binding AutoAdvanceDelay}" Minimum="0.5" Maximum="10.0" SmallChange="0.5"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Typography & Styling -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="🎨 TYPOGRAPHY &amp; STYLING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>

                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,4,0">
                                <TextBlock Text="Font Size (px)" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <NumericUpDown Value="{Binding FontSize}" Minimum="12" Maximum="64" Increment="2" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" Margin="4,0,0,0">
                                <TextBlock Text="Text Color (HEX)" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <TextBox Text="{Binding TextColor, Mode=TwoWay}" Background="{DynamicResource InputBackground}" Foreground="{Binding TextColor}" BorderBrush="{DynamicResource BorderColor}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="2" Margin="0,2,0,0">
                            <TextBlock Text="Alignment" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                            <Grid ColumnDefinitions="*, *, *">
                                <RadioButton Grid.Column="0" Content="Left" IsChecked="{Binding IsAlignLeft}" GroupName="AlignGroup" FontSize="10"/>
                                <RadioButton Grid.Column="1" Content="Center" IsChecked="{Binding IsAlignCenter}" GroupName="AlignGroup" FontSize="10"/>
                                <RadioButton Grid.Column="2" Content="Right" IsChecked="{Binding IsAlignRight}" GroupName="AlignGroup" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. Box Visuals & Appearance -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="🖼️ BOX THEME &amp; OPACITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>

                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,4,0">
                                <TextBlock Text="Box Color (HEX)" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <TextBox Text="{Binding BoxColor}" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" Margin="4,0,0,0">
                                <TextBlock Text="Border Color (HEX)" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <TextBox Text="{Binding BorderColor}" Background="{DynamicResource InputBackground}" Foreground="{Binding BorderColor}" BorderBrush="{DynamicResource BorderColor}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="2" Margin="0,2,0,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Box Opacity" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding BoxOpacity, StringFormat='{}{0:P0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                            </Grid>
                            <Slider Value="{Binding BoxOpacity}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. Geometry Coordinates & Size -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="📐 TRANSFORM &amp; PRESETS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>

                        <Grid ColumnDefinitions="*, *" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,4,0">
                                <TextBlock Text="Box X" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <NumericUpDown Value="{Binding X}" Minimum="-500" Maximum="2500" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" Margin="4,0,0,0">
                                <TextBlock Text="Box Y" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <NumericUpDown Value="{Binding Y}" Minimum="-500" Maximum="2500" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,4,0">
                                <TextBlock Text="Width" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <NumericUpDown Value="{Binding Width}" Minimum="100" Maximum="1920" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" Margin="4,0,0,0">
                                <TextBlock Text="Height" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                <NumericUpDown Value="{Binding Height}" Minimum="60" Maximum="1080" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="2">
                            <TextBlock Text="🔍 Scale (1.0 = 100%)" FontSize="10" Foreground="{DynamicResource AccentColor}" FontWeight="Bold"/>
                            <NumericUpDown Value="{Binding Scale}" Minimum="0.1" Maximum="5.0" Increment="0.1" FormatString="0.00" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource AccentColor}" BorderBrush="{DynamicResource BorderColor}"/>
                        </StackPanel>

                        <!-- Layout Presets (5 Presets) -->
                        <TextBlock Text="Quick Layout Presets" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*, *" Margin="0,2">
                            <Button Grid.Column="0" Content="↕ Standard Banner" HorizontalAlignment="Stretch" Margin="0,0,2,2" Padding="4,4" FontSize="10" Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}" CornerRadius="4"
                                    Command="{Binding SetStandardCommand}"/>
                            <Button Grid.Column="1" Content="⬜ Square Avatar" HorizontalAlignment="Stretch" Margin="2,0,0,2" Padding="4,4" FontSize="10" Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}" CornerRadius="4"
                                    Command="{Binding SetSquareCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*, *, *" Margin="0,2">
                            <Button Grid.Column="0" Content="📜 NVL Novel" HorizontalAlignment="Stretch" Margin="0,0,2,0" Padding="2,4" FontSize="9" Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}" CornerRadius="4"
                                    Command="{Binding SetNvlFullscreenCommand}"/>
                            <Button Grid.Column="1" Content="🎬 Top Subtitle" HorizontalAlignment="Stretch" Margin="1,0,1,0" Padding="2,4" FontSize="9" Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}" CornerRadius="4"
                                    Command="{Binding SetTopSubtitleCommand}"/>
                            <Button Grid.Column="2" Content="💭 Comic Bubble" HorizontalAlignment="Stretch" Margin="2,0,0,0" Padding="2,4" FontSize="9" Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}" CornerRadius="4"
                                    Command="{Binding SetComicBubbleCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
