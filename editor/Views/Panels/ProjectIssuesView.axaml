<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:RowlEngine.Editor.ViewModels" x:Class="RowlEngine.Editor.Views.Panels.ProjectIssuesView" x:DataType="vm:ProjectIssuesViewModel" x:Name="Root">
  <Border Background="{DynamicResource LogConsoleBg}" Padding="8">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" VerticalAlignment="Center">
        <TextBlock Text="Sorunlar" Foreground="{DynamicResource MutedText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="Analiz"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AnalyzeStoryGraphCommand}"
                ToolTip.Tip="Hikaye grafiğini analiz et"
                Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}"
                CornerRadius="6" Padding="10,4" FontSize="11"/>
      </DockPanel>
      <ScrollViewer><ItemsControl ItemsSource="{Binding Issues}"><ItemsControl.ItemTemplate><DataTemplate>
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding #Root.DataContext.FocusCommand}" CommandParameter="{Binding}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}"/></Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
