<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RowlEngine.Editor.ViewModels"
        xmlns:views="using:RowlEngine.Editor.Views"
        xmlns:panels="using:RowlEngine.Editor.Views.Panels"
        xmlns:search="using:RowlEngine.Editor.Services.Search"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="RowlEngine.Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Rowl Engine Editor"
        Width="1600" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- PROFESSIONAL TOOLBAR: 2 Satırlı Düzen / Satır 1: Logo + Gezinme Sekmeleri + Pencereler Menüsü / Satır 2: Kaydet + Undo/Redo + Arama + Node İşlemleri + Build + Play + Ayarlar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" 
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel>

                <!-- Satır 1: Logo + Gezinme + Pencereler -->
                <Border Padding="12,6,12,4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Menu Background="Transparent">
                                <MenuItem x:Name="WindowsMenu" Header="Pencereler" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="SemiBold">
                                    <MenuItem Header="Hiyerarşi" InputGesture="Ctrl+1" Command="{Binding ShowPanelCommand}" CommandParameter="Hierarchy"/>
                                    <MenuItem Header="Denetçi" InputGesture="Ctrl+2" Command="{Binding ShowPanelCommand}" CommandParameter="Inspector"/>
                                    <MenuItem Header="Günlük" InputGesture="Ctrl+3" Command="{Binding ShowPanelCommand}" CommandParameter="Log"/>
                                <MenuItem Header="Varlıklar" InputGesture="Ctrl+4" Command="{Binding ShowPanelCommand}" CommandParameter="Assets"/>
                                <MenuItem Header="Diyalog Geçmişi" InputGesture="Ctrl+5" Command="{Binding ShowPanelCommand}" CommandParameter="Backlog"/>
                                <MenuItem Header="Kayıt Slotları" InputGesture="Ctrl+6" Command="{Binding ShowPanelCommand}" CommandParameter="SaveSlots"/>
                                <MenuItem Header="Sorunlar" InputGesture="Ctrl+7" Command="{Binding ShowPanelCommand}" CommandParameter="ProjectIssues"/>
                                </MenuItem>
                            </Menu>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="ROWL" FontWeight="Black" Foreground="{DynamicResource Accent}" FontSize="14" VerticalAlignment="Center" LetterSpacing="0.5"/>
                            <TextBlock Text="STORY STUDIO" FontWeight="Light" Foreground="{DynamicResource MutedText}" FontSize="14" VerticalAlignment="Center" Margin="-2,0,0,0"/>

                            <Border Width="1" Height="18" Background="{DynamicResource BorderColor}" Margin="8,0"/>

                            <Menu Background="Transparent" VerticalAlignment="Center">
                                <MenuItem x:Name="ProjectsMenu" Header="Projeler" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold">
                                    <MenuItem Header="Proje Listesi" Command="{Binding OpenProjectHubCommand}"
                                              Foreground="{DynamicResource PrimaryText}" FontSize="11"/>
                                    <MenuItem Header="Çeviri Masası" Command="{Binding OpenLocalizationDeskCommand}"
                                              Foreground="{DynamicResource PrimaryText}" FontSize="11"/>
                                </MenuItem>
                            </Menu>

                            <Border Width="1" Height="18" Background="{DynamicResource BorderColor}" Margin="6,0"/>

                            <!-- Gezinme Sekmeleri -->
                            <Button Content="Sahneler" Command="{Binding ShowPanelCommand}" CommandParameter="NodeGraph"
                                    Background="Transparent" Foreground="{DynamicResource PrimaryText}" 
                                    CornerRadius="6" Padding="10,5" FontSize="11"/>
                            <Button Content="Önizleme" Command="{Binding ShowPanelCommand}" CommandParameter="Preview"
                                    Background="Transparent" Foreground="{DynamicResource PrimaryText}" 
                                    CornerRadius="6" Padding="10,5" FontSize="11"/>
                            <Button Content="Oyuncu" Command="{Binding ShowPanelCommand}" CommandParameter="EnginePreview"
                                    ToolTip.Tip="Oyuncu önizleme paneli (sağ tık: bağımsız pencere)"
                                    Background="Transparent" Foreground="{DynamicResource PrimaryText}"
                                    CornerRadius="6" Padding="10,5" FontSize="11">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Bağımsız Pencerede Aç" Command="{Binding OpenPlayerWindowCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="{Binding SplitScreenButtonText}" 
                                    Command="{Binding ShowPanelCommand}" CommandParameter="SplitScreen"
                                    Background="{Binding SplitScreenButtonColor}" 
                                    Foreground="{Binding SplitScreenButtonForeground}"
                                    FontWeight="Bold" FontSize="11" CornerRadius="6" Padding="10,5"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- İnce Ayırıcı -->
                <Border Height="1" Background="{DynamicResource BorderColor}"/>

                <!-- Satır 2: Eylem Butonları (Unity düzeni: sol araçlar | orta taşıma | sağ build) -->
                <Border Padding="12,5,12,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!-- Sağ: Build + Ayarlar (Play taşıma kümesine taşındı) -->
                        <StackPanel x:Name="ToolbarRightGroups" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Build Al -->
                            <Button Content="{Binding BuildButtonText}" 
                                    ToolTip.Tip="{Binding BuildButtonTooltip}" 
                                    Command="{Binding BuildGameCommand}" 
                                    IsEnabled="{Binding !IsBuilding}"
                                    Background="{DynamicResource AccentButtonBg}"
                                    Foreground="{DynamicResource AccentButtonFg}" CornerRadius="6" Padding="12,5"
                                    FontWeight="Bold" FontSize="11"/>
                            <Button Content="İptal" IsVisible="{Binding IsBuilding}" Command="{Binding CancelBuildCommand}"
                                    ToolTip.Tip="Build işlemini iptal et" Padding="8,5" FontSize="11"/>

                            <Border Width="1" Height="22" Background="{DynamicResource BorderColor}" Margin="2,0"/>

                            <!-- Ayarlar -->
                            <Button Content="Ayarlar"
                                    ToolTip.Tip="Ayarlar (Ctrl+,)"
                                    Command="{Binding OpenSettingsCommand}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource MutedText}"
                                    CornerRadius="6" Padding="8,5" FontSize="11"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
                        </StackPanel>

                        <!-- Sol: Kaydet (tek) + Geçmiş ikilisi + Node grubu -->
                        <StackPanel x:Name="ToolbarLeftGroups" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Kaydet"
                                    ToolTip.Tip="Projeyi Kaydet (Ctrl+S)"
                                    Command="{Binding SaveProjectCommand}"
                                    Background="{DynamicResource ToolbarButtonBg}"
                                    Foreground="{DynamicResource PrimaryText}"
                                    CornerRadius="6" Padding="10,5" FontWeight="SemiBold" FontSize="11"/>

                            <Border Width="1" Height="22" Background="{DynamicResource BorderColor}" Margin="2,0"/>

                            <Button Content="Geri Al"
                                    ToolTip.Tip="Geri Al (Ctrl+Z)"
                                    Command="{Binding UndoCommand}"
                                    IsEnabled="{Binding UndoRedo.CanUndo}"
                                    Background="{DynamicResource ToolbarButtonBg}"
                                    Foreground="{DynamicResource PrimaryText}"
                                    CornerRadius="6" Padding="8,5" FontSize="11"/>

                            <Button Content="Yinele"
                                    ToolTip.Tip="Yinele (Ctrl+Y)"
                                    Command="{Binding RedoCommand}"
                                    IsEnabled="{Binding UndoRedo.CanRedo}"
                                    Background="{DynamicResource ToolbarButtonBg}"
                                    Foreground="{DynamicResource PrimaryText}"
                                    CornerRadius="6" Padding="8,5" FontSize="11"/>

                            <Border Width="1" Height="22" Background="{DynamicResource BorderColor}" Margin="2,0"/>

                            <Button Content="+ Node"
                                    ToolTip.Tip="Yeni Node Ekle (Ctrl+N)"
                                    Command="{Binding AddNodeCommand}"
                                    Background="{DynamicResource PrimaryText}"
                                    Foreground="{DynamicResource AppBackground}" FontWeight="Bold" CornerRadius="6" Padding="10,5" FontSize="11"/>
                            <Button Content="Bağlantıyı Kes"
                                    ToolTip.Tip="Seçili Node Bağlantılarını Kes"
                                    Command="{Binding DisconnectSelectedNodeCablesCommand}"
                                    Background="{DynamicResource ToolbarButtonBg}"
                                    Foreground="{DynamicResource PrimaryText}" CornerRadius="6" Padding="10,5" FontSize="11"/>
                            <Button Content="Sil"
                                    ToolTip.Tip="Seçili Node'u Sil (Delete)"
                                    Command="{Binding DeleteSelectedNodeCommand}"
                                    Background="{DynamicResource DangerButtonBg}"
                                    Foreground="{DynamicResource AccentButtonFg}" CornerRadius="6" Padding="10,5" FontSize="11"/>

                            <Border Width="1" Height="22" Background="{DynamicResource BorderColor}" Margin="2,0"/>

                            <Button Content="+ Grup" Command="{Binding CreateGroupFromSelectionCommand}"
                                    ToolTip.Tip="Seçili düğümlerden grup oluştur"
                                    Background="{DynamicResource ToolbarButtonBg}"
                                    Foreground="{DynamicResource PrimaryText}"
                                    CornerRadius="6" Padding="10,5" FontSize="11"/>
                            <Button Content="Üst" Command="{Binding ExitSubgraphCommand}"
                                    ToolTip.Tip="Bir üst düzeye çık"
                                    Background="{DynamicResource ToolbarButtonBg}"
                                    Foreground="{DynamicResource PrimaryText}"
                                    CornerRadius="6" Padding="10,5" FontSize="11"/>
                        </StackPanel>

                        <!-- Orta: Unity taşıma kümesi (Oynat/Duraklat/Adım).
                             Glifler bizim çizimimiz (Path); Unity artwork'ü yok. -->
                        <StackPanel x:Name="TransportCluster" Grid.Column="1" Orientation="Horizontal"
                                    Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Command="{Binding TogglePlayStandaloneCommand}"
                                    ToolTip.Tip="Oynat / Durdur"
                                    Background="{Binding PlayButtonColor}"
                                    CornerRadius="6" Padding="10,5">
                                <Path Data="M3,2 L11,7 L3,12 Z" Fill="{DynamicResource AccentButtonFg}"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding PauseStandaloneCommand}"
                                    IsEnabled="{Binding CanPauseStandalone}"
                                    ToolTip.Tip="Duraklat"
                                    Background="{DynamicResource ToolbarButtonBg}"
                                    CornerRadius="6" Padding="10,5">
                                <Path Data="M3,2 H5.5 V12 H3 Z M8.5,2 H11 V12 H8.5 Z" Fill="{DynamicResource PrimaryText}"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding StepStandaloneCommand}"
                                    IsEnabled="{Binding CanStepStandalone}"
                                    ToolTip.Tip="Kare Adım (1/60 sn)"
                                    Background="{DynamicResource ToolbarButtonBg}"
                                    CornerRadius="6" Padding="10,5">
                                <Path Data="M2,2 L8,7 L2,12 Z M9.5,2 H11.5 V12 H9.5 Z" Fill="{DynamicResource PrimaryText}"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding HierarchyPanelWidth}"/>
                <ColumnDefinition Width="{Binding HierarchySplitterWidth}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding InspectorSplitterWidth}"/>
                <ColumnDefinition Width="{Binding InspectorPanelWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Story structure; central canvas, preview, and inspector retain their behaviour. -->
            <Grid Grid.Column="0" IsVisible="{Binding IsHierarchyPanelVisible}" Background="{DynamicResource PanelBackground}">
                <panels:NodeHierarchyView/>
            </Grid>
            <GridSplitter Grid.Column="1" IsVisible="{Binding IsHierarchyPanelVisible}"
                          Background="{DynamicResource BorderColor}" ResizeDirection="Columns" Width="6"/>

            <!-- CENTER workspace -->
            <Grid Grid.Column="2" MinWidth="520" Background="{DynamicResource CanvasBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="{Binding BottomSplitterHeight}"/>
                    <RowDefinition Height="{Binding BottomPanelHeight}"/>
                    <RowDefinition Height="{Binding AssetsStripSplitterHeight}"/>
                    <RowDefinition Height="{Binding AssetsStripHeight}"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ClipToBounds="True">

                    <!-- BREADCRUMB + CHAPTER SCOPE (Faz 4 Dilim 3) -->
                    <Border x:Name="BreadcrumbPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="12,12,0,0" ZIndex="90"
                            Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4"
                            BoxShadow="0 4 16 0 #40000000">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Subgraphs.Crumbs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="/" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Tag="CrumbNav" Content="{Binding Title}" Padding="6,2" FontSize="11"
                                                    ToolTip.Tip="Bu düzeye dön"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Width="1" Height="14" Background="{DynamicResource BorderColor}"/>
                            <TextBlock Text="Bölüm:" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Subgraphs.AvailableChapterOptions}"
                                      SelectedItem="{Binding Subgraphs.ChapterFilterOption}"
                                      FontSize="11" MinWidth="110" ToolTip.Tip="Tuvali tek bölüme daralt"/>
                        </StackPanel>
                    </Border>

                    <!-- SINGLE MODE -->
                    <Grid IsVisible="{Binding IsSplitScreenOff}">
                        <panels:NodeGraphView IsVisible="{Binding IsNodeGraphActive}"/>
                        <views:LivePreviewControl IsVisible="{Binding IsPreviewActive}"/>
                        <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                    </Grid>

                    <!-- SPLIT SCREEN MODE (HORIZONTAL) -->
                    <Grid IsVisible="{Binding IsSplitScreenHorizontal}" RowDefinitions="*, 6, *" ClipToBounds="True">
                        <panels:NodeGraphView Grid.Row="0"/>
                        <GridSplitter Grid.Row="1" Background="{DynamicResource BorderColor}" ResizeDirection="Rows" Height="6"/>
                        <Grid Grid.Row="2">
                            <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                            <views:LivePreviewControl IsVisible="{Binding !IsEnginePreviewActive}"/>
                        </Grid>
                    </Grid>
                    
                    <!-- SPLIT SCREEN MODE (VERTICAL) -->
                    <Grid IsVisible="{Binding IsSplitScreenVertical}" ColumnDefinitions="*, 6, *" ClipToBounds="True">
                        <panels:NodeGraphView Grid.Column="0"/>
                        <GridSplitter Grid.Column="1" Background="{DynamicResource BorderColor}" ResizeDirection="Columns" Width="6"/>
                        <Grid Grid.Column="2">
                            <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                            <views:LivePreviewControl IsVisible="{Binding !IsEnginePreviewActive}"/>
                        </Grid>
                    </Grid>

                    <!-- GLOBAL SEARCH OVERLAY (Faz 4 Dilim 2) -->
                    <Border x:Name="SearchOverlayPanel" IsVisible="{Binding IsSearchVisible}"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,12,0,0" ZIndex="100"
                            Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                            CornerRadius="8" Padding="10" Width="520"
                            BoxShadow="0 8 24 0 #40000000">
                        <StackPanel Spacing="8">
                            <TextBox Text="{Binding SearchQuery}"
                                     Watermark="Ara: başlık, konuşmacı, metin, speaker:Evelyn, type:choice… (Esc kapat)"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderThickness="0" Padding="12,8" FontSize="14"/>
                            <!-- Filtre çubuğu: tür / konuşmacı / renk etiketi -->
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Tür:" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Search.AvailableNodeKinds}" SelectedItem="{Binding Search.SelectedNodeKind}" FontSize="11" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="Konuşmacı:" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Grid.Column="3" ItemsSource="{Binding Search.AvailableSpeakers}" SelectedItem="{Binding Search.SelectedSpeaker}" FontSize="11" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="Renk:" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Grid.Column="5" ItemsSource="{Binding Search.AvailableColorTags}" SelectedItem="{Binding Search.SelectedColorTag}" FontSize="11"/>
                            </Grid>
                            <!-- Sonuç listesi: başlık + alan rozeti + metin kesiti -->
                            <ListBox ItemsSource="{Binding Search.Results}"
                                     SelectedItem="{Binding Search.SelectedResult}"
                                     MaxHeight="300"
                                     Background="{DynamicResource InputBackground}"
                                     BorderThickness="0" CornerRadius="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="search:NodeSearchHit">
                                        <StackPanel Spacing="2" Margin="0,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding NodeTitle}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="12"/>
                                                <TextBlock Text="{Binding NodeId, StringFormat='#{0}'}" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                                                <Border Background="{DynamicResource AccentButtonBg}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FieldLabel}" FontSize="9" Foreground="{DynamicResource AccentButtonFg}" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding Search.StatusText}"
                                       Foreground="{DynamicResource MutedText}" FontSize="11"
                                       HorizontalAlignment="Right" IsVisible="{Binding Search.StatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" IsVisible="{Binding IsBottomPanelVisible}"
                              Background="{DynamicResource BorderColor}" ResizeDirection="Rows" Height="6"/>

                <!-- Bottom: Log + Assets (Tabbed) -->
                <Grid Grid.Row="2" MinHeight="140" IsVisible="{Binding IsBottomPanelVisible}">
                    <TabControl SelectedIndex="{Binding BottomPanelActiveTab}"
                                Background="{DynamicResource PanelBackground}">
                        <TabControl.Styles>
                            <Style Selector="TabItem">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Style>
                        </TabControl.Styles>
                        <TabItem Header="Günlük" IsVisible="{Binding IsLogPanelVisible}">
                            <panels:OutputLogView/>
                        </TabItem>
                        <TabItem Header="Diyalog Geçmişi" IsVisible="{Binding IsBacklogPanelVisible}">
                            <panels:BacklogView DataContext="{Binding BacklogViewModel}"/>
                        </TabItem>
                        <TabItem Header="Kayıt Slotları" IsVisible="{Binding IsSaveSlotsPanelVisible}">
                            <panels:SaveSlotsView DataContext="{Binding SaveSlotsViewModel}"/>
                        </TabItem>
                        <TabItem Header="Sorunlar" IsVisible="{Binding IsProjectIssuesPanelVisible}">
                            <panels:ProjectIssuesView DataContext="{Binding ProjectIssuesViewModel}"/>
                        </TabItem>
                    </TabControl>
                </Grid>

                <GridSplitter Grid.Row="3" IsVisible="{Binding IsAssetsPanelVisible}"
                              Background="{DynamicResource BorderColor}" ResizeDirection="Rows" Height="6"/>

                <!-- Assets şeridi (Faz 6 Dilim 2): sekmelerden bağımsız,
                     tuvalin altında kendi alanında yaşar -->
                <Grid Grid.Row="4" MinHeight="140" IsVisible="{Binding IsAssetsPanelVisible}">
                    <panels:ProjectAssetsView/>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" IsVisible="{Binding IsInspectorPanelVisible}"
                          Background="{DynamicResource BorderColor}" ResizeDirection="Columns" Width="6"/>

            <!-- RIGHT: Node Inspector -->
            <Grid Grid.Column="4" IsVisible="{Binding IsInspectorPanelVisible}" Background="{DynamicResource PanelBackground}">
                <panels:NodeInspectorView/>
            </Grid>
        </Grid>

        <!-- STATUS BAR (Alt Durum Çubuğu) -->
        <Border x:Name="StatusBarPanel" Grid.Row="2" Background="{DynamicResource StatusBarBg}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" 
                Padding="12,4" Height="28">
            <DockPanel>
                <!-- Sağ: Build Hedefi + Zoom -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="StatusZoomText" Text="{Binding ZoomScale, StringFormat='{}{0:P0}'}"
                               Foreground="{DynamicResource DimText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border Width="1" Height="14" Background="{DynamicResource BorderColor}"/>
                    <TextBlock x:Name="StatusBuildTargetText" Text="{Binding CurrentBuildTarget, StringFormat='{}{0}'}"
                               Foreground="{DynamicResource DimText}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Sol: Status Text -->
                <TextBlock x:Name="StatusMessageText" Text="{Binding StatusText}"
                           Foreground="{DynamicResource MutedText}" FontSize="11" 
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- TOAST NOTIFICATION OVERLAY (Sağ Alt) -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,40" ZIndex="200" Spacing="8">
            <Border x:Name="ToastPanel" IsVisible="{Binding Toast.IsVisible}"
                    Background="{Binding Toast.ToastBackground}" 
                    CornerRadius="8" Padding="16,10"
                    MinWidth="260" MaxWidth="420"
                    BoxShadow="0 4 16 0 #50000000">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Toast.ToastIcon}" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Toast.Message}"
                               Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Window>
