<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RowlEngine.Editor.ViewModels"
        xmlns:l="using:RowlEngine.Editor.Services.Strings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="RowlEngine.Editor.Views.Dialogs.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="{l:T Settings.Window.Title}"
        Width="720" Height="560"
        MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        CanResize="True">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Başlık -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Spacing="4">
                <TextBlock Classes="caption" Text="{l:T Settings.Header.Eyebrow}"/>
                <TextBlock Classes="heading" Text="{l:T Menu.Settings}"/>
            </StackPanel>
        </Border>

        <!-- Ana içerik: sekmeler -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="0" Padding="0"
                    Background="Transparent">

            <!-- TERCİHLER (bu cihaz): Tema / Genel / Oyuncu -->
            <TabItem Classes="compact" Header="{l:T Settings.Tab.Theme}">
                <ScrollViewer Padding="24,20">
                    <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="{l:T Settings.Scope.Preferences}"/>
                            <TextBlock Classes="title" Text="{l:T Settings.Theme.Title}"/>
                        <TextBlock Classes="hint" Text="{l:T Settings.Theme.Desc}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Classes="panel" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="body" Text="{l:T Settings.Theme.Label}"/>
                                <ComboBox ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding SelectedTheme}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource InputBackground}"
                                          Foreground="{DynamicResource PrimaryText}"
                                          BorderBrush="{DynamicResource BorderSubtle}"/>
                                <Button Classes="secondary" Content="{l:T Settings.Theme.Apply}"
                                        Command="{Binding ApplyThemeCommand}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Tema önizleme kartları: her temanın gerçek paleti (sabit swatch) -->
                        <WrapPanel Orientation="Horizontal">
                            <Border Width="140" Height="70" CornerRadius="{DynamicResource RadiusMedium}" Margin="0,0,8,8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Background="#19191C" Padding="10">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{l:T Settings.Theme.Sample}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                               Foreground="#F2EFE6" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{l:T Settings.Theme.Preview.Dark}" FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="#85858B" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Width="140" Height="70" CornerRadius="{DynamicResource RadiusMedium}" Margin="0,0,8,8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Background="#111113" Padding="10">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{l:T Settings.Theme.Sample}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                               Foreground="#F2EFE6" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{l:T Settings.Theme.Preview.Oled}" FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="#85858B" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="compact" Header="{l:T Settings.Tab.General}">
                <ScrollViewer Padding="24,20">
                    <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="{l:T Settings.Scope.Preferences}"/>
                            <TextBlock Classes="title" Text="{l:T Settings.General.Title}"/>
                        <TextBlock Classes="hint" Text="{l:T Settings.General.Desc}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Faz 2b: arayüz dili (K5/K7/K9) -->
                        <Border Classes="panel" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="body" FontWeight="SemiBold" Text="{l:T Settings.Language}"/>
                                <ComboBox x:Name="EditorLanguageCombo" ItemsSource="{Binding EditorLanguageOptions}"
                                          SelectedItem="{Binding SelectedEditorLanguageOption}" MinWidth="220">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingsViewModel+EditorLanguageOption">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="hint" Text="{l:T Settings.Language.Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Otomatik kaydetme -->
                        <Border Classes="panel" Padding="16">
                            <StackPanel Spacing="10">
                                <CheckBox Content="{l:T Settings.AutoSave}" FontSize="{DynamicResource FontSizeBodyLarge}"
                                          IsChecked="{Binding AutoSaveEnabled}"
                                          Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold"/>
                                <StackPanel Spacing="4" IsVisible="{Binding AutoSaveEnabled}">
                                    <TextBlock Classes="body" Text="{l:T Settings.AutoSave.Interval}"/>
                                    <ComboBox ItemsSource="{Binding AutoSaveIntervals}"
                                              SelectedItem="{Binding AutoSaveIntervalSeconds}"
                                              HorizontalAlignment="Stretch"
                                              Background="{DynamicResource InputBackground}"
                                              Foreground="{DynamicResource PrimaryText}"
                                              BorderBrush="{DynamicResource BorderSubtle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Faz 5 D6: azaltılmış hareket (erişilebilirlik) -->
                        <Border Classes="panel" Padding="16">
                            <StackPanel Spacing="6">
                                <CheckBox x:Name="ReduceMotionCheckBox"
                                          Content="{l:T Settings.General.ReduceMotion}"
                                          FontSize="{DynamicResource FontSizeBodyLarge}"
                                          IsChecked="{Binding ReduceMotion}"
                                          Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold"/>
                                <TextBlock Classes="hint" Text="{l:T Settings.General.ReduceMotion.Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="compact" Header="{l:T Settings.Tab.Player}">
                <ScrollViewer Padding="24,20">
                    <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="{l:T Settings.Scope.Preferences}"/>
                            <TextBlock Classes="title" Text="{l:T Settings.Player.Title}"/>
                        <TextBlock Classes="hint" Text="{l:T Settings.Player.Desc}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Classes="panel" Padding="16">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.Master}"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding MasterVolume}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.Music}"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding BgmVolume}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.Voice}"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding VoiceVolume}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.Sfx}"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding SfxVolume}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.TextSpeed}"/>
                                    <Slider Minimum="0.25" Maximum="4" Value="{Binding TextSpeedMultiplier}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Player.AutoAdvance}"/>
                                    <Slider Minimum="0" Maximum="60" Value="{Binding AutoAdvanceDelay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PROJE AYARLARI (project.rowlproj) -->
            <TabItem Classes="compact" Header="{l:T Settings.Tab.Project}">
                <ScrollViewer Padding="24,20">
                    <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="{l:T Settings.Scope.Project}"/>
                            <TextBlock Classes="title" Text="{l:T Settings.Project.Title}"/>
                        <TextBlock Classes="hint" Text="{l:T Settings.Project.Desc}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Classes="panel" Padding="16">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Project.SaveSlots}"/>
                                    <NumericUpDown Minimum="1" Maximum="100" Value="{Binding ProjectSaveSlotCount}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Project.BgmTransition}"/>
                                    <ComboBox ItemsSource="{Binding ProjectBgmTransitionOptions}"
                                              SelectedItem="{Binding ProjectDefaultBgmTransition}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="body" Text="{l:T Settings.Project.TransitionDuration}"/>
                                    <NumericUpDown Minimum="0" Maximum="60" Increment="0.1"
                                                   Value="{Binding ProjectDefaultBgmTransitionDurationSeconds}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="compact" Header="{l:T Settings.Tab.Shortcuts}">
                <ScrollViewer Padding="24,20">
                    <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="{l:T Settings.Scope.Preferences}"/>
                            <TextBlock Classes="title" Text="{l:T Settings.Shortcuts.Title}"/>
                        </StackPanel>
                        <Border Classes="panel" Padding="16">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.Save}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">Ctrl + S</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.SaveAs}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">Ctrl + Shift + S</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.Undo}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">Ctrl + Z</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.Redo}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">Ctrl + Y</TextBlock>
                                </Grid>
                                <Separator Background="{DynamicResource BorderColor}" Height="1" Margin="0,4"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.NewNode}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">Ctrl + N</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.DeleteNode}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">Delete</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.Rename}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">F2</TextBlock>
                                </Grid>
                                <Separator Background="{DynamicResource BorderColor}" Height="1" Margin="0,4"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.Build}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">Ctrl + B</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.PlayMode}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">F5</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.Fullscreen}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">F11</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.QuickSearch}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">Ctrl + F</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.OpenHub}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">Ctrl + H</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Classes="body" Text="{l:T Settings.Shortcut.Settings}"/>
                                    <TextBlock Grid.Column="1" Classes="fieldValue" Foreground="{DynamicResource Accent}" FontFamily="Consolas, Monospace">Ctrl + ,</TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="compact" Header="{l:T Settings.Tab.About}">
                <ScrollViewer Padding="24,20">
                    <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Classes="heading" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center">ROWL ENGINE</TextBlock>
                        <TextBlock Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" HorizontalAlignment="Center"
                                   Text="{l:T Settings.About.Tagline}"/>

                        <Border Classes="panel" Padding="20" MinWidth="400">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" Margin="0,0,12,0" Text="{l:T Settings.About.Version}"/>
                                    <TextBlock Grid.Column="1" Classes="body" Foreground="{DynamicResource PrimaryText}">v1.0.0</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" Margin="0,0,12,0" Text="{l:T Settings.About.Engine}"/>
                                    <TextBlock Grid.Column="1" Classes="body" Foreground="{DynamicResource PrimaryText}">SDL3 Hardware Canvas + C++ Core</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" Margin="0,0,12,0" Text="{l:T Settings.About.Editor}"/>
                                    <TextBlock Grid.Column="1" Classes="body" Foreground="{DynamicResource PrimaryText}">Avalonia UI (.NET) + Zero-Copy P/Invoke</TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" Margin="0,0,12,0" Text="{l:T Settings.About.Packaging}"/>
                                    <TextBlock Grid.Column="1" Classes="body" Foreground="{DynamicResource PrimaryText}" Text="{l:T Settings.About.Packaging.Value}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Classes="muted" FontSize="{DynamicResource FontSizeBodyLarge}" Margin="0,0,12,0" Text="{l:T Settings.About.Platforms}"/>
                                    <TextBlock Grid.Column="1" Classes="body" Foreground="{DynamicResource PrimaryText}">Windows  Linux  macOS  Android  iOS</TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="hint" Foreground="{DynamicResource DimText}" HorizontalAlignment="Center">© 2024–2026 Rowl Engine Team</TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Alt düğmeler -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Classes="ghost" Content="{l:T Settings.ResetDefaults}"
                        Command="{Binding ResetDefaultsCommand}"
                        Foreground="{DynamicResource MutedText}"/>
                <Button DockPanel.Dock="Right" Classes="primary" Content="{l:T Settings.Close}"
                        Name="CloseButton"
                        HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
