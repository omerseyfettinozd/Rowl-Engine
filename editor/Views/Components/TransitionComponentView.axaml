<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             x:Class="RowlEngine.Editor.Views.Components.TransitionComponentView"
             x:DataType="comp:TransitionComponentViewModel">
  <Border Classes="card" ClipToBounds="True" Margin="0,4">
    <StackPanel>
      <Border Background="{DynamicResource CardHeaderBackground}" Padding="8,6">
        <Grid ColumnDefinitions="*, Auto">
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" ToolTip.Tip="{l:T Common.Enable.Tip}" MinWidth="0" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"/>
            <ToggleButton Grid.Column="1" Classes="header" IsChecked="{Binding IsExpanded}" ToolTip.Tip="{l:T Common.ExpandCollapse.Tip}"
                          Background="Transparent" BorderThickness="0" Padding="4,2"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{l:T Component.Transition.Title}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </ToggleButton>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
            <Button Classes="compact" Content="{l:T Common.MoveUp}" Command="{Binding MoveUpCommand}" ToolTip.Tip="{l:T Common.MoveUp.Tip}"/>
            <Button Classes="compact" Content="{l:T Common.MoveDown}" Command="{Binding MoveDownCommand}" ToolTip.Tip="{l:T Common.MoveDown.Tip}"/>
            <ToggleButton Classes="compact" IsChecked="{Binding IsExpanded}" Content="{l:T Common.Settings}"/>
            <Button Classes="compact" Content="{l:T Common.Delete}" Command="{Binding RemoveSelfCommand}" ToolTip.Tip="{l:T Common.RemoveComponent.Tip}"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="8,6">

      <!-- Transition Kind -->
      <StackPanel Spacing="2">
        <TextBlock Text="{l:T Component.Transition.Kind}" Classes="body" />
        <ComboBox ItemsSource="{x:Static comp:TransitionComponentViewModel.AvailableKinds}"
                  SelectedItem="{Binding Kind}"
                  HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Duration and Color -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="{l:T Component.Transition.Duration}" Classes="body" />
          <NumericUpDown Value="{Binding Duration}" Increment="0.25" Minimum="0.01" Maximum="60.0" FormatString="F2" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{l:T Component.Transition.FadeColor}" Classes="body" />
          <TextBox Text="{Binding ColorHex}" Watermark="#000000" />
        </StackPanel>
      </Grid>

      <!-- Screen Flash FX -->
      <Separator Background="{DynamicResource BorderColor}" Height="1"/>
      <StackPanel Spacing="6">
        <CheckBox IsChecked="{Binding FlashEnabled}" Content="{l:T Component.Transition.Flash.Label}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding FlashEnabled}">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{l:T Component.Transition.ColorHex}" Classes="body" />
            <TextBox Text="{Binding FlashColorHex}" Watermark="{l:T Component.Transition.Flash.Watermark}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{l:T Component.Transition.Flash.Duration}" Classes="body" />
            <NumericUpDown Value="{Binding FlashDuration}" Increment="0.1" Minimum="0.01" Maximum="60.0" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="{l:T Component.Transition.Intensity}" Classes="body" />
            <NumericUpDown Value="{Binding FlashIntensity}" Increment="0.1" Minimum="0.0" Maximum="1.0" FormatString="F2" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- Color Tint & Vignette FX -->
      <Separator Background="{DynamicResource BorderColor}" Height="1"/>
      <StackPanel Spacing="6">
        <TextBlock Text="{l:T Component.Transition.Post.Label}" Classes="caption" FontWeight="SemiBold" />

        <!-- Tint -->
        <CheckBox IsChecked="{Binding TintEnabled}" Content="{l:T Component.Transition.Tint.Label}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource SecondaryText}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding TintEnabled}">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{l:T Component.Transition.Tint.Color}" Classes="body" />
            <TextBox Text="{Binding TintColorHex}" Watermark="{l:T Component.Transition.Tint.Watermark}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{l:T Component.Transition.Tint.Opacity}" Classes="body" />
            <NumericUpDown Value="{Binding TintOpacity}" Increment="0.05" Minimum="0.0" Maximum="1.0" FormatString="F2" />
          </StackPanel>
        </Grid>

        <!-- Vignette -->
        <CheckBox IsChecked="{Binding VignetteEnabled}" Content="{l:T Component.Transition.Vignette.Label}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource SecondaryText}" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding VignetteEnabled}">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{l:T Component.Transition.Intensity}" Classes="body" />
            <NumericUpDown Value="{Binding VignetteIntensity}" Increment="0.1" Minimum="0.0" Maximum="1.0" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{l:T Component.Transition.Vignette.Radius}" Classes="body" />
            <NumericUpDown Value="{Binding VignetteRadius}" Increment="0.05" Minimum="0.1" Maximum="1.0" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="{l:T Component.Transition.ColorHex}" Classes="body" />
            <TextBox Text="{Binding VignetteColorHex}" Watermark="#000000" />
          </StackPanel>
        </Grid>
      </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
