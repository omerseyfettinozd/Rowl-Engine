<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             mc:Ignorable="d"
             x:Class="RowlEngine.Editor.Views.Components.CharacterComponentView"
             x:DataType="comp:CharacterComponentViewModel">

    <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Margin="0,4" Padding="0" BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
        <StackPanel>
            <!-- Component Header -->
            <Border Background="{DynamicResource CardHeaderBackground}" CornerRadius="6,6,0,0" Padding="8,6">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="👤" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding IsEnabled}" ToolTip.Tip="Enable/Disable" MinWidth="0" Padding="0" Margin="0,0,2,0"/>
                        <Button Content="▲" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move Up" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
                        <Button Content="▼" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move Down" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
                        <ToggleButton IsChecked="{Binding IsExpanded}" Content="⚙️" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
                        <Button Content="🗑️" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="#EF4444" BorderThickness="0" ToolTip.Tip="Remove Component" Command="{Binding RemoveSelfCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Component Body -->
            <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="10,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Character Sprite Image (Sürükle Bırak / Drag &amp; Drop)" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    <Border x:Name="DropZoneBorder"
                            DragDrop.AllowDrop="True"
                            Background="{DynamicResource InputBackground}" 
                            BorderBrush="{DynamicResource BorderColor}" 
                            BorderThickness="1.5" 
                            CornerRadius="6" 
                            Padding="6">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" Text="{Binding Sprite}" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="📁 Browse..." 
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectImageForComponentCommand}"
                                        CommandParameter="{Binding}"
                                        Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource AccentButtonFg}" FontSize="11" Padding="8,4" CornerRadius="4"/>
                            </Grid>
                            <!-- Sprite Preview Thumbnail / Drop Area -->
                            <Border Background="{DynamicResource CardHeaderBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="4" MinHeight="65" MaxHeight="130">
                                <Panel>
                                    <Image Source="{Binding SpriteBitmap}" Stretch="Uniform" MaxHeight="120"
                                           IsVisible="{Binding SpriteBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2"
                                                IsVisible="{Binding SpriteBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                                        <TextBlock Text="👤 Sürükle Bırak / Drag Sprite Here" FontSize="11" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Text="Assets panelinden sürükleyin veya Browse'a tıklayın" FontSize="9" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" FontStyle="Italic"/>
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid ColumnDefinitions="*, *" Margin="0,2">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                        <TextBlock Text="X" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                        <NumericUpDown Value="{Binding X}" Minimum="-500" Maximum="2500" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                        <TextBlock Text="Y" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                        <NumericUpDown Value="{Binding Y}" Minimum="-500" Maximum="2500" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*, *" Margin="0,2">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                        <TextBlock Text="Width" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                        <NumericUpDown Value="{Binding Width}" Minimum="60" Maximum="2000" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                        <TextBlock Text="Height" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                        <NumericUpDown Value="{Binding Height}" Minimum="60" Maximum="2000" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*, *" Margin="0,2">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                        <TextBlock Text="🔍 Scale (1.0 = 100%)" FontSize="11" Foreground="{DynamicResource AccentColor}" FontWeight="Bold"/>
                        <NumericUpDown Value="{Binding Scale}" Minimum="0.05" Maximum="10.0" Increment="0.1" FormatString="0.00" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource AccentColor}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="↺" Command="{Binding ResetRotation}" ToolTip.Tip="Rotasyonu Sıfırla (0°)" Background="Transparent" Foreground="{DynamicResource MutedText}" FontSize="10" Padding="4,1" Margin="2,0,0,0" BorderThickness="0"/>
                            <TextBlock Text="🔄 Rotation" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <NumericUpDown Value="{Binding Rotation}" Minimum="-360" Maximum="360" Increment="5" FormatString="0.0°" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                </Grid>

                <CheckBox IsChecked="{Binding MaintainAspectRatio}" Content="🔒 En/Boy Oranını Koru (Aspect Ratio)" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,2"/>

                <!-- OBS Quick Assist Buttons -->
                <StackPanel Spacing="4" Margin="0,4,0,0">
                    <TextBlock Text="🧲 OBS Hızlı Hizalama (Assist)" FontSize="10" Foreground="{DynamicResource MutedText}" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*, *, *">
                        <Button Grid.Column="0" Content="🎯 Ortala" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CenterSelectedElementCommand}" 
                                ToolTip.Tip="Karakteri yatay olarak ekranda ortalar"
                                Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" FontSize="10" Padding="4,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,2,0" CornerRadius="4"/>
                        <Button Grid.Column="1" Content="⬇️ Zemine" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AlignCharacterToBottomCommand}" 
                                ToolTip.Tip="Karakteri alt zemin çizgisine oturtur"
                                Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" FontSize="10" Padding="4,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,2,0" CornerRadius="4"/>
                        <Button Grid.Column="2" Content="🔄 Sıfırla" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ResetCharacterSizeCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="Standart karakter boyutuna sıfırlar (600x900)"
                                Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" FontSize="10" Padding="4,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,0,0" CornerRadius="4"/>
                    </Grid>
                </StackPanel>

                <!-- Character Default Voice Blip Settings -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="🎵 KARAKTER SES TONU (VOICE BLIP)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="▶ Önizle" Command="{Binding PreviewVoiceBlipCommand}"
                                    ToolTip.Tip="Karakter ses tonunu test et"
                                    FontSize="10" Padding="6,2" Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource AccentButtonFg}" CornerRadius="4"/>
                        </Grid>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Varsayılan Ses Dosyası (.wav / .ogg - boşsa synth)" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                            <TextBox Text="{Binding VoiceBlipSound, Mode=TwoWay}" Watermark="Örn: voice_evelyn.wav veya boş"
                                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" FontSize="11"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,4,0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Base Pitch" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding VoiceBlipPitch, StringFormat='{}{0:F2}x'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                </Grid>
                                <Slider Value="{Binding VoiceBlipPitch}" Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2" Margin="4,0,0,0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Cadence" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding VoiceBlipCadence, StringFormat='{}Her {0}.'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                </Grid>
                                <Slider Value="{Binding VoiceBlipCadence}" Minimum="1" Maximum="5" SmallChange="1" LargeChange="1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
