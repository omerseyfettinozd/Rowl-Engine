<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:views="using:RowlEngine.Editor.Views"
             xmlns:controls="using:RowlEngine.Editor.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RowlEngine.Editor.Views.Panels.NodeGraphView"
             x:DataType="vm:MainWindowViewModel">
    <Grid x:Name="NodeGraphContainer" 
          Background="{DynamicResource GraphCanvasBg}" 
          ClipToBounds="True">
        <!-- Transformable Infinite Canvas Viewport (Unclipped 2D Infinite Coordinate Space) -->
        <Canvas x:Name="OuterCanvas" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Background="Transparent"
                ClipToBounds="False"
                RenderTransformOrigin="0,0">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                    <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Infinite Grid Visual Background Surface -->
            <Rectangle Width="400000" Height="400000" Canvas.Left="-200000" Canvas.Top="-200000" Fill="{DynamicResource GraphCanvasBg}"/>

            <!-- Group Frames Layer (Faz 4 Dilim 3, culled: visible rect only, behind wires) -->
            <ItemsControl ItemsSource="{Binding NodeGraphViewModel.VisibleGroups}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:CanvasGroupViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        <Setter Property="ClipToBounds" Value="False"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:CanvasGroupViewModel">
                        <Border Width="{Binding Width}" Height="{Binding Height}"
                                CornerRadius="8" BorderThickness="1.5"
                                BorderBrush="{Binding Color}" Background="Transparent">
                            <Grid RowDefinitions="28,*,16">
                                <!-- Header: drag moves the frame + its members; double-click reframes -->
                                <Border Tag="GroupHeader" Background="{Binding Color}" CornerRadius="6,6,0,0"
                                        Cursor="Hand" ToolTip.Tip="Sürükle: grupla taşı • Çift tık: üyelere sar">
                                    <DockPanel Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Tag="GroupDelete" DockPanel.Dock="Right" Text="×" FontSize="14"
                                                   FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                                                   Cursor="Hand" ToolTip.Tip="Grubu sil (düğümler kalır)"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                                <!-- Translucent body tint (hit-test off: clicks fall to canvas) -->
                                <Rectangle Grid.Row="1" Fill="{Binding Color}" Opacity="0.10" IsHitTestVisible="False"/>
                                <!-- Resize thumb -->
                                <Rectangle Grid.Row="2" Tag="GroupResize" Width="16" Height="14"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Fill="{Binding Color}" Opacity="0.7" RadiusX="3" RadiusY="3"
                                           Cursor="SizeNorthwestSoutheast" ToolTip.Tip="Yeniden boyutlandır"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Connection Wires Layer (culled: visible rect only) -->
            <ItemsControl ItemsSource="{Binding NodeGraphViewModel.VisibleConnections}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConnectionViewModel">
                        <controls:BezierWireRenderer StartPoint="{Binding StartPoint}" EndPoint="{Binding EndPoint}" WireBrush="{DynamicResource WireColor}" WireThickness="3.0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Active Drag Wire Layer -->
            <controls:BezierWireRenderer StartPoint="{Binding WireStartPoint}" EndPoint="{Binding WireEndPoint}" IsVisible="{Binding IsDraggingWire}" WireBrush="{DynamicResource AccentColor}" WireThickness="3.5"/>

            <!-- Node Cards Layer (culled: visible rect only) -->
            <ItemsControl ItemsSource="{Binding NodeGraphViewModel.VisibleNodes}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:NodeViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        <Setter Property="ClipToBounds" Value="False"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:NodeViewModel">
                        <views:NodeControl HostCanvas="{Binding #OuterCanvas}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Marquee Selection Box Layer -->
            <Rectangle Canvas.Left="{Binding SelectionBoxX}"
                       Canvas.Top="{Binding SelectionBoxY}"
                       Width="{Binding SelectionBoxWidth}"
                       Height="{Binding SelectionBoxHeight}"
                       IsVisible="{Binding IsSelectingBox}"
                       Fill="{DynamicResource Accent}"
                       Stroke="{DynamicResource Accent}"
                       StrokeThickness="1.5"
                       StrokeDashArray="4,2"/>
        </Canvas>

        <!-- Sahne başlık şeridi (Unity görünüm kontrolleri): zoom, sığdır, harita.
             Breadcrumb overlay'i (sol üst) ve minimap (sağ üst) yerinden oynamaz. -->
        <Border x:Name="SceneViewHeader" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="6" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Content="−" Command="{Binding ZoomOutViewCommand}"
                        ToolTip.Tip="Uzaklaştır" Padding="8,2" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}"
                        CornerRadius="4"/>
                <TextBlock Text="{Binding ZoomScale, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource SecondaryText}"
                           FontSize="11" VerticalAlignment="Center" MinWidth="42" TextAlignment="Center"
                           ToolTip.Tip="Yakınlaştırma"/>
                <Button Content="+" Command="{Binding ZoomInViewCommand}"
                        ToolTip.Tip="Yakınlaştır" Padding="8,2" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}"
                        CornerRadius="4"/>
                <Border Width="1" Height="20" Background="{DynamicResource BorderColor}" Margin="4,0"/>
                <Button Content="Sığdır" Command="{Binding NodeGraphViewModel.ZoomToFitCommand}"
                        Padding="8,2" FontSize="11" ToolTip.Tip="Tüm grafı ekrana sığdır"
                        Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}"
                        CornerRadius="4"/>
                <Button Content="Seçim" Command="{Binding NodeGraphViewModel.FitToSelectionCommand}"
                        Padding="8,2" FontSize="11" ToolTip.Tip="Seçili düğüme odaklan (F)"
                        Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}"
                        CornerRadius="4"/>
                <Border Width="1" Height="20" Background="{DynamicResource BorderColor}" Margin="4,0"/>
                <CheckBox Content="Harita" IsChecked="{Binding IsMinimapVisible, Mode=TwoWay}"
                          ToolTip.Tip="Minimap görünürlüğü" FontSize="11"
                          Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Minimap (bird's-eye, drag to pan) -->
        <Border x:Name="MinimapCard" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                IsVisible="{Binding IsMinimapVisible}"
                Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="6" Padding="6">
            <controls:MinimapControl x:Name="CanvasMinimap" Width="220" Height="150"
                                     Background="{DynamicResource GraphCanvasBg}"
                                     NodesSource="{Binding NodeGraphViewModel.Nodes}"
                                     GroupsSource="{Binding Groups.Groups}"
                                     WorldBounds="{Binding NodeGraphViewModel.WorldBounds}"
                                     ViewportRect="{Binding NodeGraphViewModel.ViewportRect}"/>
        </Border>

        <!-- Canvas Viewport Controls Overlay (yalnizca Reset (0,0) — zoom rozeti status barda) -->
        <Border x:Name="CanvasViewportOverlay" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,4">
            <Button x:Name="ResetViewButton" Content="Görünümü Sıfırla (0,0)" Command="{Binding ResetCanvasViewCommand}" Padding="6,2" FontSize="11" Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource AccentButtonFg}" CornerRadius="4"/>
        </Border>
    </Grid>
</UserControl>
