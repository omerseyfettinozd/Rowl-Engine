<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="700"
             x:Class="RowlEngine.Editor.Views.Panels.NodeInspectorView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="#181822">
        <Grid RowDefinitions="*">

            <ScrollViewer Grid.Row="0" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Node Title" FontSize="12" Foreground="#94A3B8"/>
                        <TextBox Text="{Binding SelectedNode.Title, FallbackValue='No Node Selected'}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Speaker Name" FontSize="12" Foreground="#94A3B8"/>
                        <TextBox Text="{Binding SelectedNode.Speaker, FallbackValue='Evelyn'}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Dialogue Content" FontSize="12" Foreground="#94A3B8"/>
                        <TextBox Text="{Binding SelectedNode.DialogueText, FallbackValue=''}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                    </StackPanel>

                    <!-- Background Layer Controls -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="🖼️ Background Layer" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        <ComboBox ItemsSource="{Binding AssetBrowserViewModel.AssetNames}" SelectedItem="{Binding SelectedNode.BackgroundTexture}" HorizontalAlignment="Stretch" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                        
                        <Grid ColumnDefinitions="*, *" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                <TextBlock Text="BG X" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.BackgroundX}" Minimum="-1000" Maximum="3000" Increment="20" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                <TextBlock Text="BG Y" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.BackgroundY}" Minimum="-1000" Maximum="3000" Increment="20" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*, *" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                <TextBlock Text="BG Width" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.BackgroundWidth}" Minimum="100" Maximum="4000" Increment="40" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                <TextBlock Text="BG Height" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.BackgroundHeight}" Minimum="100" Maximum="4000" Increment="40" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="🔍 Unity Scale / Ölçek (1.0 = %100, 0.5 = %50)" FontSize="11" Foreground="#38BDF8" FontWeight="Bold"/>
                            <NumericUpDown Value="{Binding SelectedNode.BackgroundScale}" Minimum="0.1" Maximum="5.0" Increment="0.1" FormatString="0.00" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#2563EB"/>
                        </StackPanel>
                        <Button Content="🖥️ Reset BG Fullscreen (1920x1080)" Command="{Binding ResetBackgroundDimensionsCommand}" HorizontalAlignment="Stretch" Padding="6,4" FontSize="11" Background="#1E293B" Foreground="#94A3B8" CornerRadius="4"/>
                    </StackPanel>

                    <!-- Character Sprite Controls -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="👤 Character Sprite &amp; Dimensions" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        <ComboBox ItemsSource="{Binding AssetBrowserViewModel.AssetNames}" SelectedItem="{Binding SelectedNode.CharacterSprite}" HorizontalAlignment="Stretch" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                        
                        <Grid ColumnDefinitions="*, *" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                <TextBlock Text="Char X" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.CharacterX}" Minimum="-500" Maximum="2500" Increment="20" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                <TextBlock Text="Char Y" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.CharacterY}" Minimum="-500" Maximum="2500" Increment="20" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*, *" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                <TextBlock Text="Char Width" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.CharacterWidth}" Minimum="60" Maximum="2000" Increment="20" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                <TextBlock Text="Char Height" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.CharacterHeight}" Minimum="60" Maximum="2000" Increment="20" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="🔍 Unity Scale / Ölçek (1.0 = %100, 0.5 = %50)" FontSize="11" Foreground="#38BDF8" FontWeight="Bold"/>
                            <NumericUpDown Value="{Binding SelectedNode.CharacterScale}" Minimum="0.1" Maximum="5.0" Increment="0.1" FormatString="0.00" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#2563EB"/>
                        </StackPanel>
                        <Button Content="📐 Reset Character Size (360x540)" Command="{Binding ResetCharacterDimensionsCommand}" HorizontalAlignment="Stretch" Padding="6,4" FontSize="11" Background="#1E293B" Foreground="#94A3B8" CornerRadius="4"/>
                    </StackPanel>

                    <!-- Dialogue Box / Speech Bubble Controls -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="💬 Dialogue Box / Speech Bubble" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        
                        <Grid ColumnDefinitions="*, *" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                <TextBlock Text="Box X" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.DialogueBoxX}" Minimum="-200" Maximum="2500" Increment="20" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                <TextBlock Text="Box Y" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.DialogueBoxY}" Minimum="-200" Maximum="2500" Increment="20" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*, *" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                <TextBlock Text="Box Width" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.DialogueBoxWidth}" Minimum="100" Maximum="1920" Increment="20" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                <TextBlock Text="Box Height" FontSize="11" Foreground="#94A3B8"/>
                                <NumericUpDown Value="{Binding SelectedNode.DialogueBoxHeight}" Minimum="100" Maximum="1080" Increment="20" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="🔍 Unity Scale / Ölçek (1.0 = %100, 0.5 = %50)" FontSize="11" Foreground="#38BDF8" FontWeight="Bold"/>
                            <NumericUpDown Value="{Binding SelectedNode.DialogueBoxScale}" Minimum="0.1" Maximum="5.0" Increment="0.1" FormatString="0.00" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#2563EB"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*, *" Margin="0,2">
                            <Button Grid.Column="0" Content="⬜ Kare (500x500)" Command="{Binding SetSquareDialogueBoxCommand}" HorizontalAlignment="Stretch" Margin="0,0,2,0" Padding="6,4" FontSize="11" Background="#2563EB" Foreground="White" CornerRadius="4"/>
                            <Button Grid.Column="1" Content="↕ Standard Banner" Command="{Binding SetStandardDialogueBoxCommand}" HorizontalAlignment="Stretch" Margin="2,0,0,0" Padding="6,4" FontSize="11" Background="#1E293B" Foreground="#94A3B8" CornerRadius="4"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Audio &amp; DSP Filter" FontSize="12" Foreground="#94A3B8"/>
                        <ComboBox SelectedItem="{Binding SelectedNode.DspFilter}" HorizontalAlignment="Stretch" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155">
                            <ComboBoxItem>Normal</ComboBoxItem>
                            <ComboBoxItem>Telephone</ComboBoxItem>
                            <ComboBoxItem>CaveReverb</ComboBoxItem>
                            <ComboBoxItem>UnderwaterLowPass</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <Button Content="Sync Selected Node to Engine" Command="{Binding PushHotReloadPacketCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Background="#2563EB" Foreground="White" FontWeight="Bold" CornerRadius="4" Padding="12,8"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
