<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             x:Class="RowlEngine.Editor.Views.Panels.BacklogView"
             x:DataType="vm:BacklogViewModel">
  <Border Background="{DynamicResource LogConsoleBg}" Padding="8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="{Binding speaker}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" />
              <TextBlock Text="{Binding dialogue}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Border>
</UserControl>
