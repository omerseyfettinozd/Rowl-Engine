<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="RowlEngine.Editor.Views.Panels.ProjectAssetsView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource PanelBackground}">
        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
            <!-- Araç çubuğu: 4 aksiyon (başlık sekmede; sıra + komutlar aynen). -->
            <Border Grid.Row="0" Classes="panelHeader">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center">
                        <Button Classes="ghost" Padding="8,4" Content="{l:T Assets.NewFolder}"
                                ToolTip.Tip="{l:T Assets.NewFolder.Tip}"
                                Command="{Binding AssetBrowserViewModel.CreateFolderCommand}"/>
                        <Button Classes="primary" Padding="10,4" Content="{l:T Assets.Import}"
                                ToolTip.Tip="{l:T Assets.Import.Tip}"
                                Command="{Binding ImportAssetCommand}"/>
                        <Button Classes="ghost" Padding="8,4" Content="{l:T Assets.Refresh}"
                                ToolTip.Tip="{l:T Assets.Refresh.Tip}"
                                Command="{Binding AssetBrowserViewModel.RefreshAssetsCommand}"/>
                        <!-- Unity kromu Dilim G1: ızgara/liste anahtarı -->
                        <Button Classes="ghost" Padding="8,4"
                                Content="{Binding AssetBrowserViewModel.AssetViewToggleText}"
                                ToolTip.Tip="{l:T Assets.ViewToggle.Tip}"
                                Command="{Binding AssetBrowserViewModel.ToggleAssetViewCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Konum satırı: üst klasör + yol çipi -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8,6,8,0">
                <Button Grid.Column="0" Classes="ghost" Padding="8,4"
                        Content="{l:T Assets.Up}"
                        ToolTip.Tip="{l:T Assets.Up.Tip}"
                        Command="{Binding AssetBrowserViewModel.GoToParentFolderCommand}"
                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}" Padding="8,0"
                        MinHeight="{DynamicResource ControlHeight}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AssetBrowserViewModel.SelectedFolder.RelativePath, FallbackValue=Assets}"
                               Classes="body" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding AssetBrowserViewModel.SelectedFolder.FullPath}"/>
                </Border>
            </Grid>

            <!-- Arama + tür filtresi -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="8,6,8,6">
                <TextBox Grid.Column="0" Watermark="{l:T Assets.Search.Watermark}"
                         Text="{Binding AssetBrowserViewModel.SearchText}"
                         MinHeight="{DynamicResource ControlHeight}"
                         CornerRadius="{DynamicResource RadiusSmall}"
                         FontSize="{DynamicResource FontSizeBody}" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AssetBrowserViewModel.AssetTypeFilters}"
                          SelectedItem="{Binding AssetBrowserViewModel.SelectedTypeFilter, Mode=TwoWay}"
                          MinHeight="{DynamicResource ControlHeight}"
                          CornerRadius="{DynamicResource RadiusSmall}"
                          FontSize="{DynamicResource FontSizeBody}" MinWidth="90"/>
            </Grid>

            <!-- Faz 6 Dilim 3: sol klasör ağacı + sağ simge ızgarası
                 (yol çipi üst araç çubuğunda). -->
            <Grid Grid.Row="3" ColumnDefinitions="220,6,*">
            <TreeView Grid.Column="0"
                      Background="Transparent"
                      ItemsSource="{Binding AssetBrowserViewModel.AssetTree}"
                      SelectedItem="{Binding AssetBrowserViewModel.SelectedNode, Mode=TwoWay}"
                      Margin="4"
                      Foreground="{DynamicResource PrimaryText}">
                <!-- Faz 4: tek context menü (öğe düzeyi; sağ-tık seçimi code-behind'de). -->
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:AssetNodeViewModel">
                        <!-- Faz 4: genişletme ViewModel'den gelir (yalnızca kök + filtre). -->
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                        <Setter Property="Padding" Value="2,2"/>
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:AssetNodeViewModel" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Background="Transparent"
                                    PointerPressed="OnAssetPointerPressed"
                                    PointerMoved="OnAssetPointerMoved"
                                    PointerReleased="OnAssetPointerReleased"
                                    DoubleTapped="OnAssetDoubleTapped">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:T Assets.Menu.NewFolder}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.CreateFolderCommand}"/>
                                    <MenuItem Header="{l:T Assets.Menu.Import}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportAssetCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{l:T Assets.Menu.Rename}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.StartRenameCommand}"/>
                                    <MenuItem Header="{l:T Assets.Menu.OpenInExplorer}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.OpenInExplorerCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{l:T Common.Delete}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.DeleteAssetCommand}"/>
                                    <MenuItem Header="{l:T Assets.Refresh}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.RefreshAssetsCommand}"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}"
                                   Width="28" Height="28" Stretch="UniformToFill" VerticalAlignment="Center"/>
                            <Border IsVisible="{Binding !HasThumbnail}"
                                    Background="{DynamicResource ToolbarButtonBg}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSmall}" Padding="4,1" MinWidth="40"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding TypeLabel}" Classes="fieldLabel"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="{Binding Name}"
                                       IsVisible="{Binding !IsEditing}"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="{DynamicResource FontSizeBodyLarge}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Name}"
                                       VerticalAlignment="Center"/>

                            <!-- Faz 4: kayıp-grup bilgi çipi (grup satırı seçilemez). -->
                            <Border IsVisible="{Binding IsMissingGroup}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSmall}" Padding="4,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{l:T Assets.Badge.Info}" Classes="fieldLabel" Foreground="{DynamicResource ErrorBrush}"/>
                            </Border>

                            <!-- MS-5: kayıp dosya rozeti (diskten silinen varlık) -->
                            <Border IsVisible="{Binding IsMissing}"
                                    Background="{DynamicResource ErrorSurface}" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{l:T Assets.Badge.Missing}" Classes="fieldValue" Foreground="{DynamicResource ErrorBrush}"/>
                            </Border>

                            <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                     IsVisible="{Binding IsEditing}"
                                     FontSize="{DynamicResource FontSizeBodyLarge}"
                                     Padding="4,2"
                                     Margin="0,-2,0,-2"
                                     MinHeight="22"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="{DynamicResource Accent}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}"/>
                                    <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Background="{DynamicResource BorderColor}"
                          ResizeDirection="Columns" Width="6"/>

            <!-- Sağ: simge ızgarası + taşınmış boş-durum panelleri -->
            <Grid Grid.Column="2" RowDefinitions="*,Auto">
                <ListBox x:Name="AssetGridListBox" Grid.Row="0" Background="Transparent"
                         ItemsSource="{Binding AssetBrowserViewModel.VisibleGridItems}"
                         SelectedItem="{Binding AssetBrowserViewModel.SelectedNode, Mode=TwoWay}"
                         SelectionMode="Single" Margin="4"
                         Foreground="{DynamicResource PrimaryText}"
                         IsVisible="{Binding AssetBrowserViewModel.IsGridView}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="CornerRadius" Value="0"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AssetBrowserViewModel.EnterSelectedFolderCommand}"/>
                    </ListBox.KeyBindings>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssetNodeViewModel">
                            <StackPanel Width="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.GridItemSize}"
                                        Background="Transparent" Spacing="2" Margin="4"
                                        PointerPressed="OnAssetPointerPressed"
                                        PointerMoved="OnAssetPointerMoved"
                                        PointerReleased="OnAssetPointerReleased"
                                        DoubleTapped="OnAssetDoubleTapped"
                                        ToolTip.Tip="{Binding Name}">
                                <!-- Faz 4 menüsüyle aynı 7 öğe (ızgara paritesi). -->
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T Assets.Menu.NewFolder}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.CreateFolderCommand}"/>
                                        <MenuItem Header="{l:T Assets.Menu.Import}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportAssetCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{l:T Assets.Menu.Rename}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.StartRenameCommand}"/>
                                        <MenuItem Header="{l:T Assets.Menu.OpenInExplorer}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.OpenInExplorerCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{l:T Common.Delete}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.DeleteAssetCommand}"/>
                                        <MenuItem Header="{l:T Assets.Refresh}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.RefreshAssetsCommand}"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Border Background="{DynamicResource ToolbarButtonBg}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}" Padding="6" HorizontalAlignment="Center"
                                        Width="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.GridItemImageSize}"
                                        Height="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.GridItemImageSize}">
                                    <Panel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}"
                                               Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TypeLabel}" IsVisible="{Binding !HasThumbnail}"
                                                   Classes="fieldLabel"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Panel>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="{DynamicResource FontSizeBody}" TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           TextAlignment="Center" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Unity kromu Dilim G1: kompakt liste görünümü. Aynı pencere
                     (VisibleGridItems) + aynı seçim otoritesi (SelectedNode);
                     yalnızca sunum farklıdır. -->
                <ListBox x:Name="AssetListListBox" Grid.Row="0" Background="Transparent"
                         ItemsSource="{Binding AssetBrowserViewModel.VisibleGridItems}"
                         SelectedItem="{Binding AssetBrowserViewModel.SelectedNode, Mode=TwoWay}"
                         SelectionMode="Single" Margin="4"
                         Foreground="{DynamicResource PrimaryText}"
                         IsVisible="{Binding !AssetBrowserViewModel.IsGridView}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AssetBrowserViewModel.EnterSelectedFolderCommand}"/>
                    </ListBox.KeyBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssetNodeViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,3"
                                  DoubleTapped="OnAssetDoubleTapped"
                                  ToolTip.Tip="{Binding Name}">
                                <!-- Faz 4 menüsüyle aynı 7 öğe (liste paritesi). -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T Assets.Menu.NewFolder}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.CreateFolderCommand}"/>
                                        <MenuItem Header="{l:T Assets.Menu.Import}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportAssetCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{l:T Assets.Menu.Rename}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.StartRenameCommand}"/>
                                        <MenuItem Header="{l:T Assets.Menu.OpenInExplorer}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.OpenInExplorerCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{l:T Common.Delete}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.DeleteAssetCommand}"/>
                                        <MenuItem Header="{l:T Assets.Refresh}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.RefreshAssetsCommand}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource ToolbarButtonBg}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}" Padding="4,1" MinWidth="40"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding TypeLabel}" Classes="fieldLabel"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="{DynamicResource FontSizeBodyLarge}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding RelativePath}"
                                           Classes="fieldLabel" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Faz 6: veri-penceresi — WrapPanel sanallaşmaz, o yüzden
                     ızgara dilim dilim çizilir (200'erlik adımlar). -->
                <Button Grid.Row="0" Content="{Binding AssetBrowserViewModel.GridItemsStatus}"
                        Command="{Binding AssetBrowserViewModel.ShowMoreGridItemsCommand}"
                        ToolTip.Tip="{l:T Assets.ShowMore.Tip}"
                        IsVisible="{Binding AssetBrowserViewModel.HasMoreGridItems}"
                        Classes="ghost" Background="{DynamicResource SurfaceBackground}"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <!-- Faz 5: boş-durum — dosyası yok (eylem: içe aktar) -->
            <StackPanel x:Name="AssetsEmptyPanel"
                        IsVisible="{Binding AssetBrowserViewModel.IsTreeEmpty}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" Margin="16">
                <TextBlock Text="{l:T Assets.Empty}" Classes="hint" FontStyle="Italic"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Classes="primary" Content="{l:T Assets.ImportFile}" Command="{Binding ImportAssetCommand}"
                        ToolTip.Tip="{l:T Assets.Import.Tip}"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Faz 5: boş-durum — filtre sonuç vermedi (eylem: temizle) -->
            <StackPanel x:Name="AssetsNoMatchPanel"
                        IsVisible="{Binding AssetBrowserViewModel.IsFilterNoMatch}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" Margin="16">
                <TextBlock Text="{l:T Assets.NoMatch}" Classes="hint" FontStyle="Italic"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Classes="primary" Content="{l:T Assets.ClearFilter}"
                        Command="{Binding AssetBrowserViewModel.ClearFilterCommand}"
                        ToolTip.Tip="{l:T Assets.ClearFilter.Tip}"
                        HorizontalAlignment="Center"/>
            </StackPanel>
            </Grid>
            </Grid>

            <!-- Faz 4: durum satırı + Faz 6 Dilim 3: ızgara boyut kaydırıcısı
                 (ince şerit: kaydırıcı yüksekliği kilitli). -->
            <Border Grid.Row="4" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                    Padding="8,4">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{l:T Assets.Size}" Classes="hint" VerticalAlignment="Center"/>
                        <Slider Minimum="40" Maximum="128"
                                Value="{Binding AssetBrowserViewModel.GridItemSize, Mode=TwoWay}"
                                ToolTip.Tip="{l:T Assets.Size.Tip}"
                                Width="110" Height="24" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AssetBrowserViewModel.StatusText}" Classes="hint"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
