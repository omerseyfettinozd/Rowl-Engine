<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             x:Class="RowlEngine.Editor.Views.NodeControl"
             x:DataType="vm:NodeViewModel">

    <Canvas Width="300" Height="{Binding NodeCardHeight}" Background="Transparent" ClipToBounds="False">
        <!-- Main Card Body -->
        <Border Canvas.Left="10" Canvas.Top="0" Width="240" Height="{Binding NodeCardHeight}"
                Background="{DynamicResource NodeCardBg}" BorderBrush="{Binding BorderColor}" BorderThickness="1.5" CornerRadius="12"
                BoxShadow="0 4 12 0 #30000000">
            <Grid RowDefinitions="36, *">
                <!-- Node Header (ComfyUI Style Header Bar) -->
                <Border Grid.Row="0" Background="{DynamicResource NodeHeaderBg}" CornerRadius="11,11,0,0" Padding="12,0">
                    <DockPanel VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Border IsVisible="{Binding IsStartNode}" Background="#10B981" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Right">
                            <TextBlock Text="▶ START" FontSize="9" Foreground="White" FontWeight="Black"/>
                        </Border>
                        <TextBlock Text="{Binding Id, StringFormat='#{0}'}" Foreground="{DynamicResource MutedText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- Node Body Content -->
                <Border Grid.Row="1" Padding="12,8">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="{DynamicResource AccentButtonBg}" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="{Binding Speaker}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#243D35" IsVisible="{Binding HasDialogueBox}" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="DİYALOG" FontSize="8" Foreground="#A7E3BE" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#26394A" IsVisible="{Binding HasChoices}" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="SEÇİM" FontSize="8" Foreground="#B7DCF5" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding BackgroundTexture}" FontSize="10" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DialogueText}" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxLines="2" LineHeight="15"/>
                        <TextBlock Text="{Binding ComponentSummary}" FontSize="9" Foreground="{DynamicResource DimText}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Left Input Handle (Green Pin Centered Exactly at X=0, Y=60) -->
        <Border Name="InputPinHandle" Canvas.Left="-5" Canvas.Top="45" Width="30" Height="30" Background="Transparent" Cursor="Hand" ToolTip.Tip="Flow Input Pin (Left Click: Drag Cable / Right Click: Disconnect)">
            <Ellipse Width="16" Height="16" Fill="#10B981" Stroke="#FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Default output remains for linear nodes. Choice nodes get one pin per option. -->
        <Border Name="OutputPinHandle" IsVisible="{Binding !HasChoices}" Canvas.Left="250" Canvas.Top="45" Width="30" Height="30" Background="Transparent" Cursor="Hand" ToolTip.Tip="Flow Output Pin">
            <Ellipse Width="16" Height="16" Fill="#10B981" Stroke="#FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <ItemsControl ItemsSource="{Binding ChoiceOptions}" Canvas.Left="245" Canvas.Top="45" ClipToBounds="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="0"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="comp:ChoiceOptionViewModel">
                    <Border Tag="{Binding OptionId}" Width="90" Height="30" Background="Transparent" Cursor="Hand" ToolTip.Tip="Choice output — drag to its target node">
                        <Grid ColumnDefinitions="*,24">
                            <TextBlock Text="{Binding Text}" FontSize="9" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                            <Ellipse Grid.Column="1" Width="16" Height="16" Fill="#38BDF8" Stroke="#FFFFFF" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Canvas>
</UserControl>
