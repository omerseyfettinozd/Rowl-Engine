<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:ctrl="using:RowlEngine.Editor.Controls"
             xmlns:p="using:RowlEngine.Editor.Views.Panels"
             x:Class="RowlEngine.Editor.Views.Components.ChoiceComponentView"
             x:DataType="comp:ChoiceComponentViewModel">
  <Border Background="{DynamicResource CardBackground}" CornerRadius="2" Margin="0,4" Padding="0" BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
    <StackPanel>
      <Border Background="{DynamicResource CardHeaderBackground}" CornerRadius="2,2,0,0" Padding="8,6">
        <Grid ColumnDefinitions="*,Auto">
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" ToolTip.Tip="Enable/Disable" MinWidth="0" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"/>
            <ToggleButton Grid.Column="1" IsChecked="{Binding IsExpanded}" ToolTip.Tip="Genişlet/Daralt"
                          Background="Transparent" BorderThickness="0" Padding="4,2"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="Oyuncu Seçimleri" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </ToggleButton>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
            <Button Content="Yukarı" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move Up" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
            <Button Content="Aşağı" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move Down" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
            <ToggleButton IsChecked="{Binding IsExpanded}" Content="Ayar" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
            <Button Content="Sil" Command="{Binding RemoveSelfCommand}" ToolTip.Tip="Remove Component" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource ErrorColor}" BorderThickness="0"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="8,6">
      <TextBox Watermark="Seçim başlığı" Text="{Binding Title}"/>
      <ItemsControl ItemsSource="{Binding Options}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="comp:ChoiceOptionViewModel">
            <Border Padding="8" Margin="0,2" BorderBrush="{Binding BorderColor}" Background="{Binding BackgroundColor}" BorderThickness="1" CornerRadius="{Binding CornerRadius, Converter={x:Static p:DoubleToBoxConverter.Instance}}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Watermark="Düğme metni" Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding TextColor}"/>
                  <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" ToolTip.Tip="Enable this button"/>
                  <ToggleButton Grid.Column="2" Content="Ayar" IsChecked="{Binding IsExpanded}" ToolTip.Tip="Button appearance"/>
                </Grid>
                <StackPanel IsVisible="{Binding IsExpanded}" Spacing="6">
                  <Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Watermark="Condition (e.g. affinity_evelyn &gt;= 3)" Text="{Binding Condition}" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="Graph cable sets target" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Kaldır" Command="{Binding $parent[UserControl].DataContext.RemoveOptionCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="{DynamicResource ErrorColor}"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                    <TextBlock Text="Hazır Stil" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding StylePreset}">
                      <x:String>Neon</x:String><x:String>Minimal</x:String><x:String>Paper</x:String><x:String>Danger</x:String>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="Yazı Tipi" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                    <TextBox Grid.Column="3" Text="{Binding FontSize}" Width="56"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8">
                    <TextBlock Text="X" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedText}"/><TextBox Grid.Column="1" Text="{Binding X}" Width="58"/>
                    <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedText}"/><TextBox Grid.Column="3" Text="{Binding Y}" Width="58"/>
                    <TextBlock Grid.Column="4" Text="Opacity" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedText}"/><TextBox Grid.Column="5" Text="{Binding Opacity}" Width="58"/>
                  </Grid>
                  <Border Tag="Font" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAssetDragOver" DragDrop.Drop="OnAssetDrop"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="3">
                    <TextBox Watermark="Font: Assets panelinden .ttf/.otf sürükle" Text="{Binding FontFamily}" BorderThickness="0"/>
                  </Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <TextBox Watermark="Text #RRGGBB" Text="{Binding TextColor}"/>
                    <TextBox Grid.Column="1" Watermark="Background #RRGGBB" Text="{Binding BackgroundColor}"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <TextBox Watermark="Hover #RRGGBB" Text="{Binding HoverColor}"/>
                    <TextBox Grid.Column="1" Watermark="Border #RRGGBB" Text="{Binding BorderColor}"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8">
                    <TextBlock Text="W" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedText}"/><TextBox Grid.Column="1" Text="{Binding Width}" Width="54"/>
                    <TextBlock Grid.Column="2" Text="H" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedText}"/><TextBox Grid.Column="3" Text="{Binding Height}" Width="54"/>
                    <TextBlock Grid.Column="4" Text="Radius" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedText}"/><TextBox Grid.Column="5" Text="{Binding CornerRadius}" Width="54"/>
                  </Grid>
                  <TextBlock Text="Buton görselleri — Assets panelinden ilgili alana sürükle bırak"
                             FontSize="10" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                  <Border Tag="Normal" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAssetDragOver" DragDrop.Drop="OnAssetDrop"
                          BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="4" Padding="3">
                    <TextBox Watermark="Normal görseli buraya bırak" Text="{Binding NormalImage}" BorderThickness="0"/>
                  </Border>
                  <Border Tag="Hover" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAssetDragOver" DragDrop.Drop="OnAssetDrop"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="3">
                    <TextBox Watermark="Hover görselini buraya bırak" Text="{Binding HoverImage}" BorderThickness="0"/>
                  </Border>
                  <Border Tag="Pressed" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAssetDragOver" DragDrop.Drop="OnAssetDrop"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="3">
                    <TextBox Watermark="Pressed görselini buraya bırak" Text="{Binding PressedImage}" BorderThickness="0"/>
                  </Border>
                  <Border Tag="Disabled" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAssetDragOver" DragDrop.Drop="OnAssetDrop"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="3">
                    <TextBox Watermark="Disabled görselini buraya bırak" Text="{Binding DisabledImage}" BorderThickness="0"/>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                         NodeId="{Binding Node.Id}" FieldKey="choice.option_target" />
      <Button Content="+ Seçim ekle" Command="{Binding AddOptionCommand}" HorizontalAlignment="Left"/>
      <!-- Boş-durum: seçeneksiz Choice (butonsuz ipucu) -->
      <TextBlock Text="Henüz seçenek yok — + Seçim ekle'ye bas, hedefi graf kablosuyla ver."
                 IsVisible="{Binding HasNoOptions}"
                 TextWrapping="Wrap" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource MutedText}"/>
      <TextBlock Text="Her seçeneğin sabit bir kimliği ve hedef düğümü vardır; hedefi graf kablosuyla ver." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource MutedText}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
