<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RowlEngine.Editor.ViewModels"
        xmlns:views="using:RowlEngine.Editor.Views"
        xmlns:panels="using:RowlEngine.Editor.Views.Panels"
        xmlns:search="using:RowlEngine.Editor.Services.Search"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:l="using:RowlEngine.Editor.Services.Strings"
        xmlns:ws="using:RowlEngine.Editor.Views.Workspace"
        xmlns:wsm="using:RowlEngine.Editor.Services.Workspace"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="RowlEngine.Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        FlowDirection="{l:Direction}"
        Title="{l:T App.Window.Title}"
        Width="1600" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <!-- KARAR-0 eşleme (Dilim-1, markup-only, davranış değişikliği yok):
         AppBackground, PrimaryText ve Accent dinamik tema token'larıdır;
         sayısal değerler ThemeStyles.axaml tanımlarından gelir. Soğuk palet
         bu dosyada gömülü değildir — çözümleme editor/Styles/ThemeStyles.axaml
         üzerinden yapılır. -->

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Üst çubuk: 56 px, AppBackground, markasız ortalanmış kapsül -->
        <Border Grid.Row="0" Background="{DynamicResource AppBackground}" Height="56" Padding="0,4">
            <Grid ColumnDefinitions="*,Auto,*">
                <!-- Kapsül (prototip .view-switcher): görünümler | taşıma | Araçlar · Diğer -->
                <Border x:Name="TopCapsule" Grid.Column="1"
                        Background="{DynamicResource ToolbarButtonBg}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="14" Padding="2"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <!-- Görünüm düğmeleri: simge + etkin noktası -->
                        <StackPanel x:Name="CenterViewTabs" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="capsule" Classes.active="{Binding IsNodeGraphActive}" Command="{Binding ShowPanelCommand}" CommandParameter="NodeGraph"
                                    ToolTip.Tip="{l:T View.Node.Tip}">
                                <Grid Width="32" Height="32">
                                    <Path Data="M4,4 h6 v6 h-6 Z M14,14 h6 v6 h-6 Z M10,7 h3 a2,2 0 0 1 2,2 v5"
                                          Width="18" Height="18" Stretch="Uniform"
                                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" Stroke="{Binding $parent[Button].Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="3" Height="3" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{Binding SceneTabBrush}"/>
                                </Grid>
                            </Button>
                            <Button Classes="capsule" Classes.active="{Binding IsEnginePreviewActive}" Command="{Binding ShowPanelCommand}" CommandParameter="EnginePreview"
                                    ToolTip.Tip="{l:T View.Game.Tip}">
                                <Grid Width="32" Height="32">
                                    <Path Data="M3,5 h18 v12 h-18 Z M8,21 h8 M10,8.5 L15,11 L10,13.5 Z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" Stroke="{Binding $parent[Button].Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="3" Height="3" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{Binding GameTabBrush}"/>
                                </Grid>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T Menu.OpenInSeparateWindow}" Command="{Binding OpenPlayerWindowCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Classes="capsule" Classes.active="{Binding IsPreviewActive}" Command="{Binding ShowPanelCommand}" CommandParameter="Preview"
                                    ToolTip.Tip="{l:T View.SceneEdit.Tip}">
                                <Grid Width="32" Height="32">
                                    <Path Data="M4,4 h4 M4,4 v4 M20,4 h-4 M20,4 v4 M4,20 v-4 M4,20 h4 M11,11 L19,14 L15.5,15.5 L14,19 Z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" Stroke="{Binding $parent[Button].Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="3" Height="3" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{Binding PreviewTabBrush}"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border Classes="capsuleDivider"/>

                        <!-- Taşıma kümesi (Oynat/Duraklat/Adım). Glifler bizim çizimimiz. -->
                        <StackPanel x:Name="TransportCluster" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="capsuleIcon" Command="{Binding TogglePlayStandaloneCommand}"
                                    ToolTip.Tip="{l:T Transport.Play}"
                                    Background="{Binding PlayButtonColor}">
                                <Path Data="M3,2 L11,7 L3,12 Z" Fill="{DynamicResource PrimaryText}"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button Classes="capsuleIcon" Command="{Binding PauseStandaloneCommand}"
                                    IsEnabled="{Binding CanPauseStandalone}"
                                    ToolTip.Tip="{l:T Transport.Pause}">
                                <Path Data="M3,2 H5.5 V12 H3 Z M8.5,2 H11 V12 H8.5 Z" Fill="{DynamicResource PrimaryText}"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button Classes="capsuleIcon" Command="{Binding StepStandaloneCommand}"
                                    IsEnabled="{Binding CanStepStandalone}"
                                    ToolTip.Tip="{l:T Transport.Step}">
                                <Path Data="M2,2 L8,7 L2,12 Z M9.5,2 H11.5 V12 H9.5 Z" Fill="{DynamicResource PrimaryText}"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <Border Classes="capsuleDivider"/>

                        <!-- Araçlar + Diğer: simge başlık, kart açılır -->
                        <Menu Background="Transparent" VerticalAlignment="Center" Padding="0" Margin="0">
                            <MenuItem x:Name="WindowsMenu" Classes="capsuleMenu toolsMenu" ToolTip.Tip="{l:T Menu.Windows}">
                                <MenuItem.Header>
                                    <Path Data="M4,4 h6 v6 h-6 Z M14,4 h6 v6 h-6 Z M4,14 h6 v6 h-6 Z M17,14 v6 M14,17 h6"
                                          Width="18" Height="18" Stretch="Uniform"
                                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" Stroke="{Binding $parent[MenuItem].Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </MenuItem.Header>
                                <MenuItem.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </MenuItem.ItemsPanel>
                                <MenuItem Classes="toolCard" Header="{l:T Panel.Hierarchy}" InputGesture="Ctrl+1" Command="{Binding ShowPanelCommand}" CommandParameter="Hierarchy">
                                    <MenuItem.Icon>
                                        <Path Data="M6,4 h3 v3 h-3 Z M6,17 h3 v3 h-3 Z M15,10.5 h3 v3 h-3 Z M9,5.5 h2.5 a2,2 0 0 1 2,2 V9 M9,18.5 h2.5 a2,2 0 0 0 2,-2 V15"
                                              Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" Stroke="{DynamicResource ToolCardIcon}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Classes="toolCard" Header="{l:T Panel.Inspector}" InputGesture="Ctrl+2" Command="{Binding ShowPanelCommand}" CommandParameter="Inspector">
                                    <MenuItem.Icon>
                                        <Path Data="M4,7 h16 M4,17 h16 M14,5 v4 M8,15 v4"
                                              Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" Stroke="{DynamicResource ToolCardIcon}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Classes="toolCard" Header="{l:T Panel.Log}" InputGesture="Ctrl+3" Command="{Binding ShowPanelCommand}" CommandParameter="Log">
                                    <MenuItem.Icon>
                                        <Path Data="M4,5 h16 v14 h-16 Z M7,10 L10,12 L7,14 M12.5,14 H17"
                                              Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" Stroke="{DynamicResource ToolCardIcon}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Classes="toolCard" Header="{l:T Panel.Assets}" InputGesture="Ctrl+4" Command="{Binding ShowPanelCommand}" CommandParameter="Assets">
                                    <MenuItem.Icon>
                                        <Path Data="M3,8 a1,1 0 0 1 1,-1 h5 l2,2 h6 a1,1 0 0 1 1,1 v8 a1,1 0 0 1 -1,1 H4 a1,1 0 0 1 -1,-1 Z"
                                              Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" Stroke="{DynamicResource ToolCardIcon}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Classes="toolCard" Header="{l:T Panel.Backlog}" InputGesture="Ctrl+5" Command="{Binding ShowPanelCommand}" CommandParameter="Backlog">
                                    <MenuItem.Icon>
                                        <Path Data="M9,6 h11 M9,12 h11 M9,18 h11 M5,6 h.01 M5,12 h.01 M5,18 h.01"
                                              Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" Stroke="{DynamicResource ToolCardIcon}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Classes="toolCard" Header="{l:T Panel.SaveSlots}" InputGesture="Ctrl+6" Command="{Binding ShowPanelCommand}" CommandParameter="SaveSlots">
                                    <MenuItem.Icon>
                                        <Path Data="M5,4 h10 l4,4 v12 h-14 Z M8,4 v5 h7 V4 M8,20 v-6 h8 v6"
                                              Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" Stroke="{DynamicResource ToolCardIcon}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Classes="toolCard" Header="{l:T Panel.Issues}" InputGesture="Ctrl+7" Command="{Binding ShowPanelCommand}" CommandParameter="ProjectIssues">
                                    <MenuItem.Icon>
                                        <Path Data="M12,4 L21,20 H3 Z M12,10 v4.5 M12,17.5 h.01"
                                              Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" Stroke="{DynamicResource ToolCardIcon}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem x:Name="MoreMenu" Classes="capsuleMenu moreMenu" ToolTip.Tip="{l:T Menu.More}">
                                <MenuItem.Header>
                                    <Path Data="M4.5,12 a1.5,1.5 0 1 0 3,0 a1.5,1.5 0 1 0 -3,0 Z M10.5,12 a1.5,1.5 0 1 0 3,0 a1.5,1.5 0 1 0 -3,0 Z M16.5,12 a1.5,1.5 0 1 0 3,0 a1.5,1.5 0 1 0 -3,0 Z"
                                          Width="15" Height="3" Stretch="Uniform"
                                          Fill="{Binding $parent[MenuItem].Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </MenuItem.Header>
                                <MenuItem x:Name="ProjectsMenu" Header="{l:T Menu.Projects}">
                                    <MenuItem Header="{l:T Menu.ProjectList}" Command="{Binding OpenProjectHubCommand}"/>
                                    <MenuItem Header="{l:T Menu.LocalizationDesk}" Command="{Binding OpenLocalizationDeskCommand}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{l:T Menu.Save}" InputGesture="Ctrl+S" Command="{Binding SaveProjectCommand}"/>
                                <MenuItem Header="{l:T Menu.Undo}" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" IsEnabled="{Binding UndoRedo.CanUndo}"/>
                                <MenuItem Header="{l:T Menu.Redo}" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}" IsEnabled="{Binding UndoRedo.CanRedo}"/>
                                <Separator/>
                                <MenuItem Header="{l:T Menu.Export}" ToolTip.Tip="{Binding BuildButtonTooltip}"
                                          Command="{Binding BuildGameCommand}" IsEnabled="{Binding !IsBuilding}"/>
                                <MenuItem Header="{l:T Menu.CancelBuild}" Command="{Binding CancelBuildCommand}" IsVisible="{Binding IsBuilding}"/>
                                <Separator/>
                                <MenuItem x:Name="LayoutMenu" Header="{l:T Menu.Layout}">
                                    <MenuItem Header="{l:T Layout.Default}" Command="{Binding SelectLayoutPresetCommand}" CommandParameter="Varsayılan"/>
                                    <MenuItem Header="{l:T Layout.SceneFocus}" Command="{Binding SelectLayoutPresetCommand}" CommandParameter="Sahne Odağı"/>
                                    <MenuItem Header="{l:T Layout.PlayTest}" Command="{Binding SelectLayoutPresetCommand}" CommandParameter="Oyun Testi"/>
                                </MenuItem>
                                <MenuItem Header="{Binding SplitScreenButtonText}" Command="{Binding ShowPanelCommand}" CommandParameter="SplitScreen"/>
                                <Separator/>
                                <MenuItem Header="{l:T Menu.Settings}" InputGesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
                            </MenuItem>
                        </Menu>

                        <!-- Kaydedilmemiş değişiklik noktası (prototip: kapsülde nokta) -->
                        <Ellipse x:Name="UnsavedDot" Width="6" Height="6" Margin="2,0,6,0"
                                 Fill="{DynamicResource Accent}" VerticalAlignment="Center"
                                 IsVisible="{Binding IsProjectDirty}"
                                 ToolTip.Tip="{l:T Status.Unsaved}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE (Faz 5 D3): yerleşim ağacı (VM.WorkspaceLayout) WorkspaceHost ile
             çizilir. Her panel burada BİR KEZ bildirilir; host yalnız konumlar / gizler
             (yeniden yaratmaz, yeniden ebeveynlemez). Bölücü sürüklemesi oranı ağaca
             yazar (MainWindow.axaml.cs → ResizeWorkspaceSplit). Başlık kuralı: içerik
             kendi başlığını çiziyorsa OwnsHeader (Hiyerarşi, Denetçi, alt şerit sekmeleri),
             yoksa host Border.panelHeader çizer. Faz 5 D4: başlıktan sürükle-bırak, sabitle,
             kapat ve panel menüsü host'ta; istekler code-behind'dan VM ağaç işlemlerine gider. -->
        <Grid Grid.Row="1" Margin="6,0,6,6">
            <ws:WorkspaceHost x:Name="WorkspaceHost"
                              Layout="{Binding WorkspaceLayout}"
                              PinnedPanels="{Binding WorkspacePinnedPanels}"
                              ReduceMotion="{Binding Settings.ReduceMotion}">

                <ws:WorkspacePanel PanelId="{x:Static wsm:PanelIds.Hierarchy}" OwnsHeader="True" HeaderActionsInContent="True"
                                   Title="{l:T Panel.Hierarchy}"
                                   PanelMinWidth="{x:Static ws:WorkspacePanelMetrics.HierarchyMinWidth}" Background="{DynamicResource PanelBackground}">
                    <panels:NodeHierarchyView/>
                </ws:WorkspacePanel>

                <ws:WorkspacePanel PanelId="{x:Static wsm:PanelIds.Node}" Title="{l:T View.Node}"
                                   PanelMinWidth="{x:Static ws:WorkspacePanelMetrics.CenterMinWidth}"
                                   PanelMinHeight="{x:Static ws:WorkspacePanelMetrics.CenterMinHeight}"
                                   Background="{DynamicResource CanvasBackground}">
                    <Grid ClipToBounds="True">
                        <panels:NodeGraphView/>

                        <!-- BREADCRUMB + CHAPTER SCOPE (Faz 4 Dilim 3) -->
                        <Border x:Name="BreadcrumbPanel" Classes="floating" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="12,12,0,0" ZIndex="90" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Subgraphs.Crumbs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="/" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                                                <Button Tag="CrumbNav" Content="{Binding Title}" Padding="6,2" FontSize="11"
                                                        ToolTip.Tip="{l:T Graph.Crumb.Tip}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Width="1" Height="14" Background="{DynamicResource BorderColor}"/>
                                <TextBlock Text="{l:T Graph.Chapter}" Classes="muted" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Subgraphs.AvailableChapterOptions}"
                                          SelectedItem="{Binding Subgraphs.ChapterFilterOption}"
                                          FontSize="11" MinWidth="110" ToolTip.Tip="{l:T Graph.Chapter.Tip}"/>
                            </StackPanel>
                        </Border>

                        <!-- FAZ 3 (K4): Node paneli araç çubuğu — düğüm komutları üst çubuktan
                             buraya taşındı; yalnız düğüm grafiği açıkken görünür. -->
                        <Border x:Name="NodeToolbarPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Classes="floating" Margin="12,58,0,0" ZIndex="90" IsVisible="{Binding IsNodeGraphActive}">
                            <StackPanel x:Name="NodeToolbar" Orientation="Horizontal" Spacing="4">
                                <Button Classes="tool" Content="{l:T Node.Add}" ToolTip.Tip="{l:T Node.Add.Tip}" Command="{Binding AddNodeCommand}"/>
                                <Button Classes="tool" Content="{l:T Node.Disconnect}" ToolTip.Tip="{l:T Node.Disconnect.Tip}" Command="{Binding DisconnectSelectedNodeCablesCommand}"/>
                                <Button Classes="tool" Content="{l:T Node.Delete}" ToolTip.Tip="{l:T Node.Delete.Tip}" Command="{Binding DeleteSelectedNodeCommand}"/>
                                <Border Classes="capsuleDivider"/>
                                <Button Classes="tool" Content="{l:T Node.Group}" ToolTip.Tip="{l:T Node.Group.Tip}" Command="{Binding CreateGroupFromSelectionCommand}"/>
                                <Button Classes="tool" Content="{l:T Node.Up}" ToolTip.Tip="{l:T Node.Up.Tip}" Command="{Binding ExitSubgraphCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ws:WorkspacePanel>

                <ws:WorkspacePanel PanelId="{x:Static wsm:PanelIds.Edit}" Title="{l:T View.SceneEdit}"
                                   PanelMinWidth="{x:Static ws:WorkspacePanelMetrics.CenterMinWidth}"
                                   PanelMinHeight="{x:Static ws:WorkspacePanelMetrics.CenterMinHeight}"
                                   Background="{DynamicResource CanvasBackground}">
                    <views:LivePreviewControl/>
                </ws:WorkspacePanel>

                <ws:WorkspacePanel PanelId="{x:Static wsm:PanelIds.Game}" Title="{l:T View.Game}"
                                   PanelMinWidth="{x:Static ws:WorkspacePanelMetrics.CenterMinWidth}"
                                   PanelMinHeight="{x:Static ws:WorkspacePanelMetrics.CenterMinHeight}"
                                   Background="{DynamicResource CanvasBackground}">
                    <views:EnginePreviewControl/>
                </ws:WorkspacePanel>

                <!-- Alt şerit: Varlıklar + Günlük + diğerleri tek sekmeli yaprak
                     (Unity alt panel düzeni); sekme satırı yaprağın başlığıdır. -->
                <ws:WorkspacePanel PanelId="{x:Static wsm:PanelIds.Bottom}" OwnsHeader="True"
                                   Title="{l:T Workspace.Panel.Bottom}"
                                   PanelMinHeight="{x:Static ws:WorkspacePanelMetrics.BottomMinHeight}" Background="{DynamicResource PanelBackground}">
                    <TabControl SelectedIndex="{Binding BottomPanelActiveTab}"
                                Background="{DynamicResource PanelBackground}">
                        <TabItem Classes="compact" Header="{l:T Panel.Assets}" IsVisible="{Binding IsAssetsPanelVisible}">
                            <panels:ProjectAssetsView/>
                        </TabItem>
                        <TabItem Classes="compact" Header="{l:T Panel.Log}" IsVisible="{Binding IsLogPanelVisible}">
                            <panels:OutputLogView/>
                        </TabItem>
                        <TabItem Classes="compact" Header="{l:T Panel.Backlog}" IsVisible="{Binding IsBacklogPanelVisible}">
                            <panels:BacklogView DataContext="{Binding BacklogViewModel}"/>
                        </TabItem>
                        <TabItem Classes="compact" Header="{l:T Panel.SaveSlots}" IsVisible="{Binding IsSaveSlotsPanelVisible}">
                            <panels:SaveSlotsView DataContext="{Binding SaveSlotsViewModel}"/>
                        </TabItem>
                        <TabItem Classes="compact" Header="{l:T Panel.Issues}" IsVisible="{Binding IsProjectIssuesPanelVisible}">
                            <panels:ProjectIssuesView DataContext="{Binding ProjectIssuesViewModel}"/>
                        </TabItem>
                    </TabControl>
                </ws:WorkspacePanel>

                <ws:WorkspacePanel PanelId="{x:Static wsm:PanelIds.Inspector}" OwnsHeader="True" HeaderActionsInContent="True"
                                   Title="{l:T Panel.Inspector}"
                                   PanelMinWidth="{x:Static ws:WorkspacePanelMetrics.InspectorMinWidth}" Background="{DynamicResource PanelBackground}">
                    <panels:NodeInspectorView/>
                </ws:WorkspacePanel>
            </ws:WorkspaceHost>

            <!-- GLOBAL SEARCH OVERLAY (Faz 4 Dilim 2) -->
            <Border x:Name="SearchOverlayPanel" IsVisible="{Binding IsSearchVisible}"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,12,0,0" ZIndex="100"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                    CornerRadius="8" Padding="10" Width="520"
                    BoxShadow="0 8 24 0 #40000000">
                <StackPanel Spacing="8">
                    <TextBox Text="{Binding SearchQuery}"
                             Watermark="{l:T Search.Overlay.Watermark}"
                             Background="{DynamicResource InputBackground}"
                             Foreground="{DynamicResource PrimaryText}"
                             BorderThickness="0" Padding="12,8" FontSize="14"/>
                    <!-- Filtre çubuğu: tür / konuşmacı / renk etiketi -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="{l:T Search.Filter.Kind}" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Search.AvailableNodeKinds}" SelectedItem="{Binding Search.SelectedNodeKind}" FontSize="11" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="{l:T Search.Filter.Speaker}" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding Search.AvailableSpeakers}" SelectedItem="{Binding Search.SelectedSpeaker}" FontSize="11" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="4" Text="{l:T Search.Filter.Color}" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="5" ItemsSource="{Binding Search.AvailableColorTags}" SelectedItem="{Binding Search.SelectedColorTag}" FontSize="11"/>
                    </Grid>
                    <!-- Sonuç listesi: başlık + alan rozeti + metin kesiti -->
                    <ListBox ItemsSource="{Binding Search.Results}"
                             SelectedItem="{Binding Search.SelectedResult}"
                             MaxHeight="300"
                             Background="{DynamicResource InputBackground}"
                             BorderThickness="0" CornerRadius="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="search:NodeSearchHit">
                                <StackPanel Spacing="2" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding NodeTitle}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="12"/>
                                        <TextBlock Text="{Binding NodeId, StringFormat='#{0}'}" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource AccentButtonBg}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FieldLabel}" FontSize="9" Foreground="{DynamicResource AccentButtonFg}" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxLines="2"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Search.StatusText}"
                               Foreground="{DynamicResource MutedText}" FontSize="11"
                               HorizontalAlignment="Right" IsVisible="{Binding Search.StatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATUS BAR (Alt Durum Çubuğu) -->
        <Border x:Name="StatusBarPanel" Grid.Row="2" Background="{DynamicResource StatusBarBg}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="12,4" Height="28">
            <DockPanel>
                <!-- Sağ: Build Hedefi + Zoom -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="StatusZoomText" Text="{Binding ZoomScale, StringFormat='{}{0:P0}'}"
                               Foreground="{DynamicResource DimText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border Width="1" Height="14" Background="{DynamicResource BorderColor}"/>
                    <TextBlock x:Name="StatusBuildTargetText" Text="{Binding CurrentBuildTarget, StringFormat='{}{0}'}"
                               Foreground="{DynamicResource DimText}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Sol: Status Text -->
                <TextBlock x:Name="StatusMessageText" Text="{Binding StatusText}"
                           Foreground="{DynamicResource MutedText}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- TOAST NOTIFICATION OVERLAY (Sağ Alt) -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,40" ZIndex="200" Spacing="8">
            <Border x:Name="ToastPanel" IsVisible="{Binding Toast.IsVisible}"
                    Background="{Binding Toast.ToastBackground}"
                    CornerRadius="8" Padding="16,10"
                    MinWidth="260" MaxWidth="420"
                    BoxShadow="0 4 16 0 #50000000">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Toast.ToastIcon}" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Toast.Message}"
                               Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Window>
