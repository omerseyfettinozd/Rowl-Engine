<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="RowlEngine.Editor.Views.Panels.ProjectAssetsView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource PanelBackground}">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    Padding="8,6">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Varlıklar" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                        <Button Content="Yeni Klasör"
                                ToolTip.Tip="Seçili konumun altında klasör oluştur"
                                Command="{Binding AssetBrowserViewModel.CreateFolderCommand}"
                                Background="Transparent" Foreground="{DynamicResource PrimaryText}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="4" Padding="6,3" FontSize="10"/>
                        <Button Content="İçe Aktar"
                                ToolTip.Tip="Dosyayı proje Assets klasörüne içe aktar"
                                Command="{Binding ImportAssetCommand}"
                                Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource AccentButtonFg}"
                                CornerRadius="4" Padding="6,3" FontSize="10"/>
                        <Button Content="Yenile"
                                ToolTip.Tip="Varlık listesini yenile"
                                Command="{Binding AssetBrowserViewModel.RefreshAssetsCommand}"
                                Background="Transparent" Foreground="{DynamicResource PrimaryText}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="4" Padding="6,3" FontSize="12"/>
                        <!-- Unity kromu Dilim G1: ızgara/liste anahtarı -->
                        <Button Content="{Binding AssetBrowserViewModel.AssetViewToggleText}"
                                ToolTip.Tip="Izgara/Liste görünümü arasında geç"
                                Command="{Binding AssetBrowserViewModel.ToggleAssetViewCommand}"
                                Background="Transparent" Foreground="{DynamicResource PrimaryText}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="4" Padding="6,3" FontSize="10"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Faz 4: arama + tür filtresi -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="8,6,8,2">
                <TextBox Grid.Column="0" Watermark="Ara: ad veya uzantı"
                         Text="{Binding AssetBrowserViewModel.SearchText}"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource PrimaryText}"
                         BorderBrush="{DynamicResource BorderSubtle}"
                         CornerRadius="4" Padding="6,3" FontSize="11" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AssetBrowserViewModel.AssetTypeFilters}"
                          SelectedItem="{Binding AssetBrowserViewModel.SelectedTypeFilter, Mode=TwoWay}"
                          FontSize="11" MinWidth="90"/>
            </Grid>

            <!-- Faz 6 Dilim 3: sol klasör ağacı + sağ simge ızgarası -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <!-- Yol çipi + üst klasör -->
                <DockPanel Grid.Row="0" Margin="8,6,8,2" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Content="↑ Üst"
                            ToolTip.Tip="Üst klasöre git"
                            Command="{Binding AssetBrowserViewModel.GoToParentFolderCommand}"
                            Background="Transparent" Foreground="{DynamicResource PrimaryText}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="4" Padding="6,3" FontSize="10" Margin="0,0,6,0"/>
                    <Border Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AssetBrowserViewModel.SelectedFolder.RelativePath, FallbackValue=Assets}"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AssetBrowserViewModel.SelectedFolder.FullPath}"/>
                    </Border>
                </DockPanel>

                <Grid Grid.Row="1" ColumnDefinitions="220,6,*">
            <TreeView Grid.Column="0"
                      Background="Transparent"
                      ItemsSource="{Binding AssetBrowserViewModel.AssetTree}"
                      SelectedItem="{Binding AssetBrowserViewModel.SelectedNode, Mode=TwoWay}"
                      Margin="4"
                      Foreground="{DynamicResource PrimaryText}">
                <!-- Faz 4: tek context menü (öğe düzeyi; sağ-tık seçimi code-behind'de). -->
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:AssetNodeViewModel">
                        <!-- Faz 4: genişletme ViewModel'den gelir (yalnızca kök + filtre). -->
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                        <Setter Property="Padding" Value="2,3"/>
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:AssetNodeViewModel" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Background="Transparent"
                                    PointerPressed="OnAssetPointerPressed"
                                    PointerMoved="OnAssetPointerMoved"
                                    PointerReleased="OnAssetPointerReleased"
                                    DoubleTapped="OnAssetDoubleTapped">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Yeni Klasör Oluştur" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.CreateFolderCommand}"/>
                                    <MenuItem Header="Dosya İçe Aktar..." Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportAssetCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Yeniden Adlandır (F2)" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.StartRenameCommand}"/>
                                    <MenuItem Header="Dosya Yöneticisinde Aç" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.OpenInExplorerCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Sil" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.DeleteAssetCommand}"/>
                                    <MenuItem Header="Yenile" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.RefreshAssetsCommand}"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}"
                                   Width="28" Height="28" Stretch="UniformToFill" VerticalAlignment="Center"/>
                            <Border IsVisible="{Binding !HasThumbnail}"
                                    Background="{DynamicResource ToolbarButtonBg}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="3" Padding="4,1" MinWidth="40"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="9"
                                           Foreground="{DynamicResource MutedText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="{Binding Name}"
                                       IsVisible="{Binding !IsEditing}"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Name}"
                                       VerticalAlignment="Center"/>

                            <!-- Faz 4: kayıp-grup bilgi çipi (grup satırı seçilemez). -->
                            <Border IsVisible="{Binding IsMissingGroup}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource ErrorColor}" BorderThickness="1"
                                    CornerRadius="3" Padding="4,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="bilgi" FontSize="9" Foreground="{DynamicResource ErrorColor}"/>
                            </Border>

                            <!-- MS-5: kayıp dosya rozeti (diskten silinen varlık) -->
                            <Border IsVisible="{Binding IsMissing}"
                                    Background="{DynamicResource DangerButtonBg}" CornerRadius="3" Padding="4,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="KAYIP" FontSize="9" Foreground="{DynamicResource ErrorColor}" FontWeight="Bold"/>
                            </Border>

                            <TextBox Text="{Binding EditingName, Mode=TwoWay}" 
                                     IsVisible="{Binding IsEditing}" 
                                     FontSize="12" 
                                     Padding="4,2" 
                                     Margin="0,-2,0,-2" 
                                     MinHeight="22" 
                                     Background="{DynamicResource InputBackground}" 
                                     Foreground="{DynamicResource PrimaryText}" 
                                     BorderBrush="{DynamicResource AccentColor}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}"/>
                                    <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Background="{DynamicResource BorderColor}"
                          ResizeDirection="Columns" Width="6"/>

            <!-- Sağ: simge ızgarası + taşınmış boş-durum panelleri -->
            <Grid Grid.Column="2" RowDefinitions="*,Auto">
                <ListBox x:Name="AssetGridListBox" Grid.Row="0" Background="Transparent"
                         ItemsSource="{Binding AssetBrowserViewModel.VisibleGridItems}"
                         SelectedItem="{Binding AssetBrowserViewModel.SelectedNode, Mode=TwoWay}"
                         SelectionMode="Single" Margin="4"
                         Foreground="{DynamicResource PrimaryText}"
                         IsVisible="{Binding AssetBrowserViewModel.IsGridView}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AssetBrowserViewModel.EnterSelectedFolderCommand}"/>
                    </ListBox.KeyBindings>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssetNodeViewModel">
                            <StackPanel Width="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.GridItemSize}"
                                        Background="Transparent" Spacing="4" Margin="6"
                                        PointerPressed="OnAssetPointerPressed"
                                        PointerMoved="OnAssetPointerMoved"
                                        PointerReleased="OnAssetPointerReleased"
                                        DoubleTapped="OnAssetDoubleTapped"
                                        ToolTip.Tip="{Binding Name}">
                                <!-- Faz 4 menüsüyle aynı 7 öğe (ızgara paritesi). -->
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Yeni Klasör Oluştur" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.CreateFolderCommand}"/>
                                        <MenuItem Header="Dosya İçe Aktar..." Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportAssetCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Yeniden Adlandır (F2)" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.StartRenameCommand}"/>
                                        <MenuItem Header="Dosya Yöneticisinde Aç" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.OpenInExplorerCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Sil" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.DeleteAssetCommand}"/>
                                        <MenuItem Header="Yenile" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.RefreshAssetsCommand}"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Border Background="{DynamicResource ToolbarButtonBg}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="6" Padding="6" HorizontalAlignment="Center"
                                        Width="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.GridItemImageSize}"
                                        Height="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.GridItemImageSize}">
                                    <Panel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}"
                                               Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TypeLabel}" IsVisible="{Binding !HasThumbnail}"
                                                   FontSize="10" Foreground="{DynamicResource MutedText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Panel>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" MaxLines="2"
                                           TextAlignment="Center" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Unity kromu Dilim G1: kompakt liste görünümü. Aynı pencere
                     (VisibleGridItems) + aynı seçim otoritesi (SelectedNode);
                     yalnızca sunum farklıdır. -->
                <ListBox x:Name="AssetListListBox" Grid.Row="0" Background="Transparent"
                         ItemsSource="{Binding AssetBrowserViewModel.VisibleGridItems}"
                         SelectedItem="{Binding AssetBrowserViewModel.SelectedNode, Mode=TwoWay}"
                         SelectionMode="Single" Margin="4"
                         Foreground="{DynamicResource PrimaryText}"
                         IsVisible="{Binding !AssetBrowserViewModel.IsGridView}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AssetBrowserViewModel.EnterSelectedFolderCommand}"/>
                    </ListBox.KeyBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssetNodeViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,1"
                                  DoubleTapped="OnAssetDoubleTapped"
                                  ToolTip.Tip="{Binding Name}">
                                <!-- Faz 4 menüsüyle aynı 7 öğe (liste paritesi). -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Yeni Klasör Oluştur" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.CreateFolderCommand}"/>
                                        <MenuItem Header="Dosya İçe Aktar..." Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportAssetCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Yeniden Adlandır (F2)" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.StartRenameCommand}"/>
                                        <MenuItem Header="Dosya Yöneticisinde Aç" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.OpenInExplorerCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Sil" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.DeleteAssetCommand}"/>
                                        <MenuItem Header="Yenile" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetBrowserViewModel.RefreshAssetsCommand}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource ToolbarButtonBg}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="3" Padding="4,1" MinWidth="40"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="9"
                                               Foreground="{DynamicResource MutedText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding RelativePath}"
                                           Foreground="{DynamicResource MutedText}"
                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Faz 6: veri-penceresi — WrapPanel sanallaşmaz, o yüzden
                     ızgara dilim dilim çizilir (200'erlik adımlar). -->
                <Button Grid.Row="0" Content="{Binding AssetBrowserViewModel.GridItemsStatus}"
                        Command="{Binding AssetBrowserViewModel.ShowMoreGridItemsCommand}"
                        ToolTip.Tip="Sonraki 200 öğeyi göster"
                        IsVisible="{Binding AssetBrowserViewModel.HasMoreGridItems}"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource PrimaryText}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="6" Padding="12,5" FontSize="11"/>

            <!-- Faz 5: boş-durum — dosyası yok (eylem: içe aktar) -->
            <StackPanel x:Name="AssetsEmptyPanel"
                        IsVisible="{Binding AssetBrowserViewModel.IsTreeEmpty}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" Margin="16">
                <TextBlock Text="Bu projede henüz dosya yok." FontSize="11" FontStyle="Italic"
                           Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Content="Dosya İçe Aktar" Command="{Binding ImportAssetCommand}"
                        ToolTip.Tip="Dosyayı proje Assets klasörüne içe aktar"
                        Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource AccentButtonFg}"
                        CornerRadius="6" Padding="12,5" FontSize="11"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Faz 5: boş-durum — filtre sonuç vermedi (eylem: temizle) -->
            <StackPanel x:Name="AssetsNoMatchPanel"
                        IsVisible="{Binding AssetBrowserViewModel.IsFilterNoMatch}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" Margin="16">
                <TextBlock Text="Arama filtresi sonuç vermedi." FontSize="11" FontStyle="Italic"
                           Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Content="Filtreyi Temizle"
                        Command="{Binding AssetBrowserViewModel.ClearFilterCommand}"
                        ToolTip.Tip="Arama ve tür filtresini temizle"
                        Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource AccentButtonFg}"
                        CornerRadius="6" Padding="12,5" FontSize="11"
                        HorizontalAlignment="Center"/>
            </StackPanel>
            </Grid>
                </Grid>
            </Grid>

            <!-- Faz 4: durum satırı + Faz 6 Dilim 3: ızgara boyut kaydırıcısı -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                    Padding="8,4">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="Boyut" Foreground="{DynamicResource MutedText}"
                                   FontSize="10" VerticalAlignment="Center"/>
                        <Slider Minimum="40" Maximum="128"
                                Value="{Binding AssetBrowserViewModel.GridItemSize, Mode=TwoWay}"
                                ToolTip.Tip="Simge boyutu"
                                Width="110" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AssetBrowserViewModel.StatusText}"
                               Foreground="{DynamicResource MutedText}" FontSize="10"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
