<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="700"
             x:Class="RowlEngine.Editor.Views.Panels.NodeHierarchyView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource PanelBackground}">
        <Grid RowDefinitions="Auto, *">

            <!-- Panel Header + Node Info + Create Object Button -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    Padding="8,5">
                <StackPanel Spacing="5">
                    <DockPanel>
                        <TextBlock Text="Hierarchy" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>

                        <!-- Create Object Button -->
                        <Button DockPanel.Dock="Right"
                                Content="Create"
                                Command="{Binding HierarchyViewModel.ToggleCreateObjectMenuCommand}"
                                IsEnabled="{Binding HierarchyViewModel.HasCurrentNode}"
                                Background="{DynamicResource AccentButtonBg}"
                                Foreground="{DynamicResource AccentButtonFg}"
                                FontWeight="SemiBold"
                                FontSize="11"
                                Padding="8,2"
                                CornerRadius="2"
                                HorizontalAlignment="Right">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Empty GameObject"
                                              Command="{Binding HierarchyViewModel.CreateObjectCommand}"
                                              CommandParameter="empty"/>
                                    <Separator/>
                                    <MenuItem Header="Background Object"
                                              Command="{Binding HierarchyViewModel.CreateObjectCommand}"
                                              CommandParameter="background"/>
                                    <MenuItem Header="Character Object"
                                              Command="{Binding HierarchyViewModel.CreateObjectCommand}"
                                              CommandParameter="character"/>
                                    <MenuItem Header="Dialogue Object"
                                              Command="{Binding HierarchyViewModel.CreateObjectCommand}"
                                              CommandParameter="dialogue"/>
                                    <MenuItem Header="Audio Object"
                                              Command="{Binding HierarchyViewModel.CreateObjectCommand}"
                                              CommandParameter="audio"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </DockPanel>

                    <!-- Unity kromu: nesne adı filtresi -->
                    <TextBox Watermark="Ara: nesne adı"
                             Text="{Binding HierarchyViewModel.HierarchyFilterText}"
                             IsVisible="{Binding HierarchyViewModel.HasCurrentNode}"
                             Background="{DynamicResource InputBackground}"
                             Foreground="{DynamicResource PrimaryText}"
                             BorderBrush="{DynamicResource BorderSubtle}"
                             CornerRadius="2" Padding="6,2" FontSize="11"/>

                    <!-- Active Node Info: Unity tarzı tek satır alt yazı
                         (başlık + kimlik; işlevsel bağlar aynen). -->
                    <TextBlock IsVisible="{Binding HierarchyViewModel.HasCurrentNode}"
                               Text="{Binding HierarchyViewModel.CurrentNodeTitle}"
                               ToolTip.Tip="{Binding HierarchyViewModel.CurrentNodeId}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedText}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock IsVisible="{Binding !HierarchyViewModel.HasCurrentNode}"
                               Text="Select a node from the graph"
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
            </Border>

            <!-- GameObject List (Unity tarzı tek satır) -->
            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding HierarchyViewModel.FilteredObjects}"
                         SelectedItem="{Binding HierarchyViewModel.SelectedObject, Mode=TwoWay}"
                         Background="Transparent"
                         Margin="0,2"
                         SelectionMode="Single"
                         IsVisible="{Binding HierarchyViewModel.HasCurrentNode}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="CornerRadius" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AccentButtonBg}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FrameObjectViewModel">
                            <Grid ColumnDefinitions="Auto, *">
                                <!-- GameObject Icon -->
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>

                                <!-- GameObject Name (tek satır; Etkin anahtarı
                                     Denetçi kartındadır) -->
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PrimaryText}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Duplicate Object"
                                      Command="{Binding HierarchyViewModel.DuplicateObjectCommand}"
                                      CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                            <Separator/>
                            <MenuItem Header="Move Up"
                                      Command="{Binding HierarchyViewModel.MoveObjectUpCommand}"
                                      CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                            <MenuItem Header="Move Down"
                                      Command="{Binding HierarchyViewModel.MoveObjectDownCommand}"
                                      CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                            <Separator/>
                            <MenuItem Header="Delete Object"
                                      Command="{Binding HierarchyViewModel.DeleteObjectCommand}"
                                      CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <!-- Placeholder when node has no objects -->
                <StackPanel IsVisible="{Binding HierarchyViewModel.IsCurrentNodeEmpty}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="16">
                    <TextBlock Text="No GameObjects in this frame." FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
