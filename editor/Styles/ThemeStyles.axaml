<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Rowl Engine — Dynamic Theme System
         Tüm renkler DynamicResource olarak tanımlanmıştır.
         Tema değişikliğinde bu ResourceDictionary runtime'da değiştirilir.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Arka Plan Katmanları ─────────────────────────────────────────── -->
    <!-- Unity kromu Dilim F: yüzeyler nötr Unity grilerine kaydı; App arka
         planı (#0A0A0B) ve ana metin sabittir (Test 2 kilidi). -->
    <Color x:Key="AppBackgroundColor">#0A0A0B</Color>
    <Color x:Key="SurfaceBackgroundColor">#232327</Color>
    <Color x:Key="PanelBackgroundColor">#2A2A2E</Color>
    <Color x:Key="InputBackgroundColor">#1B1B1E</Color>
    <Color x:Key="CanvasBackgroundColor">#000000</Color>

    <SolidColorBrush x:Key="AppBackground" Color="{DynamicResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="{DynamicResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackground" Color="{DynamicResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackground" Color="{DynamicResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="CanvasBackground" Color="{DynamicResource CanvasBackgroundColor}"/>

    <!-- ── Kenarlıklar ─────────────────────────────────────────────────── -->
    <Color x:Key="BorderColorValue">#3A3A40</Color>
    <Color x:Key="BorderSubtleColorValue">#4A4A52</Color>
    <SolidColorBrush x:Key="BorderColor" Color="{DynamicResource BorderColorValue}"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="{DynamicResource BorderSubtleColorValue}"/>

    <!-- ── Metin Renkleri ──────────────────────────────────────────────── -->
    <Color x:Key="PrimaryTextColor">#F2EFE6</Color>
    <Color x:Key="SecondaryTextColor">#D8D4CC</Color>
    <Color x:Key="MutedTextColor">#A8A49C</Color>
    <Color x:Key="DimTextColor">#6E6C66</Color>

    <SolidColorBrush x:Key="PrimaryText" Color="{DynamicResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryText" Color="{DynamicResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="MutedText" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="DimText" Color="{DynamicResource DimTextColor}"/>

    <!-- ── Vurgu (Accent) Renkleri ─────────────────────────────────────── -->
    <Color x:Key="AccentColor">#F2EFE6</Color>
    <Color x:Key="AccentHoverColor">#FFFFFF</Color>
    <Color x:Key="AccentButtonBgColor">#3B3B42</Color>
    <Color x:Key="AccentButtonHoverColor">#4C4C55</Color>

    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{DynamicResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentButtonBg" Color="{DynamicResource AccentButtonBgColor}"/>
    <SolidColorBrush x:Key="AccentButtonHover" Color="{DynamicResource AccentButtonHoverColor}"/>

    <!-- ── İşlevsel Renkler ────────────────────────────────────────────── -->
    <Color x:Key="SuccessColor">#7DA56D</Color>
    <Color x:Key="WarningColor">#DCA85A</Color>
    <Color x:Key="ErrorColor">#D96868</Color>
    <Color x:Key="InfoColor">#9C7FD1</Color>

    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}"/>

    <!-- ── Buton Renkleri ──────────────────────────────────────────────── -->
    <Color x:Key="ToolbarButtonBgColor">#323237</Color>
    <Color x:Key="ToolbarButtonHoverColor">#43434A</Color>
    <Color x:Key="DangerButtonBgColor">#6E3235</Color>
    <Color x:Key="PlayButtonGreenColor">#4A5D4C</Color>
    <Color x:Key="PlayButtonRedColor">#6E3235</Color>

    <SolidColorBrush x:Key="ToolbarButtonBg" Color="{DynamicResource ToolbarButtonBgColor}"/>
    <SolidColorBrush x:Key="ToolbarButtonHover" Color="{DynamicResource ToolbarButtonHoverColor}"/>
    <SolidColorBrush x:Key="DangerButtonBg" Color="{DynamicResource DangerButtonBgColor}"/>

    <!-- ── Status Bar ──────────────────────────────────────────────────── -->
    <Color x:Key="StatusBarBgColor">#0A0A0B</Color>
    <SolidColorBrush x:Key="StatusBarBg" Color="{DynamicResource StatusBarBgColor}"/>

    <!-- ── Node Graph ──────────────────────────────────────────────────── -->
    <Color x:Key="NodeCardBgColor">#232327</Color>
    <Color x:Key="NodeHeaderBgColor">#323237</Color>
    <Color x:Key="WireColor">#8E8E96</Color>
    <Color x:Key="WireDragColor">#F2EFE6</Color>

    <SolidColorBrush x:Key="NodeCardBg" Color="{DynamicResource NodeCardBgColor}"/>
    <SolidColorBrush x:Key="NodeHeaderBg" Color="{DynamicResource NodeHeaderBgColor}"/>

    <!-- ── Compatibility & Helper Aliases ──────────────────────────────── -->
    <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource NodeCardBgColor}"/>
    <SolidColorBrush x:Key="CardHeaderBackground" Color="{DynamicResource NodeHeaderBgColor}"/>
    <SolidColorBrush x:Key="CardBorderColor" Color="{DynamicResource BorderColorValue}"/>
    <SolidColorBrush x:Key="AccentButtonFg" Color="{DynamicResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="GraphCanvasBg" Color="{DynamicResource CanvasBackgroundColor}"/>

</ResourceDictionary>
