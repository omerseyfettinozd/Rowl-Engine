<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RowlEngine.Editor.ViewModels"
        x:Class="RowlEngine.Editor.Views.ProjectHubWindow"
        x:DataType="vm:ProjectHubViewModel"
        Title="Rowl Engine — Projeler"
        Width="1100" Height="680"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="İçe Aktar" Command="{Binding ImportExistingCommand}" Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,8" FontSize="12"/>
                    <Button Content="Yeni hikâye" Command="{Binding CreateProjectCommand}" Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" CornerRadius="8" Padding="18,9" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="ROWL" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" LetterSpacing="1.0"/>
                    <TextBlock Text="STORY STUDIO" FontWeight="Regular" FontSize="15" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" LetterSpacing="1.0" Margin="-6,0,0,0"/>
                    <Border Width="1" Height="16" Background="{DynamicResource BorderColor}" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Projeler" FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="28" FontWeight="Light" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="İlk hikâyeni kur" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                <TextBlock Text="Bir proje oluştur; sonra sahneleri, seçimleri ve önizlemeyi aynı çalışma alanında kur." Foreground="{DynamicResource MutedText}" FontSize="12" Width="380" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                <Button Content="Yeni hikâye oluştur" Command="{Binding CreateProjectCommand}" Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" CornerRadius="8" Padding="20,10" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Liste — Minecraft dünya şeritleri stili -->
            <ScrollViewer IsVisible="{Binding !IsEmpty}" Padding="12,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Projects}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectCardViewModel">
                            <Border Height="88" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" BoxShadow="0 6 18 0 #26000000">
                                <Grid ColumnDefinitions="84,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource InputBackground}" ClipToBounds="True" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                                        <Panel>
                                            <Image IsVisible="{Binding IsCoverLoaded}" Source="{Binding CoverBitmap}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                            <Panel IsVisible="{Binding !IsCoverLoaded}" Background="{DynamicResource PanelBackground}">
                                                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource ToolbarButtonBg}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="✦" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                                </Border>
                                            </Panel>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,8" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                                        <TextBlock Text="{Binding LastOpenedText, StringFormat='Son çalışma: {0}'}" FontSize="10" Foreground="{DynamicResource DimText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Button Content="Aç" Command="{Binding OpenCommand}" Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" CornerRadius="8" Padding="18,8" FontSize="12" FontWeight="SemiBold"/>
                                        <Button Content="⋯" Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" FontSize="14" Padding="8,6" MinWidth="36">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="İsim Değiştir" Command="{Binding RenameCommand}"/>
                                                    <MenuItem Header="Kapak Değiştir" Command="{Binding SetCoverCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Sil" Command="{Binding DeleteCommand}" Foreground="#DC2626"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedText}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
