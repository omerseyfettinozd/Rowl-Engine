<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:ctrl="using:RowlEngine.Editor.Controls"
             x:Class="RowlEngine.Editor.Views.Components.ScriptComponentView"
             x:DataType="comp:ScriptComponentViewModel">
  <Border Background="{DynamicResource CardBackground}" CornerRadius="2" Margin="0,4" Padding="0" BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
    <StackPanel>
      <Border Background="{DynamicResource CardHeaderBackground}" CornerRadius="2,2,0,0" Padding="8,6">
        <Grid ColumnDefinitions="*, Auto">
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" ToolTip.Tip="Enable/Disable" MinWidth="0" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"/>
            <ToggleButton Grid.Column="1" IsChecked="{Binding IsExpanded}" ToolTip.Tip="Genişlet/Daralt"
                          Background="Transparent" BorderThickness="0" Padding="4,2"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="Lua Script" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </ToggleButton>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
            <Button Content="Yukarı" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move Up" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
            <Button Content="Aşağı" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move Down" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
            <ToggleButton IsChecked="{Binding IsExpanded}" Content="Ayar" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
            <Button Content="Sil" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource ErrorColor}" BorderThickness="0" ToolTip.Tip="Remove Component" Command="{Binding RemoveSelfCommand}"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel IsVisible="{Binding IsExpanded}" Spacing="6" Margin="8,6">
      <TextBlock Text="Project-relative script path" FontSize="10" Foreground="{DynamicResource MutedText}" />
      <TextBox Text="{Binding ScriptPath}" Watermark="scripts/example.lua" />
      <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                 NodeId="{Binding Node.Id}" FieldKey="script.script_path" />
      <TextBlock Text="Inline code (optional)" FontSize="10" Foreground="{DynamicResource MutedText}" />
      <TextBox Text="{Binding InlineCode}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Watermark="function on_enter() end" />
      <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="6">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding RuntimeState, StringFormat='Runtime: {0}'}" FontSize="11" Foreground="{DynamicResource MutedText}" />
          <TextBlock Text="{Binding RuntimeError}" IsVisible="{Binding HasRuntimeError}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ErrorColor}" />
        </StackPanel>
      </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
