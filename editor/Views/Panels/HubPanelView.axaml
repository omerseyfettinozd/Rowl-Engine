<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             x:Class="RowlEngine.Editor.Views.Panels.HubPanelView"
             x:DataType="vm:ProjectHubViewModel"
             Background="{DynamicResource AppBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header — responsive: dar ekranda wrap eder -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Üst satır: Logo + başlık -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="ROWL" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent}" LetterSpacing="1.0" VerticalAlignment="Center"/>
                    <TextBlock Text="STORY STUDIO" FontSize="15" Foreground="{DynamicResource MutedText}" LetterSpacing="1.0" Margin="-6,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="{DynamicResource BorderColor}" Margin="4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Projeler" FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Alt satır: Butonlar — sağa hizalı -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="İçe Aktar" Command="{Binding ImportExistingCommand}" Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12"/>
                    <Button Content="Yeni hikâye" Command="{Binding CreateProjectCommand}" Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" CornerRadius="8" Padding="14,7" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- İçerik: Boş state veya proje listesi -->
        <Grid Grid.Row="1">
            <!-- Boş durum -->
            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="28" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Light"/>
                </Border>
                <TextBlock Text="İlk hikâyeni kur" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                <TextBlock Text="Bir proje oluştur; sahneleri, seçimleri ve önizlemeyi sırayla kur." Foreground="{DynamicResource MutedText}" FontSize="12" Width="340" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                <Button Content="Yeni hikâye oluştur" Command="{Binding CreateProjectCommand}" Background="{DynamicResource AccentButtonBg}" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" CornerRadius="8" Padding="20,10" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Proje listesi — Minecraft dünya şeritleri stili -->
            <ScrollViewer IsVisible="{Binding !IsEmpty}" Padding="10,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Projects}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectCardViewModel">
                            <!-- Minecraft şerit: sol kapak kare, orta bilgi, sağ Aç + menü -->
                            <Border Height="84" CornerRadius="6" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" BoxShadow="0 2 0 0 #1A1A1A" ClipToBounds="True">
                                <Grid ColumnDefinitions="84,*,Auto" Background="{DynamicResource SurfaceBackground}">
                                    <!-- Sol kapak -->
                                    <Border Grid.Column="0" Background="{DynamicResource InputBackground}" ClipToBounds="True" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                                        <Panel>
                                            <Image IsVisible="{Binding IsCoverLoaded}" Source="{Binding CoverBitmap}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                            <Panel IsVisible="{Binding !IsCoverLoaded}" Background="{DynamicResource PanelBackground}">
                                                <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource SurfaceBackground}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="▣" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                                </Border>
                                            </Panel>
                                        </Panel>
                                    </Border>
                                    <!-- Orta bilgi -->
                                    <StackPanel Grid.Column="1" Margin="10,8" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LastOpenedText}" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                                    </StackPanel>
                                    <!-- Sağ aksiyonlar -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Button Content="Aç" Command="{Binding OpenCommand}" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource PrimaryText}" CornerRadius="4" Padding="18,8" FontSize="12" FontWeight="Bold" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
                                        <Button Content="Diğer" Background="{DynamicResource ToolbarButtonBg}" Foreground="{DynamicResource PrimaryText}" FontSize="14" Padding="8,6" CornerRadius="4" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" MinWidth="36">
                                            <Button.Flyout><MenuFlyout><MenuItem Header="İsim Değiştir" Command="{Binding RenameCommand}"/><MenuItem Header="Kapak Değiştir" Command="{Binding SetCoverCommand}"/><Separator/><MenuItem Header="Sil" Command="{Binding DeleteCommand}" Foreground="{DynamicResource ErrorColor}"/></MenuFlyout></Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedText}" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
