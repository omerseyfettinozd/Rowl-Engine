<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:ctrl="using:RowlEngine.Editor.Controls"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             mc:Ignorable="d"
             x:Class="RowlEngine.Editor.Views.Components.CharacterComponentView"
             x:DataType="comp:CharacterComponentViewModel">

    <Border Classes="card" Margin="0,4" Padding="0" ClipToBounds="True">
        <StackPanel>
            <!-- Bileşen kartı başlığı (8 kartta aynı kalıp): onay kutusu | ad (yıldız sütun, kırpılır) | Ayar | "..." menüsü.
                 Yukarı/Aşağı/Sil menüde; böylece dar Denetçide başlık taşmaz. Komutlar aynı. -->
            <Border Background="{DynamicResource CardHeaderBackground}" Padding="8,6">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" ToolTip.Tip="{l:T Common.Enable.Tip}" MinWidth="0" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"/>
                <ToggleButton Grid.Column="1" Classes="header" IsChecked="{Binding IsExpanded}" ToolTip.Tip="{l:T Common.ExpandCollapse.Tip}"
                              Background="Transparent" BorderThickness="0" Padding="4,2" MinWidth="0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="cardKind" Text="{l:T Component.Character.Name}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Classes="cardTitle" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}"/>
                  </Grid>
                </ToggleButton>
                <ToggleButton Grid.Column="2" Classes="compact" IsChecked="{Binding IsExpanded}" Content="{l:T Common.Settings}" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Classes="compact" Content="..." ToolTip.Tip="{l:T Inspector.Components.Actions.Tip}" VerticalAlignment="Center">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="{l:T Common.MoveUp.Tip}" Command="{Binding MoveUpCommand}"/>
                      <MenuItem Header="{l:T Common.MoveDown.Tip}" Command="{Binding MoveDownCommand}"/>
                      <Separator/>
                      <MenuItem Header="{l:T Common.Delete}" Command="{Binding RemoveSelfCommand}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </Border>

            <!-- Component Body -->
            <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="8,6">
                <StackPanel Spacing="2">
                    <TextBlock Classes="fieldLabel" Text="{l:T Component.Character.Sprite.Label}"/>
                    <Border x:Name="DropZoneBorder"
                            DragDrop.AllowDrop="True"
                            Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1.5"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="6">
                        <StackPanel Spacing="6">
                            <ctrl:AssetPickerControl AssetPath="{Binding Sprite, Mode=TwoWay}"
                                                             Watermark="{l:T Component.Character.Sprite.Watermark}"
                                                             BrowseCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectImageForComponentCommand}"
                                                             BrowseParameter="{Binding}"/>
                            <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                                       NodeId="{Binding Node.Id}" FieldKey="character.sprite"/>
                            <!-- Sprite Preview Thumbnail / Drop Area -->
                            <Border Background="{DynamicResource CardHeaderBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="4" MinHeight="65" MaxHeight="130">
                                <Panel>
                                    <Image Source="{Binding SpriteBitmap}" Stretch="Uniform" MaxHeight="120"
                                           IsVisible="{Binding SpriteBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2"
                                                IsVisible="{Binding SpriteBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                                        <TextBlock Classes="fieldLabel" Text="{l:T Component.Character.Sprite.Drop}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Classes="hint" Text="{l:T Component.Character.Sprite.DropHint}" HorizontalAlignment="Center" FontStyle="Italic"/>
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Common.X}"/>
                        <NumericUpDown Value="{Binding X}" Minimum="-500" Maximum="2500" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Common.Y}"/>
                        <NumericUpDown Value="{Binding Y}" Minimum="-500" Maximum="2500" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                </Grid>

                <!-- Faz 5 Dilim 3: katmanlı karakter kütüphanesi (body/face/outfit/accessory) -->
                <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                <StackPanel Spacing="4">
                    <TextBlock Classes="caption" Text="{l:T Component.Character.Layers.Title}"/>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Component.Character.Layers.Body}"/>
                        <TextBox Text="{Binding LayerBodyAsset}" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Component.Character.Layers.Face}"/>
                        <TextBox Text="{Binding LayerFaceAsset}" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Component.Character.Layers.Outfit}"/>
                        <TextBox Text="{Binding LayerOutfitAsset}" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Component.Character.Layers.Accessory}"/>
                        <TextBox Text="{Binding LayerAccessoryAsset}" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Component.Character.Layers.Expression}"/>
                        <ComboBox ItemsSource="{Binding ExpressionNames}" SelectedItem="{Binding SelectedExpressionName, Mode=TwoWay}" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <TextBlock Classes="hint" Text="{Binding LayersBadgeText}" IsVisible="{Binding IsLayersBadgeVisible}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Common.Width}"/>
                        <NumericUpDown Value="{Binding Width}" Minimum="60" Maximum="2000" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Common.Height}"/>
                        <NumericUpDown Value="{Binding Height}" Minimum="60" Maximum="2000" Increment="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Component.Character.Scale}"/>
                        <NumericUpDown Value="{Binding Scale}" Minimum="0.05" Maximum="10.0" Increment="0.1" FormatString="0.00" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource Accent}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="compact" Content="{l:T Common.Reset}" Command="{Binding ResetRotation}" ToolTip.Tip="{l:T Component.Character.Rotation.Reset.Tip}" Margin="2,0,0,0"/>
                            <TextBlock Classes="fieldLabel" Text="{l:T Common.Rotation}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <NumericUpDown Value="{Binding Rotation}" Minimum="-360" Maximum="360" Increment="5" FormatString="0.0°" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                    </StackPanel>
                </Grid>

                <CheckBox IsChecked="{Binding MaintainAspectRatio}" Content="{l:T Component.Character.AspectRatio}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource MutedText}"/>

                <!-- OBS Quick Assist Buttons -->
                <StackPanel Spacing="4">
                    <TextBlock Classes="caption" Text="{l:T Component.Character.Assist.Title}"/>
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <Button Grid.Column="0" Classes="ghost" Content="{l:T Component.Character.Assist.Center}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CenterSelectedElementCommand}"
                                ToolTip.Tip="{l:T Component.Character.Assist.Center.Tip}"
                               />
                        <Button Grid.Column="1" Classes="ghost" Content="{l:T Component.Character.Assist.Ground}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AlignCharacterToBottomCommand}"
                                ToolTip.Tip="{l:T Component.Character.Assist.Ground.Tip}"
                               />
                        <Button Grid.Column="2" Classes="ghost" Content="{l:T Common.Reset}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ResetCharacterSizeCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="{l:T Component.Character.Assist.Reset.Tip}"
                               />
                    </Grid>
                </StackPanel>

                <!-- Character Default Voice Blip Settings -->
                <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Classes="caption" Text="{l:T Component.Character.Voice.Title}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="ghost" Content="{l:T Component.Character.Voice.Preview}" Command="{Binding PreviewVoiceBlipCommand}"
                                ToolTip.Tip="{l:T Component.Character.Voice.Preview.Tip}"
                                Padding="6,2" MinHeight="0"/>
                    </Grid>

                    <StackPanel Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="{l:T Component.Character.Voice.File}"/>
                        <ctrl:AssetPickerControl AssetPath="{Binding VoiceBlipSound, Mode=TwoWay}" Watermark="{l:T Component.Character.Voice.File.Watermark}"/>
                        <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                                   NodeId="{Binding Node.Id}" FieldKey="character.voice_blip"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{l:T Component.Character.Voice.Pitch}"/>
                                <TextBlock Grid.Column="1" Classes="fieldValue" Text="{Binding VoiceBlipPitch, StringFormat='{}{0:F2}x'}"/>
                            </Grid>
                            <Slider Value="{Binding VoiceBlipPitch}" Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{l:T Component.Character.Voice.Cadence}"/>
                                <TextBlock Grid.Column="1" Classes="fieldValue" Text="{Binding VoiceBlipCadence, StringFormat='{}Her {0}.'}"/>
                            </Grid>
                            <Slider Value="{Binding VoiceBlipCadence}" Minimum="1" Maximum="5" SmallChange="1" LargeChange="1"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
