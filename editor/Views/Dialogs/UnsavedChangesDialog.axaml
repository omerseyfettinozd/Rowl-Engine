<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:RowlEngine.Editor.Services.Strings" x:Class="RowlEngine.Editor.Views.Dialogs.UnsavedChangesDialog" Title="{l:T Dialog.UnsavedChanges.Title}" Width="480" Height="190" WindowStartupLocation="CenterOwner" CanResize="False">
 <Grid RowDefinitions="*,Auto" Margin="20"><TextBlock Text="{l:T Dialog.UnsavedChanges.Message}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
 <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Name="CancelButton" FontSize="12" Content="{l:T Dialog.UnsavedChanges.Cancel}"/><Button Name="DiscardButton" FontSize="12" Content="{l:T Dialog.UnsavedChanges.Discard}"/><Button Name="SaveButton" FontSize="12" Content="{l:T Dialog.UnsavedChanges.Save}"/></StackPanel></Grid>
</Window>
