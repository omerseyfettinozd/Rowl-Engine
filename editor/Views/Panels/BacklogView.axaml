<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             x:Class="RowlEngine.Editor.Views.Panels.BacklogView"
             x:DataType="vm:BacklogViewModel">
  <Border Background="{DynamicResource PanelBackground}" Padding="8">
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="{Binding speaker}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
              <TextBlock Text="{Binding dialogue}" FontSize="{DynamicResource FontSizeBodyLarge}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <!-- Faz 5: boş-durum — kayıt yok (eylem: oyuncuyu aç) -->
    <StackPanel x:Name="BacklogEmptyPanel" IsVisible="{Binding IsEmpty}"
                VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="16">
      <TextBlock Classes="muted" Text="{l:T Backlog.Empty}" FontSize="{DynamicResource FontSizeBody}" FontStyle="Italic"
                 HorizontalAlignment="Center"/>
      <TextBlock Classes="hint" Text="{l:T Backlog.Empty.Hint}" Foreground="{DynamicResource DimText}"
                 HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
      <Button Classes="secondary" Content="{l:T Backlog.OpenPlayer}" Command="{Binding OpenPlayerCommand}"
              ToolTip.Tip="{l:T Backlog.OpenPlayer.Tip}"
              HorizontalAlignment="Center"/>
    </StackPanel>
    </Grid>
  </Border>
</UserControl>
