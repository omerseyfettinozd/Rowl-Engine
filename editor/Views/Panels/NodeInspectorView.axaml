<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:search="using:RowlEngine.Editor.Services.Search"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:RowlEngine.Editor.Views.Components"
             xmlns:ctrl="using:RowlEngine.Editor.Controls"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="700"
             x:Class="RowlEngine.Editor.Views.Panels.NodeInspectorView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource PanelBackground}">
        <Grid RowDefinitions="Auto, *">

            <!-- Panel Header: GameObject Inspector (Unity Style) -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" 
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    Padding="10,8">
                <StackPanel Spacing="8">
                    <!-- Kart 1: GameObject (Unity tarzı düz bölüm) -->
                    <StackPanel>
                        <DockPanel Margin="0,2,0,0">
                            <StackPanel Spacing="0">
                                <TextBlock Text="DENETÇİ" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                                <TextBlock Text="Seçili sahne nesnesi" FontSize="10"
                                           Foreground="{DynamicResource MutedText}"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding HierarchyViewModel.SelectedObject.Id, StringFormat='ID: {0}', FallbackValue=''}"
                                       FontSize="10" Foreground="{DynamicResource MutedText}"
                                       VerticalAlignment="Center"/>
                            <!-- Unity kromu Dilim G3: nesne işlemleri
                                 taşma menüsü (yalnızca mevcut komutlar).
                                 Üç-nokta glifi lintte yasaktır, o
                                 yüzden Content "..." yazılır. -->
                            <Button DockPanel.Dock="Right" Content="..."
                                    ToolTip.Tip="Nesne işlemleri"
                                    IsEnabled="{Binding InspectorViewModel.HasSelectedObject}"
                                    Background="Transparent" Foreground="{DynamicResource MutedText}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="2" Padding="6,1" FontSize="11" Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem x:Name="DuplicateObjectMenuItem" Header="Çoğalt"
                                                  Command="{Binding HierarchyViewModel.DuplicateObjectCommand}"
                                                  CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                                        <MenuItem x:Name="DeleteObjectMenuItem" Header="Sil"
                                                  Command="{Binding HierarchyViewModel.DeleteObjectCommand}"
                                                  CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                                        <Separator/>
                                        <MenuItem x:Name="MoveObjectUpMenuItem" Header="Yukarı Taşı"
                                                  Command="{Binding HierarchyViewModel.MoveObjectUpCommand}"
                                                  CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                                        <MenuItem x:Name="MoveObjectDownMenuItem" Header="Aşağı Taşı"
                                                  Command="{Binding HierarchyViewModel.MoveObjectDownCommand}"
                                                  CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                                Margin="0,4,0,0"/>

                        <!-- Selected GameObject Name & Active State -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0"
                              IsVisible="{Binding InspectorViewModel.HasSelectedObject}">
                            <!-- Editable GameObject Name -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding HierarchyViewModel.SelectedObject.Name, FallbackValue='GameObject'}"
                                     Watermark="GameObject adı"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     FontSize="12" Padding="8,4" Margin="0,0,8,0"/>

                            <!-- Active Toggle -->
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding HierarchyViewModel.SelectedObject.IsActive}"
                                      ToolTip.Tip="GameObject etkinlik durumu"
                                      Content="Etkin"
                                      FontSize="11"
                                      Foreground="{DynamicResource PrimaryText}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Kart 2: Düğüm bölümü (düz bölüm; tüm iç bağlar aynen) -->
                    <StackPanel
                        IsVisible="{Binding SelectedNode, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBlock Text="DÜĞÜM" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}" Margin="0,4,0,2"/>
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"/>
                        <StackPanel Spacing="8" Margin="0,6,0,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Başlık" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                            <TextBox Text="{Binding SelectedNode.Title}"
                                     Watermark="Düğüm başlığı"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="{DynamicResource BorderColor}" FontSize="12"/>
                            <ctrl:FieldValidationBadge Validation="{Binding InspectorViewModel.Validation}"
                                                       NodeId="{Binding SelectedNode.Id}"
                                                       FieldKey="node.title"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Bölüm:"
                                       FontSize="11" Foreground="{DynamicResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding InspectorViewModel.ChapterAssignmentOptions}"
                                      SelectedItem="{Binding InspectorViewModel.SelectedChapterOption}"
                                      ToolTip.Tip="Kayıt/yükleme sınırı (Yok = tanımsız)"
                                      FontSize="11" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Gruplar" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                            <ItemsControl ItemsSource="{Binding InspectorViewModel.MemberGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CanvasGroupViewModel">
                                        <Border Background="{DynamicResource CardHeaderBackground}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontSize="10"
                                                           Foreground="{DynamicResource PrimaryText}"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="×" FontSize="10" Padding="4,0"
                                                        Command="{Binding $parent[UserControl].DataContext.InspectorViewModel.RemoveSelectedNodeFromGroupCommand}"
                                                        CommandParameter="{Binding GroupId}"
                                                        ToolTip.Tip="Gruptan çıkar (grup silinmez)"
                                                        Background="Transparent" Foreground="{DynamicResource MutedText}"
                                                        BorderThickness="0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding InspectorViewModel.JoinableGroups}"
                                          SelectedItem="{Binding InspectorViewModel.SelectedJoinGroup}"
                                          PlaceholderText="Gruba ekle…"
                                          FontSize="11" HorizontalAlignment="Stretch" Margin="0,0,4,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CanvasGroupViewModel">
                                            <TextBlock Text="{Binding Title}" FontSize="11"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="+ Ekle"
                                        Command="{Binding InspectorViewModel.JoinSelectedJoinGroupCommand}"
                                        FontSize="11" Padding="8,4"/>
                            </Grid>
                            <!-- Boş-durum: grupsuz düğüm (butonsuz ipucu) -->
                            <TextBlock Text="Henüz grup yok — listeden seçip + Ekle'ye bas."
                                       IsVisible="{Binding InspectorViewModel.HasNoMemberGroups}"
                                       FontSize="10" FontStyle="Italic"
                                       Foreground="{DynamicResource MutedText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Spacing="2" Orientation="Horizontal">
                            <TextBlock Text="Etiket:" FontSize="11"
                                       Foreground="{DynamicResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ctrl:ColorPickerControl Mode="Palette"
                                                     SelectedValue="{Binding SelectedNode.ColorTag, Mode=TwoWay}"
                                                     ToolTip.Tip="Düğüme renk etiketi ata (kart şeridi + minimap)"/>
                        </StackPanel>
                        <TextBlock Text="{Binding InspectorViewModel.SelectedNodeIssues.Count, StringFormat='{}{0} sorun'}"
                                   IsVisible="{Binding InspectorViewModel.SelectedNodeHasErrors}"
                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ErrorColor}"/>
                        <!-- Faz 5 Dilim 5 fix: dönüştürülmüş asset provenance rozeti.
                             Sidecar yoksa HasSelectedAssetProvenance=false → gizli (fail-closed).
                             Unity çizgisi: düz satır + hairline, standart etiket. -->
                        <Separator Background="{DynamicResource BorderColor}" Height="1"
                                   IsVisible="{Binding InspectorViewModel.HasSelectedAssetProvenance}"/>
                        <StackPanel Spacing="2"
                                IsVisible="{Binding InspectorViewModel.HasSelectedAssetProvenance}">
                            <TextBlock Text="DÖNÜŞTÜRME KÖKENİ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedText}"/>
                            <ItemsControl ItemsSource="{Binding InspectorViewModel.SelectedAssetProvenance}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10"
                                                   Foreground="{DynamicResource MutedText}"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                            </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Components List & Add Component Button -->
            <ScrollViewer Grid.Row="1" Padding="8,8" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">

                    <!-- Empty State: No GameObject Selected -->
                    <StackPanel IsVisible="{Binding !InspectorViewModel.HasSelectedObject}" 
                                Spacing="8" Margin="0,40">
                        <TextBlock Text="Seçili GameObject Yok"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Hiyerarşi panelinden bir nesne seç, bileşenler burada listelenir."
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{DynamicResource MutedText}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="16,0"/>
                    </StackPanel>

                    <DockPanel IsVisible="{Binding InspectorViewModel.HasSelectedObject}">
                        <TextBlock Text="BİLEŞENLER" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding HierarchyViewModel.SelectedObject.Components.Count, StringFormat='{}{0} etkin'}"
                                   FontSize="10" Foreground="{DynamicResource MutedText}"
                                   VerticalAlignment="Center"/>
                        <!-- Unity kromu Dilim G3: bileşen şeridi taşma
                             menüsü (mevcut Ekle komutunun kısayolu). -->
                        <Button DockPanel.Dock="Right" Content="..."
                                ToolTip.Tip="Bileşen işlemleri"
                                Command="{Binding ShowAddComponentMenuCommand}"
                                IsVisible="{Binding !IsAddComponentMenuOpen}"
                                IsEnabled="{Binding InspectorViewModel.HasSelectedObject}"
                                Background="Transparent" Foreground="{DynamicResource MutedText}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="2" Padding="6,1" FontSize="11" Margin="6,0,0,0"
                                VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Attached Components Collection (Rendered via ComponentTemplateSelector) -->
                    <ItemsControl ItemsSource="{Binding HierarchyViewModel.SelectedObject.Components}"
                                  IsVisible="{Binding InspectorViewModel.HasSelectedObject}">
                        <ItemsControl.ItemTemplate>
                            <views:ComponentTemplateSelector />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Boş-durum: bileşensiz nesne (butonsuz ipucu) -->
                    <TextBlock Text="Bu nesnede henüz bileşen yok — Bileşen Ekle ile ilk bileşeni ekle."
                               IsVisible="{Binding HierarchyViewModel.SelectedObject.HasNoComponents}"
                               FontSize="10" FontStyle="Italic"
                               Foreground="{DynamicResource MutedText}"
                               TextWrapping="Wrap" Margin="0,2"/>

                    <!-- ADD COMPONENT (Unity tarzı düz bölüm; komutlar aynen) -->
                    <StackPanel IsVisible="{Binding InspectorViewModel.HasSelectedObject}" Spacing="4" Margin="0,6,0,10">
                        <Button Content="Bileşen Ekle"
                                Command="{Binding ShowAddComponentMenuCommand}"
                                HorizontalAlignment="Stretch"
                                Padding="12,4"
                                FontSize="11"
                                Background="Transparent"
                                Foreground="{DynamicResource PrimaryText}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="2"
                                HorizontalContentAlignment="Center"/>

                        <!-- Add Component Flyout List -->
                        <StackPanel IsVisible="{Binding IsAddComponentMenuOpen}" Spacing="2">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Eklenecek bileşeni seç" FontSize="11"
                                           Foreground="{DynamicResource MutedText}" Margin="8,4"/>
                                <Button Content="Diyalog ve Konuşmacı"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="dialogue"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="2"/>
                                <Button Content="Arka Plan Katmanı"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="background"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="2"/>
                                <Button Content="Karakter Spritesı"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="character"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="2"/>
                                <Button Content="Ses ve DSP"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="audio"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="2"/>
                                <Button Content="Oyuncu Seçimleri"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="choice"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="2"/>
                                <Button Content="Lua Betiği"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="script"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="2"/>
                                <Button Content="Kamera (2D)"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="camera"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="2"/>
                                <Button Content="Sahne Geçişi"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="transition"
                                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="2"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
