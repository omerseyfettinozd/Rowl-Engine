<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             xmlns:ws="using:RowlEngine.Editor.Views.Workspace"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:search="using:RowlEngine.Editor.Services.Search"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:RowlEngine.Editor.Views.Components"
             xmlns:ctrl="using:RowlEngine.Editor.Controls"
             xmlns:panels="using:RowlEngine.Editor.Views.Panels"
             xmlns:insp="using:RowlEngine.Editor.Views.Panels.Inspector"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="700"
             x:Class="RowlEngine.Editor.Views.Panels.NodeInspectorView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <!-- Faz 10: "Gelişmiş ayarlar" kutu değil, soluk bir bölüm başlığı (yeni Denetçi'nin altında). -->
        <Style Selector="Expander#AdvancedInspectorExpander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Expander#AdvancedInspectorExpander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Expander#AdvancedInspectorExpander /template/ Border#ExpanderContent">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- Dar Denetçide (240-420 px) iki sütunlu sayı satırları taşmasın: Fluent NumericUpDown
             şablonundaki TextBox MinWidth=64 ve geniş (34 px) ok düğmeleri satırı ~250 px'e zorluyordu. -->
        <Style Selector="NumericUpDown:not(:disabled)">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6,5,2,5"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <!-- ":not(:disabled)" bilinçli: ControlTheme'deki MinWidth=34 / Width değerini yalnız etkinleştirilmiş
             (StyleTrigger öncelikli) bir seçici ezebiliyor; ok düğmeleri 34 yerine 22 px olur. -->
        <Style Selector="NumericUpDown RepeatButton:not(:disabled)">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="22"/>
        </Style>
        <!-- Uzun etiket/ipucu metinleri kartın dışına taşıp kırpılmasın, satır kaydırsın. -->
        <Style Selector="TextBlock.caption, TextBlock.fieldLabel, TextBlock.hint, TextBlock.body">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource PanelBackground}">
        <Grid RowDefinitions="Auto, *">

            <!-- Panel başlığı (ortak kalıp: Border.panelHeader) + nesne kimliği + "..." menüsü -->
            <Border Grid.Row="0" Classes="panelHeader">
                <DockPanel>
                    <!-- Faz 5 D4: çalışma alanı sabitle / kapat (panel bu başlığı kendi çizer) -->
                    <ws:PanelHeaderActions DockPanel.Dock="Right" Margin="4,0,-6,0"/>
                    <!-- Prototip başlığı: ikon + ad (alt başlık kaldırıldı; dar panelde taşıyordu). -->
                    <Path DockPanel.Dock="Left" Classes="panelHeaderIcon"
                          Data="M4,7 h10 M18,7 h2 M4,17 h2 M10,17 h10 M14,5 v4 M6,15 v4"/>
                    <TextBlock DockPanel.Dock="Left" Text="{l:T Inspector.Header.Title}" Classes="panelTitle" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{l:T Inspector.Header.Subtitle}"/>
                    <!-- Faz 8 D3: başlık önce ölçülür, kimlik + "..." kalan alanı paylaşır (%130 ölçekte
                         "DENETÇİ" kesiliyor, kimlik yerini koruyordu). Görsel sıra değişmedi. -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding HierarchyViewModel.SelectedObject.Id, StringFormat='ID: {0}', FallbackValue=''}"
                                   IsVisible="False"
                                   Classes="panelSubtitle" MaxWidth="80" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding HierarchyViewModel.SelectedObject.Id}"
                                   VerticalAlignment="Center"/>
                                <!-- Unity kromu Dilim G3: nesne işlemleri
                                     taşma menüsü (yalnızca mevcut komutlar).
                                     Üç-nokta glifi lintte yasaktır, o
                                     yüzden Content "..." yazılır. -->
                                <Button DockPanel.Dock="Right" Content="..." Classes="tool"
                                        ToolTip.Tip="{l:T Inspector.Object.Actions.Tip}"
                                        IsEnabled="{Binding InspectorViewModel.HasSelectedObject}"
                                        Foreground="{DynamicResource MutedText}" Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem x:Name="DuplicateObjectMenuItem" Header="{l:T Inspector.Menu.Duplicate}"
                                                      Command="{Binding HierarchyViewModel.DuplicateObjectCommand}"
                                                      CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                                            <MenuItem x:Name="DeleteObjectMenuItem" Header="{l:T Common.Delete}"
                                                      Command="{Binding HierarchyViewModel.DeleteObjectCommand}"
                                                      CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                                            <Separator/>
                                            <MenuItem x:Name="MoveObjectUpMenuItem" Header="{l:T Inspector.Menu.MoveUp}"
                                                      Command="{Binding HierarchyViewModel.MoveObjectUpCommand}"
                                                      CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                                            <MenuItem x:Name="MoveObjectDownMenuItem" Header="{l:T Inspector.Menu.MoveDown}"
                                                      Command="{Binding HierarchyViewModel.MoveObjectDownCommand}"
                                                      CommandParameter="{Binding HierarchyViewModel.SelectedObject}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Components List & Add Component Button -->
            <!-- Kök neden: ScrollViewer.Padding ölçümde düşülmüyor (yalnız yerleştirmede), içerik panelden
                 16 px geniş ölçülüp sağdan taşıyordu. İç boşluk Padding yerine Margin ile verilir. -->
            <ScrollViewer x:Name="InspectorScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <!-- Faz 10: yazar dilinde Denetçi (onaylı taslak: prototypes/editor-workspace/inspector-redesign.html) -->
                <insp:SceneInspectorView x:Name="SceneInspector" DataContext="{Binding InspectorScene}"/>
                <!-- Faz 10: eski ayrıntılı nesne / bileşen düzenleyicisi — hiçbir özellik kaybolmasın diye katlı -->
                <Expander x:Name="AdvancedInspectorExpander" Header="{l:T Inspector.Advanced.Title}"
                          IsVisible="{Binding InspectorScene.Mode, Converter={x:Static insp:EnumEqualsConverter.Instance}, ConverterParameter=Single}"
                          IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,16,0,8">
                  <StackPanel>
            <!-- Seçili nesne adı + Etkin, ardından Düğüm bölümü -->
            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    Padding="10,8">
                <StackPanel Spacing="8">
                    <StackPanel>
                        <!-- Selected GameObject Name & Active State -->
                        <Grid ColumnDefinitions="*, Auto"
                              IsVisible="{Binding InspectorViewModel.HasSelectedObject}">
                            <!-- Editable GameObject Name -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding HierarchyViewModel.SelectedObject.Name, FallbackValue='GameObject'}"
                                     Watermark="{l:T Inspector.Object.Name.Watermark}"
                                     FontSize="{DynamicResource FontSizeBodyLarge}" Padding="8,4" Margin="0,0,8,0" MinWidth="0"/>

                            <!-- Active Toggle -->
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding HierarchyViewModel.SelectedObject.IsActive}"
                                      ToolTip.Tip="{l:T Inspector.Object.Active.Tip}"
                                      Content="{l:T Inspector.Object.Active}"
                                      FontSize="{DynamicResource FontSizeBody}"
                                      Foreground="{DynamicResource PrimaryText}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Kart 2: Düğüm bölümü (düz bölüm; tüm iç bağlar aynen) -->
                    <StackPanel
                        IsVisible="{Binding SelectedNode, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{l:T Inspector.Node.Section}" Classes="caption" Margin="0,4,0,2"/>
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"/>
                        <StackPanel Spacing="8" Margin="0,6,0,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{l:T Inspector.Node.Title.Label}" Classes="fieldLabel"/>
                            <TextBox Text="{Binding SelectedNode.Title}"
                                     Watermark="{l:T Inspector.Node.Title.Watermark}"
                                     FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            <ctrl:FieldValidationBadge Validation="{Binding InspectorViewModel.Validation}"
                                                       NodeId="{Binding SelectedNode.Id}"
                                                       FieldKey="node.title"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="{l:T Inspector.Node.Chapter.Label}"
                                       Classes="muted" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding InspectorViewModel.ChapterAssignmentOptions}"
                                      SelectedItem="{Binding InspectorViewModel.SelectedChapterOption}"
                                      ToolTip.Tip="{l:T Inspector.Node.Chapter.Tip}"
                                      FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{l:T Inspector.Node.Groups.Label}" Classes="fieldLabel"/>
                            <ItemsControl ItemsSource="{Binding InspectorViewModel.MemberGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CanvasGroupViewModel">
                                        <Border Background="{DynamicResource CardHeaderBackground}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSmall}" Padding="6,2" Margin="0,0,4,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding Title}" Classes="fieldValue" FontWeight="Normal"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="×" Classes="compact" Padding="4,0"
                                                        Command="{Binding $parent[UserControl].DataContext.InspectorViewModel.RemoveSelectedNodeFromGroupCommand}"
                                                        CommandParameter="{Binding GroupId}"
                                                        ToolTip.Tip="{l:T Inspector.Node.Group.Remove.Tip}"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding InspectorViewModel.JoinableGroups}"
                                          SelectedItem="{Binding InspectorViewModel.SelectedJoinGroup}"
                                          PlaceholderText="{l:T Inspector.Node.Group.Join.Placeholder}"
                                          FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Stretch" Margin="0,0,4,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CanvasGroupViewModel">
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBody}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="{l:T Inspector.Node.Group.Join.Button}" Classes="ghost"
                                        Command="{Binding InspectorViewModel.JoinSelectedJoinGroupCommand}"/>
                            </Grid>
                            <!-- Boş-durum: grupsuz düğüm (butonsuz ipucu) -->
                            <TextBlock Text="{l:T Inspector.Node.Groups.Empty}"
                                       IsVisible="{Binding InspectorViewModel.HasNoMemberGroups}"
                                       Classes="hint" FontStyle="Italic" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Yıldız sütun: renk paleti (WrapPanel) panel genişliğine sarılır, taşmaz. -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="{l:T Inspector.Node.Color.Label}" Classes="muted" FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ctrl:ColorPickerControl Grid.Column="1" Mode="Palette" HorizontalAlignment="Left"
                                                     SelectedValue="{Binding SelectedNode.ColorTag, Mode=TwoWay}"
                                                     ToolTip.Tip="{l:T Inspector.Node.Color.Tip}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="3"
                                    IsVisible="{Binding InspectorViewModel.SelectedNodeHasErrors}">
                            <TextBlock Text="{Binding InspectorViewModel.SelectedNodeIssues.Count}"
                                       Classes="fieldValue" Foreground="{DynamicResource ErrorBrush}"/>
                            <TextBlock Text="{l:T Inspector.Node.Issues.Suffix}"
                                       Classes="fieldValue" Foreground="{DynamicResource ErrorBrush}"/>
                        </StackPanel>
                        <!-- Faz 7 D3: Düğüm kütüphanesi bölümü (prototip inspector-library.jpg). -->
                        <panels:NodeLibraryInspectorSection DataContext="{Binding NodeLibrary}"/>
                        <!-- Faz 5 Dilim 5 fix: dönüştürülmüş asset provenance rozeti.
                             Sidecar yoksa HasSelectedAssetProvenance=false → gizli (fail-closed).
                             Unity çizgisi: düz satır + hairline, standart etiket. -->
                        <Separator Background="{DynamicResource BorderColor}" Height="1"
                                   IsVisible="{Binding InspectorViewModel.HasSelectedAssetProvenance}"/>
                        <StackPanel Spacing="2"
                                IsVisible="{Binding InspectorViewModel.HasSelectedAssetProvenance}">
                            <TextBlock Text="{l:T Inspector.Provenance.Title}" Classes="caption"/>
                            <ItemsControl ItemsSource="{Binding InspectorViewModel.SelectedAssetProvenance}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Classes="hint"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxLines="4" ToolTip.Tip="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                            </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

                <StackPanel Spacing="8" Margin="8">

                    <!-- Empty State: No GameObject Selected -->
                    <StackPanel IsVisible="{Binding !InspectorViewModel.HasSelectedObject}" 
                                Spacing="8" Margin="0,40">
                        <TextBlock Text="{l:T Inspector.Empty.Title}"
                                   Classes="cardTitle"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{l:T Inspector.Empty.Hint}"
                                   Classes="muted" FontSize="{DynamicResource FontSizeBody}" FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="16,0"/>
                    </StackPanel>

                    <DockPanel IsVisible="{Binding InspectorViewModel.HasSelectedObject}">
                        <TextBlock Text="{l:T Inspector.Components.Title}" Classes="caption" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HierarchyViewModel.SelectedObject.Components.Count}" Classes="hint"/>
                            <TextBlock Text="{l:T Inspector.Components.CountSuffix}" Classes="hint"/>
                        </StackPanel>
                        <!-- Unity kromu Dilim G3: bileşen şeridi taşma
                             menüsü (mevcut Ekle komutunun kısayolu). -->
                        <Button DockPanel.Dock="Right" Content="..." Classes="tool"
                                ToolTip.Tip="{l:T Inspector.Components.Actions.Tip}"
                                Command="{Binding ShowAddComponentMenuCommand}"
                                IsVisible="{Binding !IsAddComponentMenuOpen}"
                                IsEnabled="{Binding InspectorViewModel.HasSelectedObject}"
                                Foreground="{DynamicResource MutedText}" Margin="6,0,0,0"
                                VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Attached Components Collection (Rendered via ComponentTemplateSelector) -->
                    <ItemsControl ItemsSource="{Binding HierarchyViewModel.SelectedObject.Components}"
                                  IsVisible="{Binding InspectorViewModel.HasSelectedObject}">
                        <ItemsControl.ItemTemplate>
                            <views:ComponentTemplateSelector />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Boş-durum: bileşensiz nesne (butonsuz ipucu) -->
                    <TextBlock Text="{l:T Inspector.Components.Empty}"
                               IsVisible="{Binding HierarchyViewModel.SelectedObject.HasNoComponents}"
                               Classes="hint" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2"/>

                    <!-- ADD COMPONENT (Unity tarzı düz bölüm; komutlar aynen) -->
                    <StackPanel IsVisible="{Binding InspectorViewModel.HasSelectedObject}" Spacing="4" Margin="0,6,0,10">
                        <Button Content="{l:T Inspector.Components.Add}" Classes="ghost"
                                Command="{Binding ShowAddComponentMenuCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>

                        <!-- Add Component Flyout List -->
                        <StackPanel IsVisible="{Binding IsAddComponentMenuOpen}" Spacing="2">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:T Inspector.Components.Add.Prompt}" Classes="muted" FontSize="{DynamicResource FontSizeBody}" Margin="8,4"/>
                                <Button Content="{l:T Inspector.Components.Add.Dialogue}" Classes="ghost"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="dialogue"
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="{l:T Inspector.Components.Add.Background}" Classes="ghost"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="background"
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="{l:T Inspector.Components.Add.Character}" Classes="ghost"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="character"
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="{l:T Inspector.Components.Add.Audio}" Classes="ghost"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="audio"
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="{l:T Inspector.Components.Add.Choice}" Classes="ghost"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="choice"
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="{l:T Inspector.Components.Add.Script}" Classes="ghost"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="script"
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="{l:T Inspector.Components.Add.Camera}" Classes="ghost"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="camera"
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="{l:T Inspector.Components.Add.Transition}" Classes="ghost"
                                        Command="{Binding AddComponentByTypeCommand}" CommandParameter="transition"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
