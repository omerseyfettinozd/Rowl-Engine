<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             x:Class="RowlEngine.Editor.Views.Components.TransitionComponentView"
             x:DataType="comp:TransitionComponentViewModel">
  <Border Background="{DynamicResource CardBackground}" CornerRadius="2" Margin="0,4" Padding="0" BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1">
    <StackPanel>
      <Border Background="{DynamicResource CardHeaderBackground}" CornerRadius="2,2,0,0" Padding="8,6">
        <Grid ColumnDefinitions="*, Auto">
          <TextBlock Grid.Column="0" Text="Scene Transition" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding IsEnabled}" ToolTip.Tip="Enable/Disable" MinWidth="0" Padding="0" Margin="0,0,2,0"/>
            <Button Content="Yukarı" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move Up" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
            <Button Content="Aşağı" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move Down" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
            <ToggleButton IsChecked="{Binding IsExpanded}" Content="Ayar" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0"/>
            <Button Content="Sil" FontSize="10" Padding="4,2" MinWidth="0" Background="Transparent" Foreground="{DynamicResource ErrorColor}" BorderThickness="0" ToolTip.Tip="Remove Component" Command="{Binding RemoveSelfCommand}"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="8,6">

      <!-- Transition Kind -->
      <StackPanel Spacing="2">
        <TextBlock Text="Transition Type" FontSize="10" Foreground="{DynamicResource MutedText}" />
        <ComboBox ItemsSource="{x:Static comp:TransitionComponentViewModel.AvailableKinds}"
                  SelectedItem="{Binding Kind}"
                  HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Duration and Color -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Duration (Seconds)" FontSize="10" Foreground="{DynamicResource MutedText}" />
          <NumericUpDown Value="{Binding Duration}" Increment="0.25" Minimum="0.01" Maximum="60.0" FormatString="F2" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="Color Hex (Fade Color)" FontSize="10" Foreground="{DynamicResource MutedText}" />
          <TextBox Text="{Binding ColorHex}" Watermark="#000000" />
        </StackPanel>
      </Grid>

      <!-- Screen Flash FX -->
      <Separator Background="{DynamicResource BorderColor}" Height="1"/>
      <StackPanel Spacing="6">
        <CheckBox IsChecked="{Binding FlashEnabled}" Content="Screen Flash FX" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource MutedText}" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding FlashEnabled}">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="Color Hex" FontSize="10" Foreground="{DynamicResource MutedText}" />
            <TextBox Text="{Binding FlashColorHex}" Watermark="#FFFFFF" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Duration (s)" FontSize="10" Foreground="{DynamicResource MutedText}" />
            <NumericUpDown Value="{Binding FlashDuration}" Increment="0.1" Minimum="0.01" Maximum="60.0" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="Intensity" FontSize="10" Foreground="{DynamicResource MutedText}" />
            <NumericUpDown Value="{Binding FlashIntensity}" Increment="0.1" Minimum="0.0" Maximum="1.0" FormatString="F2" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- Color Tint & Vignette FX -->
      <Separator Background="{DynamicResource BorderColor}" Height="1"/>
      <StackPanel Spacing="6">
        <TextBlock Text="Post-Process Color Tint &amp; Vignette" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource MutedText}" />

        <!-- Tint -->
        <CheckBox IsChecked="{Binding TintEnabled}" Content="Screen Color Tint Overlay" FontSize="10" Foreground="{DynamicResource MutedText}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding TintEnabled}">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="Tint Color Hex" FontSize="10" Foreground="{DynamicResource MutedText}" />
            <TextBox Text="{Binding TintColorHex}" Watermark="#0A183D" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Tint Opacity (0-1)" FontSize="10" Foreground="{DynamicResource MutedText}" />
            <NumericUpDown Value="{Binding TintOpacity}" Increment="0.05" Minimum="0.0" Maximum="1.0" FormatString="F2" />
          </StackPanel>
        </Grid>

        <!-- Vignette -->
        <CheckBox IsChecked="{Binding VignetteEnabled}" Content="Cinematic Vignette Darkening" FontSize="10" Foreground="{DynamicResource MutedText}" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding VignetteEnabled}">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="Intensity" FontSize="10" Foreground="{DynamicResource MutedText}" />
            <NumericUpDown Value="{Binding VignetteIntensity}" Increment="0.1" Minimum="0.0" Maximum="1.0" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Radius" FontSize="10" Foreground="{DynamicResource MutedText}" />
            <NumericUpDown Value="{Binding VignetteRadius}" Increment="0.05" Minimum="0.1" Maximum="1.0" FormatString="F2" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="Color Hex" FontSize="10" Foreground="{DynamicResource MutedText}" />
            <TextBox Text="{Binding VignetteColorHex}" Watermark="#000000" />
          </StackPanel>
        </Grid>
      </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
