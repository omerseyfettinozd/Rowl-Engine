<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:ctrl="using:RowlEngine.Editor.Controls"
             mc:Ignorable="d"
             x:Class="RowlEngine.Editor.Views.Components.DialogueComponentView"
             x:DataType="comp:DialogueComponentViewModel">

    <Border Classes="card" ClipToBounds="True" Margin="0,4">
        <StackPanel>
            <!-- Bileşen kartı başlığı (8 kartta aynı kalıp): onay kutusu | ad (yıldız sütun, kırpılır) | Ayar | "..." menüsü.
                 Yukarı/Aşağı/Sil menüde; böylece dar Denetçide başlık taşmaz. Komutlar aynı. -->
            <Border Background="{DynamicResource CardHeaderBackground}" Padding="8,6">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" ToolTip.Tip="{l:T Common.Enable.Tip}" MinWidth="0" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"/>
                <ToggleButton Grid.Column="1" Classes="header" IsChecked="{Binding IsExpanded}" ToolTip.Tip="{l:T Common.ExpandCollapse.Tip}"
                              Background="Transparent" BorderThickness="0" Padding="4,2" MinWidth="0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="cardKind" Text="{l:T Component.Dialogue.Title}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Classes="cardTitle" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}"/>
                  </Grid>
                </ToggleButton>
                <ToggleButton Grid.Column="2" Classes="compact" IsChecked="{Binding IsExpanded}" Content="{l:T Common.Settings}" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Classes="compact" Content="..." ToolTip.Tip="{l:T Inspector.Components.Actions.Tip}" VerticalAlignment="Center">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="{l:T Common.MoveUp.Tip}" Command="{Binding MoveUpCommand}"/>
                      <MenuItem Header="{l:T Common.MoveDown.Tip}" Command="{Binding MoveDownCommand}"/>
                      <Separator/>
                      <MenuItem Header="{l:T Common.Delete}" Command="{Binding RemoveSelfCommand}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </Border>

            <!-- Component Body -->
            <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="8,6">
                <!-- 1. Speaker & Dialogue Content -->
                <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:T Component.Dialogue.Section.Speaker}" Classes="caption"/>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:T Component.Dialogue.Speaker.Label}" Classes="fieldLabel"/>
                        <TextBox Text="{Binding Speaker, Mode=TwoWay}" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                        <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                                   NodeId="{Binding Node.Id}" FieldKey="dialogue.speaker"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:T Component.Dialogue.TitleFont.Label}" Classes="fieldLabel"/>
                        <ctrl:RangedNumberControl Value="{Binding SpeakerFontSize}" Minimum="10" Maximum="64" Step="2" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:T Component.Dialogue.TitleColor.Label}" Classes="fieldLabel"/>
                        <ctrl:ColorPickerControl Mode="Hex" SelectedValue="{Binding SpeakerColor, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:T Component.Dialogue.Text.Label}" Classes="fieldLabel"/>
                        <TextBox Text="{Binding DialogueText, Mode=TwoWay}" AcceptsReturn="True" Height="64"
                                 TextWrapping="Wrap" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                        <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                                   NodeId="{Binding Node.Id}" FieldKey="dialogue.dialogue_text"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:T Component.Dialogue.ContentId.Label}" Classes="fieldLabel"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding ContentId, Mode=TwoWay}" FontFamily="Monospace"
                                     FontSize="{DynamicResource FontSizeSmall}"
                                     ToolTip.Tip="{Binding ContentId}"/>
                            <Button Grid.Column="1" Content="{l:T Component.Dialogue.ContentId.Generate}" Classes="ghost"
                                    ToolTip.Tip="{l:T Component.Dialogue.ContentId.Generate.Tip}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.RegenerateSelectedContentIdCommand}"/>
                        </Grid>
                        <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                                   NodeId="{Binding Node.Id}" FieldKey="dialogue.content_id"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Typewriter & Timing Behavior -->
                <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:T Component.Dialogue.Section.Typewriter}" Classes="caption"/>

                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding TypewriterEnabled}" Content="{l:T Component.Dialogue.Typewriter.Enable}" FontSize="{DynamicResource FontSizeBody}"/>
                        <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding TypewriterEnabled}">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{l:T Component.Dialogue.Speed.Label}" Classes="fieldLabel"/>
                                <TextBlock Grid.Column="1" Text="{Binding TextSpeed, StringFormat='{}{0} ms'}" Classes="fieldValue"/>
                            </Grid>
                            <Slider Value="{Binding TextSpeed}" Minimum="5" Maximum="100" SmallChange="5" LargeChange="15"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding AutoAdvance}" Content="{l:T Component.Dialogue.AutoAdvance}" FontSize="{DynamicResource FontSizeBody}"/>
                        <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding AutoAdvance}">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{l:T Component.Dialogue.WaitDelay.Label}" Classes="fieldLabel"/>
                                <TextBlock Grid.Column="1" Text="{Binding AutoAdvanceDelay, StringFormat='{}{0:F1}s'}" Classes="fieldValue"/>
                            </Grid>
                            <Slider Value="{Binding AutoAdvanceDelay}" Minimum="0.5" Maximum="10.0" SmallChange="0.5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Voice Blip Sound Asset & Preview -->
                    <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{l:T Component.Dialogue.Blip.Title}" Classes="fieldLabel"
                                       FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="{l:T Component.Dialogue.Blip.Preview}" Command="{Binding PreviewVoiceBlipCommand}"
                                    ToolTip.Tip="{l:T Component.Dialogue.Blip.Preview.Tip}"
                                    Classes="ghost" FontSize="{DynamicResource FontSizeSmall}" Padding="8,4"/>
                        </Grid>

                        <StackPanel Spacing="2">
                            <TextBlock Text="{l:T Component.Dialogue.Blip.Asset.Label}" Classes="fieldLabel" TextWrapping="Wrap"/>
                            <ctrl:AssetPickerControl AssetPath="{Binding TypewriterSound, Mode=TwoWay}" Watermark="{l:T Component.Dialogue.Blip.Asset.Watermark}"/>
                            <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                                       NodeId="{Binding Node.Id}" FieldKey="dialogue.blip_sound"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <!-- Base Pitch -->
                            <StackPanel Grid.Column="0" Spacing="2">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{l:T Component.Dialogue.Pitch.Label}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding VoiceBlipPitch, StringFormat='{}{0:F2}x'}" Classes="fieldValue"/>
                                </Grid>
                                <Slider Value="{Binding VoiceBlipPitch}" Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"/>
                            </StackPanel>

                            <!-- Pitch Variance -->
                            <StackPanel Grid.Column="1" Spacing="2">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{l:T Component.Dialogue.Modulation.Label}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding VoiceBlipVariance, StringFormat='{}{0:F2}'}" Classes="fieldValue"/>
                                </Grid>
                                <Slider Value="{Binding VoiceBlipVariance}" Minimum="0.0" Maximum="0.30" SmallChange="0.01" LargeChange="0.05"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <!-- Cadence (every N characters) -->
                            <StackPanel Grid.Column="0" Spacing="2">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{l:T Component.Dialogue.Cadence.Label}" Classes="fieldLabel" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding VoiceBlipCadence}" Classes="fieldValue"/>
                                </Grid>
                                <Slider Value="{Binding VoiceBlipCadence}" Minimum="1" Maximum="5" SmallChange="1" LargeChange="1"/>
                            </StackPanel>

                            <!-- Blip Volume -->
                            <StackPanel Grid.Column="1" Spacing="2">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{l:T Component.Dialogue.Volume.Label}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding VoiceBlipVolume, StringFormat='{}{0:P0}'}" Classes="fieldValue"/>
                                </Grid>
                                <Slider Value="{Binding VoiceBlipVolume}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dar panelde yan yana sığmıyordu (iç Grid sütun atamasızdı, onay kutusunun üstüne biniyordu): alt alta. -->
                        <StackPanel Spacing="4">
                            <CheckBox IsChecked="{Binding VoiceBlipSkipPunctuation}" Content="{l:T Component.Dialogue.SkipPunctuation}" FontSize="{DynamicResource FontSizeBody}"/>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{l:T Component.Dialogue.Channel.Label}" Classes="fieldLabel" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding VoiceBlipChannel, Mode=TwoWay}" FontSize="{DynamicResource FontSizeSmall}" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 3. Typography & Styling -->
                <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:T Component.Dialogue.Section.Typography}" Classes="caption"/>

                    <!-- Kaydırıcı + sayı ve renk seçici yarım genişliğe sığmıyor: alt alta. -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:T Component.Dialogue.FontSize.Label}" Classes="fieldLabel"/>
                        <ctrl:RangedNumberControl Value="{Binding FontSize}" Minimum="12" Maximum="64" Step="2" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:T Component.Dialogue.TextColor.Label}" Classes="fieldLabel"/>
                        <ctrl:ColorPickerControl Mode="Hex" SelectedValue="{Binding TextColor, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:T Component.Dialogue.Align.Label}" Classes="fieldLabel"/>
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                            <RadioButton Grid.Column="0" Content="{l:T Common.Left}" IsChecked="{Binding IsAlignLeft}" GroupName="AlignGroup" FontSize="{DynamicResource FontSizeSmall}"/>
                            <RadioButton Grid.Column="1" Content="{l:T Common.Center}" IsChecked="{Binding IsAlignCenter}" GroupName="AlignGroup" FontSize="{DynamicResource FontSizeSmall}"/>
                            <RadioButton Grid.Column="2" Content="{l:T Common.Right}" IsChecked="{Binding IsAlignRight}" GroupName="AlignGroup" FontSize="{DynamicResource FontSizeSmall}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- 4. Box Visuals & Appearance -->
                <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:T Component.Dialogue.Section.Box}" Classes="caption"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{l:T Component.Dialogue.BoxColor.Label}" Classes="fieldLabel"/>
                            <ctrl:ColorPickerControl Mode="Hex" SelectedValue="{Binding BoxColor, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{l:T Component.Dialogue.BorderColor.Label}" Classes="fieldLabel"/>
                            <TextBox Text="{Binding BorderColor}" BorderBrush="{Binding BorderColor}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{l:T Component.Dialogue.BoxOpacity.Label}" Classes="fieldLabel"/>
                            <TextBlock Grid.Column="1" Text="{Binding BoxOpacity, StringFormat='{}{0:P0}'}" Classes="fieldValue"/>
                        </Grid>
                        <Slider Value="{Binding BoxOpacity}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"/>
                    </StackPanel>
                </StackPanel>

                <!-- 5. Geometry Coordinates & Size -->
                <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:T Component.Dialogue.Section.Transform}" Classes="caption"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{l:T Component.Dialogue.BoxX.Label}" Classes="fieldLabel"/>
                            <NumericUpDown Value="{Binding X}" Minimum="-500" Maximum="2500" Increment="20"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{l:T Component.Dialogue.BoxY.Label}" Classes="fieldLabel"/>
                            <NumericUpDown Value="{Binding Y}" Minimum="-500" Maximum="2500" Increment="20"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{l:T Common.Width}" Classes="fieldLabel"/>
                            <NumericUpDown Value="{Binding Width}" Minimum="100" Maximum="1920" Increment="20"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{l:T Common.Height}" Classes="fieldLabel"/>
                            <NumericUpDown Value="{Binding Height}" Minimum="60" Maximum="1080" Increment="20"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:T Component.Dialogue.Scale.Label}" Classes="fieldLabel"/>
                        <NumericUpDown Value="{Binding Scale}" Minimum="0.1" Maximum="5.0" Increment="0.1" FormatString="0.00"/>
                    </StackPanel>

                    <!-- Layout Presets (5 Presets) -->
                    <TextBlock Text="{l:T Component.Dialogue.Presets.Label}" Classes="fieldLabel"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <Button Grid.Column="0" Content="{l:T Component.Dialogue.Preset.Standard}" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding SetStandardCommand}"/>
                        <Button Grid.Column="1" Content="{l:T Component.Dialogue.Preset.Square}" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding SetSquareCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <Button Grid.Column="0" Content="{l:T Component.Dialogue.Preset.Nvl}" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding SetNvlFullscreenCommand}"/>
                        <Button Grid.Column="1" Content="{l:T Component.Dialogue.Preset.TopSubtitle}" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding SetTopSubtitleCommand}"/>
                    </Grid>
                    <Button Content="{l:T Component.Dialogue.Preset.Comic}" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding SetComicBubbleCommand}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
