<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:p="using:RowlEngine.Editor.Views.Panels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
             x:Class="RowlEngine.Editor.Views.Panels.OutputLogView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource PanelBackground}">
        <Grid RowDefinitions="Auto,*">
            <!-- Unity kromu: konsol araç satırı (Temizle + sayaçlar) -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Temizle"
                            Command="{Binding ClearLogCommand}"
                            ToolTip.Tip="Konsolu temizle"
                            Background="{DynamicResource ToolbarButtonBg}"
                            Foreground="{DynamicResource PrimaryText}"
                            FontSize="11" Padding="8,3" CornerRadius="2"/>
                    <!-- Unity kromu (H4): rozet kutuları düz metin sayaçlara
                         indi (aynı 3 bağ + tooltip + önek). -->
                    <TextBlock Text="{Binding LogErrorCount, StringFormat='Hata: {0}'}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="11" FontWeight="SemiBold"
                               ToolTip.Tip="Hata sayısı"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LogWarningCount, StringFormat='Uyarı: {0}'}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="11" FontWeight="SemiBold"
                               ToolTip.Tip="Uyarı sayısı"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LogInfoCount, StringFormat='Bilgi: {0}'}"
                               Foreground="{DynamicResource InfoBrush}"
                               FontSize="11"
                               ToolTip.Tip="Bilgi sayısı"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Unity kromu (H4): satırlı gövde — arama/daraltma yok.
                 Şerit nth-child ile (AlternationCount Avalonia'da yok).
                 Otomatik kaydırma kabul edilen farktır (manuel scroll). -->
            <ListBox Grid.Row="1" Background="Transparent" Padding="8,4"
                     ItemsSource="{Binding LogOutput, Converter={x:Static p:LogLinesConverter.Instance}}"
                     SelectionMode="Single">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                    </Style>
                    <Style Selector="ListBoxItem:nth-child(2n)">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas, Monospace" FontSize="12"
                                   Foreground="{DynamicResource PrimaryText}"
                                   TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
