<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:RowlEngine.Editor.ViewModels.Components"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:ctrl="using:RowlEngine.Editor.Controls"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             xmlns:p="using:RowlEngine.Editor.Views.Panels"
             x:Class="RowlEngine.Editor.Views.Components.ChoiceComponentView"
             x:DataType="comp:ChoiceComponentViewModel">
  <Border Classes="card" Margin="0,4" Padding="0" ClipToBounds="True">
    <StackPanel>
      <!-- Bileşen kartı başlığı (8 kartta aynı kalıp): onay kutusu | ad (yıldız sütun, kırpılır) | Ayar | "..." menüsü.
           Yukarı/Aşağı/Sil menüde; böylece dar Denetçide başlık taşmaz. Komutlar aynı. -->
      <Border Background="{DynamicResource CardHeaderBackground}" Padding="8,6">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2">
          <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" ToolTip.Tip="{l:T Common.Enable.Tip}" MinWidth="0" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"/>
          <ToggleButton Grid.Column="1" Classes="header" IsChecked="{Binding IsExpanded}" ToolTip.Tip="{l:T Common.ExpandCollapse.Tip}"
                        Background="Transparent" BorderThickness="0" Padding="4,2" MinWidth="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center">
            <TextBlock Classes="cardTitle" Text="{l:T Component.Choice.Name}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{l:T Component.Choice.Name}"/>
          </ToggleButton>
          <ToggleButton Grid.Column="2" Classes="compact" IsChecked="{Binding IsExpanded}" Content="{l:T Common.Settings}" VerticalAlignment="Center"/>
          <Button Grid.Column="3" Classes="compact" Content="..." ToolTip.Tip="{l:T Inspector.Components.Actions.Tip}" VerticalAlignment="Center">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{l:T Common.MoveUp.Tip}" Command="{Binding MoveUpCommand}"/>
                <MenuItem Header="{l:T Common.MoveDown.Tip}" Command="{Binding MoveDownCommand}"/>
                <Separator/>
                <MenuItem Header="{l:T Common.Delete}" Command="{Binding RemoveSelfCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>
      <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="8,6">
      <TextBox Watermark="{l:T Component.Choice.Title.Watermark}" Text="{Binding Title}"/>
      <ItemsControl ItemsSource="{Binding Options}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="comp:ChoiceOptionViewModel">
            <Border Padding="8" Margin="0,2" BorderBrush="{Binding BorderColor}" Background="{Binding BackgroundColor}" BorderThickness="1" CornerRadius="{Binding CornerRadius, Converter={x:Static p:DoubleToBoxConverter.Instance}}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Watermark="{l:T Component.Choice.Option.Text.Watermark}" Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding TextColor}"/>
                  <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" ToolTip.Tip="{l:T Component.Choice.Option.Enable.Tip}"/>
                  <ToggleButton Grid.Column="2" Classes="compact" Content="{l:T Common.Settings}" IsChecked="{Binding IsExpanded}" ToolTip.Tip="{l:T Component.Choice.Option.Appearance.Tip}"/>
                </Grid>
                <StackPanel IsVisible="{Binding IsExpanded}" Spacing="6">
                  <Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Watermark="{l:T Component.Choice.Option.Condition.Watermark}" Text="{Binding Condition}" FontSize="{DynamicResource FontSizeBody}"/>
                    <TextBlock Grid.Column="1" Classes="fieldLabel" Text="{l:T Component.Choice.Option.Target.Note}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="ghost" Content="{l:T Common.Remove}" Command="{Binding $parent[UserControl].DataContext.RemoveOptionCommand}" CommandParameter="{Binding}"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                    <TextBlock Classes="fieldLabel" Text="{l:T Component.Choice.Option.Preset}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding StylePreset}">
                      <x:String>Neon</x:String><x:String>Minimal</x:String><x:String>Paper</x:String><x:String>Danger</x:String>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Classes="fieldLabel" Text="{l:T Component.Choice.Option.FontSize}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" Text="{Binding FontSize}" HorizontalAlignment="Stretch"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8">
                    <TextBlock Classes="fieldLabel" Text="{l:T Common.X}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding X}" HorizontalAlignment="Stretch"/>
                    <TextBlock Grid.Column="2" Classes="fieldLabel" Text="{l:T Common.Y}" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Y}" HorizontalAlignment="Stretch"/>
                    <TextBlock Grid.Column="4" Classes="fieldLabel" Text="{l:T Common.Opacity}" VerticalAlignment="Center"/><TextBox Grid.Column="5" Text="{Binding Opacity}" HorizontalAlignment="Stretch"/>
                  </Grid>
                  <Border Tag="Font" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAssetDragOver" DragDrop.Drop="OnAssetDrop"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="3">
                    <TextBox Watermark="{l:T Component.Choice.Option.Font.Watermark}" Text="{Binding FontFamily}" BorderThickness="0"/>
                  </Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <TextBox Watermark="{l:T Component.Choice.Option.TextColor.Watermark}" Text="{Binding TextColor}"/>
                    <TextBox Grid.Column="1" Watermark="{l:T Component.Choice.Option.BackgroundColor.Watermark}" Text="{Binding BackgroundColor}"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <TextBox Watermark="{l:T Component.Choice.Option.HoverColor.Watermark}" Text="{Binding HoverColor}"/>
                    <TextBox Grid.Column="1" Watermark="{l:T Component.Choice.Option.BorderColor.Watermark}" Text="{Binding BorderColor}"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8">
                    <TextBlock Classes="fieldLabel" Text="{l:T Component.Choice.Option.W}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Width}" HorizontalAlignment="Stretch"/>
                    <TextBlock Grid.Column="2" Classes="fieldLabel" Text="{l:T Component.Choice.Option.H}" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Height}" HorizontalAlignment="Stretch"/>
                    <TextBlock Grid.Column="4" Classes="fieldLabel" Text="{l:T Component.Choice.Option.Radius}" VerticalAlignment="Center"/><TextBox Grid.Column="5" Text="{Binding CornerRadius}" HorizontalAlignment="Stretch"/>
                  </Grid>
                  <TextBlock Classes="hint" Text="{l:T Component.Choice.Option.Images.Hint}" TextWrapping="Wrap"/>
                  <Border Tag="Normal" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAssetDragOver" DragDrop.Drop="OnAssetDrop"
                          BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="3">
                    <TextBox Watermark="{l:T Component.Choice.Option.NormalImage.Watermark}" Text="{Binding NormalImage}" BorderThickness="0"/>
                  </Border>
                  <Border Tag="Hover" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAssetDragOver" DragDrop.Drop="OnAssetDrop"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="3">
                    <TextBox Watermark="{l:T Component.Choice.Option.HoverImage.Watermark}" Text="{Binding HoverImage}" BorderThickness="0"/>
                  </Border>
                  <Border Tag="Pressed" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAssetDragOver" DragDrop.Drop="OnAssetDrop"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="3">
                    <TextBox Watermark="{l:T Component.Choice.Option.PressedImage.Watermark}" Text="{Binding PressedImage}" BorderThickness="0"/>
                  </Border>
                  <Border Tag="Disabled" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAssetDragOver" DragDrop.Drop="OnAssetDrop"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="3">
                    <TextBox Watermark="{l:T Component.Choice.Option.DisabledImage.Watermark}" Text="{Binding DisabledImage}" BorderThickness="0"/>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ctrl:FieldValidationBadge Validation="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectorViewModel.Validation}"
                                         NodeId="{Binding Node.Id}" FieldKey="choice.option_target" />
      <Button Classes="ghost" Content="{l:T Component.Choice.Add}" Command="{Binding AddOptionCommand}" HorizontalAlignment="Left"/>
      <!-- Boş-durum: seçeneksiz Choice (butonsuz ipucu) -->
      <TextBlock Classes="hint" Text="{l:T Component.Choice.Empty}"
                 IsVisible="{Binding HasNoOptions}"
                 TextWrapping="Wrap" FontStyle="Italic"/>
      <TextBlock Classes="hint" Text="{l:T Component.Choice.Note}" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
