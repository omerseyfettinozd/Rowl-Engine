<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RowlEngine.Editor.ViewModels"
        xmlns:views="using:RowlEngine.Editor.Views"
        xmlns:panels="using:RowlEngine.Editor.Views.Panels"
        xmlns:search="using:RowlEngine.Editor.Services.Search"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:l="using:RowlEngine.Editor.Services.Strings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="RowlEngine.Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        FlowDirection="{l:Direction}"
        Title="Rowl Engine Editor"
        Width="1600" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <!-- KARAR-0 eşleme (Dilim-1, markup-only, davranış değişikliği yok):
         AppBackground, PrimaryText ve Accent dinamik tema token'larıdır;
         sayısal değerler ThemeStyles.axaml tanımlarından gelir. Soğuk palet
         bu dosyada gömülü değildir — çözümleme editor/Styles/ThemeStyles.axaml
         üzerinden yapılır. -->

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- FAZ 3 (EDITOR_UI_PORT_PLAN K4): tek satır üst çubuk + ortada prototipin
             kapsülü: görünümler | taşıma | Araçlar · Diğer (…). Proje/kayıt/düzen/ayar
             komutları "…" menüsünde; düğüm komutları kanvastaki Node araç çubuğunda.
             Kısayollar (Ctrl+S/Z/Y/N, Delete, Ctrl+,) MainWindow.axaml.cs'te. -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid ColumnDefinitions="*,Auto,*">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="ROWL" FontWeight="Black" Foreground="{DynamicResource Accent}" FontSize="13" VerticalAlignment="Center" LetterSpacing="0.5"/>
                    <TextBlock Text="STORY STUDIO" FontWeight="Light" Foreground="{DynamicResource MutedText}" FontSize="13" VerticalAlignment="Center" Margin="-2,0,0,0"/>
                </StackPanel>

                <!-- Kapsül (prototip .view-switcher) -->
                <Border x:Name="TopCapsule" Grid.Column="1"
                        Background="{DynamicResource ToolbarButtonBg}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="14" Padding="3">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

                        <StackPanel x:Name="CenterViewTabs" Orientation="Horizontal" Spacing="2">
                            <Button Classes="capsule" Command="{Binding ShowPanelCommand}" CommandParameter="NodeGraph"
                                    ToolTip.Tip="{l:T View.Node.Tip}">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{l:T View.Node}" HorizontalAlignment="Center"/>
                                    <Border Height="2" CornerRadius="1" Background="{Binding SceneTabBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="capsule" Command="{Binding ShowPanelCommand}" CommandParameter="EnginePreview"
                                    ToolTip.Tip="{l:T View.Game.Tip}">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{l:T View.Game}" HorizontalAlignment="Center"/>
                                    <Border Height="2" CornerRadius="1" Background="{Binding GameTabBrush}"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T Menu.OpenInSeparateWindow}" Command="{Binding OpenPlayerWindowCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Classes="capsule" Command="{Binding ShowPanelCommand}" CommandParameter="Preview"
                                    ToolTip.Tip="{l:T View.SceneEdit.Tip}">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{l:T View.SceneEdit}" HorizontalAlignment="Center"/>
                                    <Border Height="2" CornerRadius="1" Background="{Binding PreviewTabBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Classes="capsuleDivider"/>

                        <!-- Taşıma kümesi (Oynat/Duraklat/Adım). Glifler bizim çizimimiz. -->
                        <StackPanel x:Name="TransportCluster" Orientation="Horizontal" Spacing="2">
                            <Button Classes="capsuleIcon" Command="{Binding TogglePlayStandaloneCommand}"
                                    ToolTip.Tip="{l:T Transport.Play}"
                                    Background="{Binding PlayButtonColor}">
                                <Path Data="M3,2 L11,7 L3,12 Z" Fill="{DynamicResource PrimaryText}"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button Classes="capsuleIcon" Command="{Binding PauseStandaloneCommand}"
                                    IsEnabled="{Binding CanPauseStandalone}"
                                    ToolTip.Tip="{l:T Transport.Pause}">
                                <Path Data="M3,2 H5.5 V12 H3 Z M8.5,2 H11 V12 H8.5 Z" Fill="{DynamicResource PrimaryText}"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button Classes="capsuleIcon" Command="{Binding StepStandaloneCommand}"
                                    IsEnabled="{Binding CanStepStandalone}"
                                    ToolTip.Tip="{l:T Transport.Step}">
                                <Path Data="M2,2 L8,7 L2,12 Z M9.5,2 H11.5 V12 H9.5 Z" Fill="{DynamicResource PrimaryText}"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <Border Classes="capsuleDivider"/>

                        <Menu Background="Transparent" VerticalAlignment="Center">
                            <MenuItem x:Name="WindowsMenu" Header="{l:T Menu.Windows}" Classes="capsuleMenu">
                                <MenuItem Header="{l:T Panel.Hierarchy}" InputGesture="Ctrl+1" Command="{Binding ShowPanelCommand}" CommandParameter="Hierarchy"/>
                                <MenuItem Header="{l:T Panel.Inspector}" InputGesture="Ctrl+2" Command="{Binding ShowPanelCommand}" CommandParameter="Inspector"/>
                                <MenuItem Header="{l:T Panel.Log}" InputGesture="Ctrl+3" Command="{Binding ShowPanelCommand}" CommandParameter="Log"/>
                                <MenuItem Header="{l:T Panel.Assets}" InputGesture="Ctrl+4" Command="{Binding ShowPanelCommand}" CommandParameter="Assets"/>
                                <MenuItem Header="{l:T Panel.Backlog}" InputGesture="Ctrl+5" Command="{Binding ShowPanelCommand}" CommandParameter="Backlog"/>
                                <MenuItem Header="{l:T Panel.SaveSlots}" InputGesture="Ctrl+6" Command="{Binding ShowPanelCommand}" CommandParameter="SaveSlots"/>
                                <MenuItem Header="{l:T Panel.Issues}" InputGesture="Ctrl+7" Command="{Binding ShowPanelCommand}" CommandParameter="ProjectIssues"/>
                            </MenuItem>
                            <MenuItem x:Name="MoreMenu" Header="…" Classes="capsuleMenu" ToolTip.Tip="{l:T Menu.More}">
                                <MenuItem x:Name="ProjectsMenu" Header="{l:T Menu.Projects}">
                                    <MenuItem Header="{l:T Menu.ProjectList}" Command="{Binding OpenProjectHubCommand}"/>
                                    <MenuItem Header="{l:T Menu.LocalizationDesk}" Command="{Binding OpenLocalizationDeskCommand}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{l:T Menu.Save}" InputGesture="Ctrl+S" Command="{Binding SaveProjectCommand}"/>
                                <MenuItem Header="{l:T Menu.Undo}" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" IsEnabled="{Binding UndoRedo.CanUndo}"/>
                                <MenuItem Header="{l:T Menu.Redo}" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}" IsEnabled="{Binding UndoRedo.CanRedo}"/>
                                <Separator/>
                                <MenuItem Header="{l:T Menu.Export}" ToolTip.Tip="{Binding BuildButtonTooltip}"
                                          Command="{Binding BuildGameCommand}" IsEnabled="{Binding !IsBuilding}"/>
                                <MenuItem Header="{l:T Menu.CancelBuild}" Command="{Binding CancelBuildCommand}" IsVisible="{Binding IsBuilding}"/>
                                <Separator/>
                                <MenuItem x:Name="LayoutMenu" Header="{l:T Menu.Layout}">
                                    <MenuItem Header="{l:T Layout.Default}" Command="{Binding SelectLayoutPresetCommand}" CommandParameter="Varsayılan"/>
                                    <MenuItem Header="{l:T Layout.SceneFocus}" Command="{Binding SelectLayoutPresetCommand}" CommandParameter="Sahne Odağı"/>
                                    <MenuItem Header="{l:T Layout.PlayTest}" Command="{Binding SelectLayoutPresetCommand}" CommandParameter="Oyun Testi"/>
                                </MenuItem>
                                <MenuItem Header="{Binding SplitScreenButtonText}" Command="{Binding ShowPanelCommand}" CommandParameter="SplitScreen"/>
                                <Separator/>
                                <MenuItem Header="{l:T Menu.Settings}" InputGesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
                            </MenuItem>
                        </Menu>

                        <!-- Kaydedilmemiş değişiklik noktası (prototip: kapsülde nokta) -->
                        <Ellipse x:Name="UnsavedDot" Width="6" Height="6" Margin="2,0,6,0"
                                 Fill="{DynamicResource Accent}" VerticalAlignment="Center"
                                 IsVisible="{Binding IsProjectDirty}"
                                 ToolTip.Tip="{l:T Status.Unsaved}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding HierarchyPanelWidth}"/>
                <ColumnDefinition Width="{Binding HierarchySplitterWidth}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding InspectorSplitterWidth}"/>
                <ColumnDefinition Width="{Binding InspectorPanelWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Story structure; central canvas, preview, and inspector retain their behaviour. -->
            <Grid Grid.Column="0" IsVisible="{Binding IsHierarchyPanelVisible}" Background="{DynamicResource PanelBackground}">
                <panels:NodeHierarchyView/>
            </Grid>
            <GridSplitter Grid.Column="1" IsVisible="{Binding IsHierarchyPanelVisible}"
                          Background="{DynamicResource BorderColor}" ResizeDirection="Columns" Width="6"/>

            <!-- CENTER workspace -->
            <Grid Grid.Column="2" MinWidth="520" Background="{DynamicResource CanvasBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="{Binding BottomSplitterHeight}"/>
                    <RowDefinition Height="{Binding BottomPanelHeight}"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ClipToBounds="True">

                    <!-- BREADCRUMB + CHAPTER SCOPE (Faz 4 Dilim 3) -->
                    <Border x:Name="BreadcrumbPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="12,12,0,0" ZIndex="90"
                            Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4"
                            BoxShadow="0 4 16 0 #40000000">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Subgraphs.Crumbs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="/" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Tag="CrumbNav" Content="{Binding Title}" Padding="6,2" FontSize="11"
                                                    ToolTip.Tip="Bu düzeye dön"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Width="1" Height="14" Background="{DynamicResource BorderColor}"/>
                            <TextBlock Text="Bölüm:" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Subgraphs.AvailableChapterOptions}"
                                      SelectedItem="{Binding Subgraphs.ChapterFilterOption}"
                                      FontSize="11" MinWidth="110" ToolTip.Tip="Tuvali tek bölüme daralt"/>
                        </StackPanel>
                    </Border>

                    <!-- FAZ 3 (K4): Node paneli araç çubuğu — düğüm komutları üst çubuktan
                         buraya taşındı; yalnız düğüm grafiği açıkken görünür. -->
                    <Border x:Name="NodeToolbarPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="12,58,0,0" ZIndex="90" IsVisible="{Binding IsNodeGraphActive}"
                            Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="8" Padding="4"
                            BoxShadow="0 4 16 0 #40000000">
                        <StackPanel x:Name="NodeToolbar" Orientation="Horizontal" Spacing="4">
                            <Button Classes="ghost" Content="{l:T Node.Add}" ToolTip.Tip="{l:T Node.Add.Tip}" Command="{Binding AddNodeCommand}"/>
                            <Button Classes="ghost" Content="{l:T Node.Disconnect}" ToolTip.Tip="{l:T Node.Disconnect.Tip}" Command="{Binding DisconnectSelectedNodeCablesCommand}"/>
                            <Button Classes="ghost" Content="{l:T Node.Delete}" ToolTip.Tip="{l:T Node.Delete.Tip}" Command="{Binding DeleteSelectedNodeCommand}"/>
                            <Border Classes="capsuleDivider"/>
                            <Button Classes="ghost" Content="{l:T Node.Group}" ToolTip.Tip="{l:T Node.Group.Tip}" Command="{Binding CreateGroupFromSelectionCommand}"/>
                            <Button Classes="ghost" Content="{l:T Node.Up}" ToolTip.Tip="{l:T Node.Up.Tip}" Command="{Binding ExitSubgraphCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- SINGLE MODE -->
                    <Grid IsVisible="{Binding IsSplitScreenOff}">
                        <panels:NodeGraphView IsVisible="{Binding IsNodeGraphActive}"/>
                        <views:LivePreviewControl IsVisible="{Binding IsPreviewActive}"/>
                        <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                    </Grid>

                    <!-- SPLIT SCREEN MODE (HORIZONTAL) -->
                    <Grid IsVisible="{Binding IsSplitScreenHorizontal}" RowDefinitions="*, 6, *" ClipToBounds="True">
                        <panels:NodeGraphView Grid.Row="0"/>
                        <GridSplitter Grid.Row="1" Background="{DynamicResource BorderColor}" ResizeDirection="Rows" Height="6"/>
                        <Grid Grid.Row="2">
                            <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                            <views:LivePreviewControl IsVisible="{Binding !IsEnginePreviewActive}"/>
                        </Grid>
                    </Grid>
                    
                    <!-- SPLIT SCREEN MODE (VERTICAL) -->
                    <Grid IsVisible="{Binding IsSplitScreenVertical}" ColumnDefinitions="*, 6, *" ClipToBounds="True">
                        <panels:NodeGraphView Grid.Column="0"/>
                        <GridSplitter Grid.Column="1" Background="{DynamicResource BorderColor}" ResizeDirection="Columns" Width="6"/>
                        <Grid Grid.Column="2">
                            <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                            <views:LivePreviewControl IsVisible="{Binding !IsEnginePreviewActive}"/>
                        </Grid>
                    </Grid>

                    <!-- GLOBAL SEARCH OVERLAY (Faz 4 Dilim 2) -->
                    <Border x:Name="SearchOverlayPanel" IsVisible="{Binding IsSearchVisible}"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,12,0,0" ZIndex="100"
                            Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                            CornerRadius="8" Padding="10" Width="520"
                            BoxShadow="0 8 24 0 #40000000">
                        <StackPanel Spacing="8">
                            <TextBox Text="{Binding SearchQuery}"
                                     Watermark="Ara: başlık, konuşmacı, metin, speaker:Evelyn, type:choice… (Esc kapat)"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderThickness="0" Padding="12,8" FontSize="14"/>
                            <!-- Filtre çubuğu: tür / konuşmacı / renk etiketi -->
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Tür:" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Search.AvailableNodeKinds}" SelectedItem="{Binding Search.SelectedNodeKind}" FontSize="11" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="Konuşmacı:" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Grid.Column="3" ItemsSource="{Binding Search.AvailableSpeakers}" SelectedItem="{Binding Search.SelectedSpeaker}" FontSize="11" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="Renk:" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Grid.Column="5" ItemsSource="{Binding Search.AvailableColorTags}" SelectedItem="{Binding Search.SelectedColorTag}" FontSize="11"/>
                            </Grid>
                            <!-- Sonuç listesi: başlık + alan rozeti + metin kesiti -->
                            <ListBox ItemsSource="{Binding Search.Results}"
                                     SelectedItem="{Binding Search.SelectedResult}"
                                     MaxHeight="300"
                                     Background="{DynamicResource InputBackground}"
                                     BorderThickness="0" CornerRadius="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="search:NodeSearchHit">
                                        <StackPanel Spacing="2" Margin="0,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding NodeTitle}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="12"/>
                                                <TextBlock Text="{Binding NodeId, StringFormat='#{0}'}" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                                                <Border Background="{DynamicResource AccentButtonBg}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FieldLabel}" FontSize="9" Foreground="{DynamicResource AccentButtonFg}" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding Search.StatusText}"
                                       Foreground="{DynamicResource MutedText}" FontSize="11"
                                       HorizontalAlignment="Right" IsVisible="{Binding Search.StatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" IsVisible="{Binding IsBottomPanelVisible}"
                              Background="{DynamicResource BorderColor}" ResizeDirection="Rows" Height="6"/>

                <!-- Alt şerit: Varlıklar + Günlük + diğerleri tek
                     sekmeli yapıda (Unity alt panel düzeni) -->
                <Grid Grid.Row="2" MinHeight="140" IsVisible="{Binding IsBottomPanelVisible}">
                    <TabControl SelectedIndex="{Binding BottomPanelActiveTab}"
                                Background="{DynamicResource PanelBackground}">
                        <TabControl.Styles>
                            <Style Selector="TabItem">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Style>
                        </TabControl.Styles>
                        <TabItem Header="{l:T Panel.Assets}" IsVisible="{Binding IsAssetsPanelVisible}">
                            <panels:ProjectAssetsView/>
                        </TabItem>
                        <TabItem Header="{l:T Panel.Log}" IsVisible="{Binding IsLogPanelVisible}">
                            <panels:OutputLogView/>
                        </TabItem>
                        <TabItem Header="{l:T Panel.Backlog}" IsVisible="{Binding IsBacklogPanelVisible}">
                            <panels:BacklogView DataContext="{Binding BacklogViewModel}"/>
                        </TabItem>
                        <TabItem Header="{l:T Panel.SaveSlots}" IsVisible="{Binding IsSaveSlotsPanelVisible}">
                            <panels:SaveSlotsView DataContext="{Binding SaveSlotsViewModel}"/>
                        </TabItem>
                        <TabItem Header="{l:T Panel.Issues}" IsVisible="{Binding IsProjectIssuesPanelVisible}">
                            <panels:ProjectIssuesView DataContext="{Binding ProjectIssuesViewModel}"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" IsVisible="{Binding IsInspectorPanelVisible}"
                          Background="{DynamicResource BorderColor}" ResizeDirection="Columns" Width="6"/>

            <!-- RIGHT: Node Inspector -->
            <Grid Grid.Column="4" IsVisible="{Binding IsInspectorPanelVisible}" Background="{DynamicResource PanelBackground}">
                <panels:NodeInspectorView/>
            </Grid>
        </Grid>

        <!-- STATUS BAR (Alt Durum Çubuğu) -->
        <Border x:Name="StatusBarPanel" Grid.Row="2" Background="{DynamicResource StatusBarBg}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" 
                Padding="12,4" Height="28">
            <DockPanel>
                <!-- Sağ: Build Hedefi + Zoom -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="StatusZoomText" Text="{Binding ZoomScale, StringFormat='{}{0:P0}'}"
                               Foreground="{DynamicResource DimText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border Width="1" Height="14" Background="{DynamicResource BorderColor}"/>
                    <TextBlock x:Name="StatusBuildTargetText" Text="{Binding CurrentBuildTarget, StringFormat='{}{0}'}"
                               Foreground="{DynamicResource DimText}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Sol: Status Text -->
                <TextBlock x:Name="StatusMessageText" Text="{Binding StatusText}"
                           Foreground="{DynamicResource MutedText}" FontSize="11" 
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- TOAST NOTIFICATION OVERLAY (Sağ Alt) -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,40" ZIndex="200" Spacing="8">
            <Border x:Name="ToastPanel" IsVisible="{Binding Toast.IsVisible}"
                    Background="{Binding Toast.ToastBackground}" 
                    CornerRadius="8" Padding="16,10"
                    MinWidth="260" MaxWidth="420"
                    BoxShadow="0 4 16 0 #50000000">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Toast.ToastIcon}" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Toast.Message}"
                               Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Window>
