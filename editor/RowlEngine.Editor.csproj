<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Path to the built native library (relative to editor/ directory) -->
    <RowlNativeLib>$(MSBuildThisFileDirectory)..\build\lib\libRowlEngineCore.so</RowlNativeLib>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Auto-copy native library to output directory after build -->
  <Target Name="CopyNativeLib" AfterTargets="Build" Condition="Exists('$(RowlNativeLib)')">
    <Copy SourceFiles="$(RowlNativeLib)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
    <Message Text="✅ libRowlEngineCore.so copied to $(OutputPath)" Importance="high" />
  </Target>

  <!-- Warn if library is missing (not yet built) -->
  <Target Name="WarnNativeLibMissing" AfterTargets="Build" Condition="!Exists('$(RowlNativeLib)')">
    <Warning Text="libRowlEngineCore.so not found at $(RowlNativeLib). Run: cmake --build ../build" />
  </Target>

</Project>
