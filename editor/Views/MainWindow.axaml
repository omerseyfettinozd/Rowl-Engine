<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RowlEngine.Editor.ViewModels"
        xmlns:views="using:RowlEngine.Editor.Views"
        xmlns:panels="using:RowlEngine.Editor.Views.Panels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="RowlEngine.Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Rowl Engine Editor"
        Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ══════════════════════════════════════════════════════════════════
             PROFESSIONAL TOOLBAR — 2 Satırlı Düzen
             Satır 1: Logo + Gezinme Sekmeleri + Pencereler Menüsü
             Satır 2: Kaydet + Undo/Redo + Arama + Node İşlemleri + Build + Play + ⚙️ Ayarlar
             ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" 
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel>

                <!-- ── Satır 1: Logo + Gezinme + Pencereler ────────────── -->
                <Border Padding="12,6,12,4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Menu Background="Transparent">
                                <MenuItem Header="Pencereler" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="SemiBold">
                                    <MenuItem Header="📁 Project Assets" Command="{Binding ShowPanelCommand}" CommandParameter="Assets"/>
                                    <MenuItem Header="🔍 Node Inspector" Command="{Binding ShowPanelCommand}" CommandParameter="Inspector"/>
                                    <MenuItem Header="📝 Output Log" Command="{Binding ShowPanelCommand}" CommandParameter="Log"/>
                                    <Separator/>
                                    <MenuItem Header="🕸️ Node Graph" Command="{Binding ShowPanelCommand}" CommandParameter="NodeGraph"/>
                                    <MenuItem Header="🎬 Edit Frame" Command="{Binding ShowPanelCommand}" CommandParameter="Preview"/>
                                    <MenuItem Header="🎮 Game" Command="{Binding ShowPanelCommand}" CommandParameter="EnginePreview"/>
                                </MenuItem>
                            </Menu>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="ROWL" FontWeight="Black" Foreground="{DynamicResource Accent}" FontSize="14" VerticalAlignment="Center" LetterSpacing="0.5"/>
                            <TextBlock Text="ENGINE" FontWeight="Light" Foreground="{DynamicResource MutedText}" FontSize="14" VerticalAlignment="Center" Margin="-2,0,0,0"/>

                            <Border Width="1" Height="18" Background="{DynamicResource BorderColor}" Margin="8,0"/>

                            <Button Content="🏠 Hub" Command="{Binding OpenProjectHubCommand}" 
                                    ToolTip.Tip="Proje Listesi (Ctrl+H)"
                                    Background="Transparent" Foreground="{DynamicResource Accent}" 
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                                    CornerRadius="6" Padding="8,4" FontSize="11" FontWeight="SemiBold"/>

                            <Border Width="1" Height="18" Background="{DynamicResource BorderColor}" Margin="6,0"/>

                            <!-- Gezinme Sekmeleri -->
                            <Button Content="🕸️ Graph" Command="{Binding ShowPanelCommand}" CommandParameter="NodeGraph" 
                                    Background="Transparent" Foreground="{DynamicResource PrimaryText}" 
                                    CornerRadius="6" Padding="10,5" FontSize="11"/>
                            <Button Content="🎬 Preview" Command="{Binding ShowPanelCommand}" CommandParameter="Preview" 
                                    Background="Transparent" Foreground="{DynamicResource PrimaryText}" 
                                    CornerRadius="6" Padding="10,5" FontSize="11"/>
                            <Button Content="🎮 Game" Command="{Binding ShowPanelCommand}" CommandParameter="EnginePreview" 
                                    Background="Transparent" Foreground="{DynamicResource PrimaryText}" 
                                    CornerRadius="6" Padding="10,5" FontSize="11"/>
                            <Button Content="{Binding SplitScreenButtonText}" 
                                    Command="{Binding ShowPanelCommand}" CommandParameter="SplitScreen"
                                    Background="{Binding SplitScreenButtonColor}" 
                                    Foreground="{Binding SplitScreenButtonForeground}"
                                    FontWeight="Bold" FontSize="11" CornerRadius="6" Padding="10,5"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ── İnce Ayırıcı ───────────────────────────────────── -->
                <Border Height="1" Background="{DynamicResource BorderColor}"/>

                <!-- ── Satır 2: Eylem Butonları ────────────────────────── -->
                <Border Padding="12,5,12,6">
                    <DockPanel>

                        <!-- Sağ: Build + Play + Ayarlar -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Platform Seçici -->
                            <Button Content="{Binding BuildTargetDisplayText}" 
                                    ToolTip.Tip="Build Hedef Platformu Seçin"
                                    Background="{DynamicResource ToolbarButtonBg}" 
                                    Foreground="{DynamicResource PrimaryText}" 
                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1" 
                                    CornerRadius="6" Padding="10,5" FontWeight="SemiBold" FontSize="11">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="🤖 Android" Command="{Binding SetBuildTargetCommand}" CommandParameter="Android"/>
                                        <MenuItem Header="🪟 Windows" Command="{Binding SetBuildTargetCommand}" CommandParameter="Windows"/>
                                        <MenuItem Header="🐧 Linux" Command="{Binding SetBuildTargetCommand}" CommandParameter="Linux"/>
                                        <MenuItem Header="🍎 macOS" Command="{Binding SetBuildTargetCommand}" CommandParameter="macOS"/>
                                        <MenuItem Header="📱 iOS" Command="{Binding SetBuildTargetCommand}" CommandParameter="iOS"/>
                                        <Separator/>
                                        <MenuItem Header="📦 Sadece .rowlpkg" Command="{Binding SetBuildTargetCommand}" CommandParameter="PackageOnly"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <!-- Build Al -->
                            <Button Content="{Binding BuildButtonText}" 
                                    ToolTip.Tip="{Binding BuildButtonTooltip}" 
                                    Command="{Binding BuildGameCommand}" 
                                    Background="{DynamicResource AccentButtonBg}" 
                                    Foreground="White" CornerRadius="6" Padding="12,5" 
                                    FontWeight="Bold" FontSize="11"/>

                            <Border Width="1" Height="22" Background="{DynamicResource BorderColor}" Margin="2,0"/>

                            <!-- Play -->
                            <Button Content="{Binding PlayButtonText}" 
                                    Command="{Binding TogglePlayStandaloneCommand}" 
                                    Background="{Binding PlayButtonColor}" 
                                    Foreground="White" FontWeight="Bold" 
                                    CornerRadius="6" Padding="12,5" FontSize="11"/>

                            <Border Width="1" Height="22" Background="{DynamicResource BorderColor}" Margin="2,0"/>

                            <!-- ⚙️ Ayarlar -->
                            <Button Content="⚙️" 
                                    ToolTip.Tip="Ayarlar (Ctrl+,)" 
                                    Command="{Binding OpenSettingsCommand}"
                                    Background="Transparent" 
                                    Foreground="{DynamicResource MutedText}" 
                                    CornerRadius="6" Padding="8,5" FontSize="16"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
                        </StackPanel>

                        <!-- Sol: Kaydet + Undo/Redo + Arama + Node İşlemleri -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="💾 Kaydet" 
                                    ToolTip.Tip="Projeyi Kaydet (Ctrl+S)"
                                    Command="{Binding SaveProjectCommand}" 
                                    Background="{DynamicResource ToolbarButtonBg}" 
                                    Foreground="{DynamicResource PrimaryText}" 
                                    CornerRadius="6" Padding="10,5" FontWeight="SemiBold" FontSize="11"/>

                            <Border Width="1" Height="22" Background="{DynamicResource BorderColor}" Margin="2,0"/>

                            <Button Content="↩ Geri" 
                                    ToolTip.Tip="Geri Al (Ctrl+Z)"
                                    Command="{Binding UndoCommand}" 
                                    IsEnabled="{Binding UndoRedo.CanUndo}"
                                    Background="{DynamicResource ToolbarButtonBg}" 
                                    Foreground="{DynamicResource PrimaryText}" 
                                    CornerRadius="6" Padding="8,5" FontSize="11"/>

                            <Button Content="↪ İleri" 
                                    ToolTip.Tip="Yinele (Ctrl+Y)"
                                    Command="{Binding RedoCommand}" 
                                    IsEnabled="{Binding UndoRedo.CanRedo}"
                                    Background="{DynamicResource ToolbarButtonBg}" 
                                    Foreground="{DynamicResource PrimaryText}" 
                                    CornerRadius="6" Padding="8,5" FontSize="11"/>

                            <Border Width="1" Height="22" Background="{DynamicResource BorderColor}" Margin="2,0"/>

                            <Button Content="🔍 Ara" 
                                    ToolTip.Tip="Node / Asset Ara (Ctrl+F)"
                                    Command="{Binding ToggleSearchCommand}" 
                                    Background="{DynamicResource ToolbarButtonBg}" 
                                    Foreground="{DynamicResource PrimaryText}" 
                                    CornerRadius="6" Padding="8,5" FontSize="11"/>

                            <Border Width="1" Height="22" Background="{DynamicResource BorderColor}" Margin="2,0"/>

                            <Button Content="+ Node" 
                                    ToolTip.Tip="Yeni Node Ekle (Ctrl+N)"
                                    Command="{Binding AddNodeCommand}" 
                                    Background="{DynamicResource InfoBrush}" 
                                    Foreground="White" CornerRadius="6" Padding="10,5" FontSize="11"/>
                            <Button Content="✂ Ayır" 
                                    ToolTip.Tip="Seçili Node Bağlantılarını Kes"
                                    Command="{Binding DisconnectSelectedNodeCablesCommand}" 
                                    Background="{DynamicResource WarningBrush}" 
                                    Foreground="White" CornerRadius="6" Padding="10,5" FontSize="11"/>
                            <Button Content="🗑 Sil" 
                                    ToolTip.Tip="Seçili Node'u Sil (Delete)"
                                    Command="{Binding DeleteSelectedNodeCommand}" 
                                    Background="{DynamicResource DangerButtonBg}" 
                                    Foreground="White" CornerRadius="6" Padding="10,5" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             MAIN WORKSPACE
             ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="280, 6, *, 6, 320">

            <!-- LEFT: Project Assets -->
            <Grid Grid.Column="0" IsVisible="{Binding IsAssetsPanelVisible}">
                <panels:ProjectAssetsView/>
            </Grid>
            <GridSplitter Grid.Column="1" Background="{DynamicResource BorderColor}" ResizeDirection="Columns" Width="6"/>

            <!-- CENTER workspace -->
            <Grid Grid.Column="2" RowDefinitions="*, 6, 220">

                <Grid Grid.Row="0" ClipToBounds="True">

                    <!-- SINGLE MODE -->
                    <Grid IsVisible="{Binding IsSplitScreenOff}">
                        <panels:NodeGraphView IsVisible="{Binding IsNodeGraphActive}"/>
                        <views:LivePreviewControl IsVisible="{Binding IsPreviewActive}"/>
                        <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                    </Grid>

                    <!-- SPLIT SCREEN MODE (HORIZONTAL) -->
                    <Grid IsVisible="{Binding IsSplitScreenHorizontal}" RowDefinitions="*, 6, *" ClipToBounds="True">
                        <panels:NodeGraphView Grid.Row="0"/>
                        <GridSplitter Grid.Row="1" Background="{DynamicResource BorderColor}" ResizeDirection="Rows" Height="6"/>
                        <Grid Grid.Row="2">
                            <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                            <views:LivePreviewControl IsVisible="{Binding !IsEnginePreviewActive}"/>
                        </Grid>
                    </Grid>
                    
                    <!-- SPLIT SCREEN MODE (VERTICAL) -->
                    <Grid IsVisible="{Binding IsSplitScreenVertical}" ColumnDefinitions="*, 6, *" ClipToBounds="True">
                        <panels:NodeGraphView Grid.Column="0"/>
                        <GridSplitter Grid.Column="1" Background="{DynamicResource BorderColor}" ResizeDirection="Columns" Width="6"/>
                        <Grid Grid.Column="2">
                            <views:EnginePreviewControl IsVisible="{Binding IsEnginePreviewActive}"/>
                            <views:LivePreviewControl IsVisible="{Binding !IsEnginePreviewActive}"/>
                        </Grid>
                    </Grid>

                    <!-- 🔍 QUICK SEARCH OVERLAY -->
                    <Border IsVisible="{Binding IsSearchVisible}" 
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,12,0,0" ZIndex="100"
                            Background="{DynamicResource SurfaceBackground}" 
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                            CornerRadius="8" Padding="4" MinWidth="400"
                            BoxShadow="0 8 24 0 #60000000">
                        <TextBox Text="{Binding SearchQuery}" 
                                 Watermark="🔍 Node veya asset ara... (Esc ile kapat)"
                                 Background="{DynamicResource InputBackground}" 
                                 Foreground="{DynamicResource PrimaryText}"
                                 BorderThickness="0" Padding="12,8" FontSize="14"/>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" Background="{DynamicResource BorderColor}" ResizeDirection="Rows" Height="6"/>

                <!-- Bottom: Output Log -->
                <Grid Grid.Row="2" IsVisible="{Binding IsLogPanelVisible}">
                    <panels:OutputLogView/>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" Background="{DynamicResource BorderColor}" ResizeDirection="Columns" Width="6"/>

            <!-- RIGHT: Node Inspector -->
            <Grid Grid.Column="4" IsVisible="{Binding IsInspectorPanelVisible}">
                <panels:NodeInspectorView/>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             STATUS BAR (Alt Durum Çubuğu)
             ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" 
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" 
                Padding="12,4" Height="28">
            <DockPanel>
                <!-- Sağ: Build Hedefi + Zoom -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding ZoomScale, StringFormat='🔍 {0:P0}'}" 
                               Foreground="{DynamicResource DimText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border Width="1" Height="14" Background="{DynamicResource BorderColor}"/>
                    <TextBlock Text="{Binding CurrentBuildTarget, StringFormat='🎯 {0}'}" 
                               Foreground="{DynamicResource DimText}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Sol: Status Text -->
                <TextBlock Text="{Binding StatusText}" 
                           Foreground="{DynamicResource MutedText}" FontSize="11" 
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             TOAST NOTIFICATION OVERLAY (Sağ Alt)
             ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.RowSpan="2"
                IsVisible="{Binding Toast.IsVisible}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,40" ZIndex="200"
                Background="{Binding Toast.ToastBackground}" 
                CornerRadius="8" Padding="16,10"
                MinWidth="260" MaxWidth="420"
                BoxShadow="0 4 16 0 #80000000">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Toast.ToastIcon}" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Toast.Message}" 
                           Foreground="White" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>