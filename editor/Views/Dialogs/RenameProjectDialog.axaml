<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RowlEngine.Editor.Views.Dialogs.RenameProjectDialog"
        Title="Projeyi Yeniden Adlandır"
        Width="440" Height="220"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        CanResize="False">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="✏️ Projeyi Yeniden Adlandır" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="Yeni Proje Adı" FontSize="12" Foreground="{DynamicResource MutedText}"/>
            <TextBox Name="NameBox" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderSubtle}"/>
            <TextBlock Name="ErrorText" Foreground="{DynamicResource DangerButtonBg}" FontSize="11" IsVisible="False"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
            <Button Name="CancelButton" Content="İptal" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="14,6"/>
            <Button Name="SaveButton" Content="Kaydet" Background="{DynamicResource AccentButtonBg}" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="18,6"/>
        </StackPanel>
    </Grid>
</Window>
