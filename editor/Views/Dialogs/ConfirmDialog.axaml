<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RowlEngine.Editor.Views.Dialogs.ConfirmDialog"
        Title="Onay"
        Width="420" Height="190"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        CanResize="False">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <TextBlock Grid.Row="0" Name="TitleText" Text="İşlemi Onaylayın" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Name="MessageText" Text="Bu işlemi gerçekleştirmek istediğinize emin misiniz?" FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
            <Button Name="NoButton" Content="İptal" Background="Transparent" Foreground="{DynamicResource MutedText}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="14,6"/>
            <Button Name="YesButton" Content="Evet" Background="{DynamicResource AccentButtonBg}" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="18,6"/>
        </StackPanel>
    </Grid>
</Window>
