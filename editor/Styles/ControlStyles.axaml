<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Faz 2 (EDITOR_UI_PORT_PLAN): paylaşılan stil sınıfları. Paneller Faz 4'te
         sabit FontSize/CornerRadius yerine bu sınıflara geçer. Değerler
         ThemeStyles.axaml token'larından gelir. -->

    <!-- Metin rolleri -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
        <Setter Property="LetterSpacing" Value="1.2"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Düğmeler (K2: 32 px yükseklik; K3: tek renk) -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <!-- Birincil = diyalog onayı (prototip ayarlar .Uygula: kemik dolgu, koyu yazı). -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForeground}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForeground}"/>
    </Style>
    <!-- Faz 6 görsel uyum: panel içi eylem (prototip .script-save / Kaydet): koyu zemin + ince kenar;
         kemik dolgu yalnız diyalog onayında. -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MutedText}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Genişlet/daralt başlığı: "açık" durum bir SEÇİM değildir; Fluent'in
         vurgu dolgusu (kemik tonu) içerideki açık metinleri yok ediyordu. -->
    <Style Selector="ToggleButton.header:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Faz 3 (K4): üst kapsül (prototip .view-switcher / .view-button) -->
    <Style Selector="Button.capsule">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>
    <Style Selector="Button.capsuleIcon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="Button.capsule:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.capsuleIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NodeHeaderBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <!-- Pasif taşıma düğmesi (oynamıyorken Duraklat/Adım): prototipteki gibi
         şeffaf zemin + soluk simge; Fluent'in gri pasif dolgusu değil. -->
    <Style Selector="Button.capsuleIcon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.capsuleIcon:disabled">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>
    <Style Selector="Border.capsuleDivider">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="#3B3B3E"/>
    </Style>
    <Style Selector="MenuItem.capsuleMenu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>

    <!-- Faz 4: araç düğmesi (yüzen panellerde: zoom, sığdır, seçim) -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
    </Style>

    <!-- Yüzeyler -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
    </Style>
    <!-- Faz 4: kanvas üstünde yüzen paneller (kırıntı yolu, Node araç çubuğu,
         zoom şeridi, mini harita, görünümü sıfırla) -->
    <Style Selector="Border.floating">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="BoxShadow" Value="0 4 16 0 #40000000"/>
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource NodeCardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
    </Style>

    <!-- Faz 4 (insB): bileşen kartı başlığı/alan metinleri -->
    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="TextBlock.cardKind">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="TextBlock.fieldValue">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>

    <!-- Kart başlığındaki küçük metin düğmeleri (Yukarı/Aşağı/Ayar/Sil) -->
    <Style Selector="Button.compact, ToggleButton.compact">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="Button.compact:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.compact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
    </Style>
    <Style Selector="ToggleButton.compact:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Faz 4 (headers): ortak panel başlığı (prototip .panel-header / .panel-title).
         Hiyerarşi, Varlıklar, Denetçi vb. aynı kalıbı kullanır; sabitle/kapat
         düğmeleri Faz 5 pencere sistemiyle gelir. -->
    <Style Selector="Border.panelHeader">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
      <Setter Property="BorderBrush" Value="#252528"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="13,0,6,0"/>
    </Style>
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Faz 5 D3: çalışma alanı bölücüsü (WorkspaceHost, 6 px) — eski sabit
         GridSplitter'larla aynı kenar rengi. -->
    <Style Selector="GridSplitter.workspaceSplitter">
      <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
    </Style>
    <!-- Faz 5 D6: prototip .splitter:hover / :focus-visible belirginleşir; odak = D4 başlık odağıyla aynı Accent. -->
    <Style Selector="GridSplitter.workspaceSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
    </Style>
    <Style Selector="GridSplitter.workspaceSplitter:focus-visible">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
    </Style>
    <!-- Faz 5 D4: başlık = sürükleme tutamağı; klavye odağı K1 gibi kenarla belirginleşir. -->
    <Style Selector="Border.workspaceDragHandle:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- Başlıktaki sabitle / kapat (prototip .pin-button / .close-button; K3: tek renk). -->
    <Style Selector="Button.workspaceHeaderButton, ToggleButton.workspaceHeaderButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button.workspaceHeaderButton:pointerover, ToggleButton.workspaceHeaderButton:pointerover, ToggleButton.workspaceHeaderButton:checked">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="Button.workspaceHeaderButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.workspaceHeaderButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.workspaceHeaderButton:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.workspaceHeaderButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.workspaceHeaderButton:disabled">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>
    <!-- Sabit panel: prototip .panel.is-pinned gibi belirgin kenar (yerleşimi kaydırmayan katman). -->
    <Style Selector="Border.workspacePinnedOutline">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <!-- Bırakma vurgusu (prototip .drop-preview / .drag-label): kemik kenar + soluk dolgu + etiket. -->
    <Style Selector="Border.workspaceDropFill">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Opacity" Value="0.1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
    </Style>
    <Style Selector="Border.workspaceDropOutline">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
    </Style>
    <Style Selector="Border.workspaceDropLabel, Border.workspaceDragLabel">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="Padding" Value="11,8"/>
    </Style>
    <Style Selector="Border.workspaceDropLabel > TextBlock, Border.workspaceDragLabel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForeground}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>
    <Style Selector="TextBlock.panelSubtitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>

    <!-- Sekme başlığı: Fluent varsayılanı (~28 px) yerine prototipin küçük sekmesi.
         Ayarlar diyaloğu ve alt panel şeridi kullanır. -->
    <Style Selector="TabItem.compact">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="TabItem.compact:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>
    <Style Selector="Button.capsule:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.capsuleIcon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#252527"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="MenuItem.capsuleMenu:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="MenuItem.toolsMenu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_HeaderBorder" Background="{TemplateBinding Background}" CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                        <Border Width="260" Background="#1A1A1D" BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="13" Padding="9" BoxShadow="0 18 60 0 #99000000">
                            <ScrollViewer>
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="MenuItem.toolsMenu:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="MenuItem.toolsMenu:pointerover /template/ Border#PART_HeaderBorder">
        <Setter Property="Background" Value="{DynamicResource NodeHeaderBg}"/>
    </Style>
    <Style Selector="MenuItem.toolsMenu:open /template/ Border#PART_HeaderBorder">
        <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
    </Style>
    <Style Selector="MenuItem.moreMenu">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_HeaderBorder" Background="{TemplateBinding Background}" CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="4" BoxShadow="0 18 60 0 #99000000" MinWidth="220">
                            <ScrollViewer>
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="MenuItem.moreMenu:pointerover /template/ Border#PART_HeaderBorder">
        <Setter Property="Background" Value="{DynamicResource NodeHeaderBg}"/>
    </Style>
    <Style Selector="MenuItem.toolCard">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="MinHeight" Value="68"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_CardBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" MinHeight="68" Padding="9,6">
                    <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentPresenter Name="PART_IconPresenter" Content="{TemplateBinding Icon}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ContentPresenter Name="PART_LabelPresenter" Content="{TemplateBinding Header}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="MenuItem.toolCard:pointerover /template/ Border#PART_CardBorder">
        <Setter Property="Background" Value="#2B2B2F"/>
    </Style>
    <Style Selector="MenuItem.toolCard:pressed /template/ Border#PART_CardBorder">
        <Setter Property="Background" Value="#30302F"/>
        <Setter Property="BorderBrush" Value="#625E54"/>
    </Style>
    <!-- Kanvas kapsülündeki aç/kapa (mini harita): seçili hali dolgu değil, ince gri zemin. -->
    <Style Selector="ToggleButton.capsuleToggle">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ToggleButton.capsuleToggle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.capsuleToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!-- Kendi başlığını çizen panellerde (Hiyerarşi, Denetçi) WorkspacePanel ile aynı başlık ikonu. -->
    <Style Selector="Path.panelHeaderIcon">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{DynamicResource MutedText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <!-- Etkin görünüm (prototip .view-button[aria-pressed=true]): koyu karo + kemik simge. -->
    <Style Selector="Button.capsule.active">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="Button.capsule.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
    </Style>
    <!-- Faz 6 görsel uyum: prototip alanları düz input (stepper yok); ok tuşları ve tekerlek çalışmaya devam eder. -->
    <Style Selector="NumericUpDown">
        <Setter Property="ShowButtonSpinner" Value="False"/>
    </Style>
    <!-- Faz 6: sessiz başlık — Yerleşim/Sabitle yalnız işaretçi/klavye odağı paneldeyken (anında; azaltılmış hareketle uyumlu). -->
    <Style Selector=":is(StackPanel).panelHeaderActions &gt; Button#PART_LayoutButton, :is(StackPanel).panelHeaderActions &gt; ToggleButton#PART_PinButton">
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector=":is(StackPanel).panelHeaderActions:revealed &gt; Button#PART_LayoutButton, :is(StackPanel).panelHeaderActions:revealed &gt; ToggleButton#PART_PinButton, :is(StackPanel).panelHeaderActions:pinned &gt; ToggleButton#PART_PinButton">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.assetTool">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.assetTool:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="Button.assetTool:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToolbarButtonHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.assetTool:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToolbarButtonHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!-- Faz 6: kanvas kapsül dili (tüm yüzen tuval kontrolleri tek tip) -->
    <Style Selector="Border.canvasCapsule">
        <Setter Property="Background" Value="{DynamicResource CanvasControlBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="BoxShadow" Value="0 4 16 0 #33000000"/>
    </Style>
    <Style Selector="Button.canvasTool">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource CanvasControlText}"/>
    </Style>
    <Style Selector="Button.canvasTool:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="Button.canvasTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="Button.canvasTool:disabled">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>
    <Style Selector="Button.canvasTool:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.canvasTool">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource CanvasControlText}"/>
    </Style>
    <Style Selector="ToggleButton.canvasTool:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="ToggleButton.canvasTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="ToggleButton.canvasTool:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="ToggleButton.canvasTool:disabled">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>
    <Style Selector="ToggleButton.canvasTool:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Path.canvasIcon">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{DynamicResource CanvasControlText}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.canvasTool:pointerover Path.canvasIcon">
        <Setter Property="Stroke" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="ToggleButton.canvasTool:pointerover Path.canvasIcon">
        <Setter Property="Stroke" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="ToggleButton.canvasTool:checked Path.canvasIcon">
        <Setter Property="Stroke" Value="{DynamicResource PrimaryText}"/>
    </Style>
</Styles>
