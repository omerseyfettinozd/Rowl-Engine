<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:RowlEngine.Editor.Views"
             xmlns:vm="clr-namespace:RowlEngine.Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="RowlEngine.Editor.Views.EnginePreviewControl"
             x:DataType="vm:MainWindowViewModel"
             PointerPressed="OnPreviewPointerPressed">

    <Border Background="#0B0F19" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid>
            <!-- 16:9 Aspect Guardian Letterbox Container (Exact 1:1 match with LivePreviewControl) -->
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                <Border Width="1920" Height="1080" Background="#121624" CornerRadius="8" ClipToBounds="True" BoxShadow="0 10 30 0 #000000">
                    <Grid>
                        <!-- Offscreen Render Target Image (1920x1080 exact 1:1) -->
                        <Image Source="{Binding EngineHost.RenderTargetBitmap}"
                               Width="1920" Height="1080"
                               Stretch="Fill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
