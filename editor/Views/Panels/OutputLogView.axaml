<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RowlEngine.Editor.ViewModels"
             xmlns:p="using:RowlEngine.Editor.Views.Panels"
             xmlns:l="using:RowlEngine.Editor.Services.Strings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
             x:Class="RowlEngine.Editor.Views.Panels.OutputLogView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource PanelBackground}">
        <Grid RowDefinitions="Auto,*">
            <!-- Konsol araç satırı (Temizle + sayaçlar). Prototip .console-toolbar:
                 soluk 10 px metin, alt çizgi. Sayaç renkleri anlam taşır (K3):
                 hata/uyarı/bilgi tema brush token'larından gelir. -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Classes="compact"
                            Content="{l:T Log.Clear}"
                            Command="{Binding ClearLogCommand}"
                            ToolTip.Tip="{l:T Log.Clear.Tip}"/>
                    <TextBlock Classes="hint" Foreground="{DynamicResource ErrorBrush}"
                               FontWeight="SemiBold"
                               ToolTip.Tip="{l:T Log.Errors.Tip}"
                               VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <l:T Key="Log.Errors"/>
                                <Binding Path="LogErrorCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Classes="hint" Foreground="{DynamicResource WarningBrush}"
                               FontWeight="SemiBold"
                               ToolTip.Tip="{l:T Log.Warnings.Tip}"
                               VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <l:T Key="Log.Warnings"/>
                                <Binding Path="LogWarningCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Classes="hint" Foreground="{DynamicResource InfoBrush}"
                               ToolTip.Tip="{l:T Log.Infos.Tip}"
                               VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <l:T Key="Log.Infos"/>
                                <Binding Path="LogInfoCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>
            <!-- Unity kromu (H4): satırlı gövde — arama/daraltma yok.
                 Satırlar prototip .console-lines gibi alt çizgiyle ayrılır.
                 Otomatik kaydırma kabul edilen farktır (manuel scroll). -->
            <ListBox Grid.Row="1" Background="Transparent" Padding="8,4"
                     ItemsSource="{Binding LogOutput, Converter={x:Static p:LogLinesConverter.Instance}}"
                     SelectionMode="Single">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,1"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas, Monospace" FontSize="{DynamicResource FontSizeBodyLarge}"
                                   Foreground="{DynamicResource PrimaryText}"
                                   TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
