<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RowlEngine.Editor.ViewModels.Player"
             xmlns:services="using:RowlEngine.Editor.Services"
             x:Class="RowlEngine.Editor.Views.Player.PlayerBacklogView"
             x:DataType="vm:PlayerViewModel">
  <Grid RowDefinitions="Auto, *">
    <Button Grid.Row="0" Content="Geri" HorizontalAlignment="Left" Margin="0,0,0,8"
            Command="{Binding RequestIntentCommand}"
            CommandParameter="{x:Static services:PlayerIntent.CloseOverlay}" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding HistoryEntries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="{Binding speaker}" FontWeight="Bold" />
              <TextBlock Text="{Binding dialogue}" TextWrapping="Wrap" Opacity="0.85" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
